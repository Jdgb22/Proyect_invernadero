# Copia a .env y completa con tus valores locales. NO commitees el .env real.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/invernadero
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_PASSWORD
POSTGRES_DATABASE=invernadero

# Genera uno largo y aleatorio (ej. 32+ caracteres). Obligatorio en producción.
AUTH_SECRET=TU_SECRETO_LARGO_AQUI

# Duración de la sesión en horas (por defecto 24). Al cumplirse se cierra sesión.
SESSION_MAX_AGE_HOURS=24

# Necesario detrás de proxy HTTPS (Vercel/Cloudflare)
AUTH_TRUST_HOST=true
# Si necesitas forzarlo manualmente
# AUTH_URL=http://localhost:4321/api/auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP para correos de recuperación de contraseña (Gmail: usa una contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM="Macollo <tu-correo@dominio.com>"
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# API de Machine Learning (BioCLIP 2.5 en Google Cloud Run)
ML_API_URL=https://macollo-trips-api-961314735418.us-central1.run.app
ML_API_KEY=mk_tu_api_key_aqui

