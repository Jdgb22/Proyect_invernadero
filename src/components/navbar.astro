---
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
---

<nav class="bg-indigo-600 dark:bg-indigo-900 shadow">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <img
          src="/icons8-invernadero-64.svg"
          alt="Logo"
          width="32"
          height="32"
          class="filter invert brightness-0"
        />
        <span class="ml-2 text-xl font-bold text-white">AquaSens</span>
      </div>

      <div class="hidden sm:flex sm:items-center sm:space-x-8">
        <a
          href="/"
          class="text-white hover:text-indigo-200 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >Inicio</a
        >
        <a
          href="/metricas"
          class="text-white hover:text-indigo-200 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >Métricas</a
        >
        <a
          href="/historial"
          class="text-white hover:text-indigo-200 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >Historial</a
        >
        <a
          href="/configuracion"
          class="text-white hover:text-indigo-200 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >Configuración</a
        >
      </div>

      <div class="flex items-center space-x-4">
        <button
          id="nav-logout-btn"
          class="ml-4 px-4 py-2 border border-transparent text-sm font-medium rounded-md text-indigo-600 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm"
        >
          Cerrar Sesión
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  const { signOut } = await import("auth-astro/client");
  const logoutBtn = document.getElementById("nav-logout-btn");

  if (logoutBtn) {
    logoutBtn.addEventListener("click", () => {
      signOut();
    });
  }
</script>
