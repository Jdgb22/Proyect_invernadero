<div class="min-h-screen flex flex-col lg:flex-row w-full bg-gray-50 dark:bg-gray-900">
  
  <!-- Left Side: Farmer Image Panel -->
  <div id="farmer-panel" class="w-full h-72 lg:h-auto lg:min-h-screen lg:w-1/2 relative bg-gray-950 dark:bg-black overflow-hidden flex items-center justify-center flex-shrink-0">
    <!-- SVG estático de fondo -->
    <img
      id="farmer-static"
      src="/static-farmer.svg"
      alt="Agrónomo en la finca"
      class="absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-700"
      style="opacity:1"
    />
    <!-- Contenedor donde inyectaremos el SVG animado inline -->
    <div
      id="farmer-anim"
      class="absolute inset-0 w-full h-full transition-opacity duration-700"
      style="opacity:0"
      aria-hidden="true"
    ></div>
    <!-- Degradado inferior -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
    <!-- Texto superpuesto -->
    <div class="absolute bottom-6 lg:bottom-10 left-6 lg:left-10 text-white z-10 max-w-xs lg:max-w-sm">
      <h2 class="text-2xl lg:text-4xl font-bold drop-shadow-md mb-1 lg:mb-3">AquaSens</h2>
      <p class="text-sm lg:text-base text-gray-300 drop-shadow">Plataforma integral para el monitoreo y gestión inteligente de tu invernadero.</p>
    </div>
  </div>

  <!-- Right Side: Login Form -->
  <div class="flex flex-col justify-center w-full lg:w-1/2 p-8 sm:p-12 lg:p-24 bg-white dark:bg-gray-900">
    <div class="max-w-md w-full mx-auto">
      <div class="text-center lg:text-left mb-10">
        <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Acceder al Sistema</h1>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">Ingresa tus credenciales para continuar</p>
      </div>

      <form id="login-form" class="space-y-6" novalidate>
        <div>
          <label for="username" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Usuario</label>
          <input id="username" name="username" type="text" autocomplete="username" required
            class="block w-full px-4 py-3.5 bg-gray-50 border border-gray-200 dark:border-gray-600 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent dark:bg-gray-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="admin o user" />
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required
            class="block w-full px-4 py-3.5 bg-gray-50 border border-gray-200 dark:border-gray-600 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent dark:bg-gray-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="••••••••" />
        </div>

        <div class="flex items-center justify-between pt-2">
          <label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 cursor-pointer">
            <input id="remember-me" name="remember-me" type="checkbox"
              class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded dark:border-gray-600 dark:bg-gray-700" />
            Recordarme
          </label>
          <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400">¿Olvidaste tu contraseña?</a>
        </div>

        <div class="pt-2">
          <button id="login-btn" type="submit"
            class="w-full flex justify-center items-center gap-2 py-4 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-emerald-600 to-indigo-600 hover:from-emerald-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none">
            <span id="btn-text">Iniciar Sesión</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>

        <div id="error-message" class="hidden p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400">
          Credenciales incorrectas. Intenta nuevamente.
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Script is:inline para las funciones DOM disponibles globalmente -->
<script is:inline>
  // Pre-carga el SVG animado en background
  let _animatedSVGContent = null;
  fetch('/animated-farmer.svg')
    .then(r => r.text())
    .then(html => { _animatedSVGContent = html; })
    .catch(() => {});

  function showAnim() {
    const staticImg = document.getElementById('farmer-static');
    const animDiv   = document.getElementById('farmer-anim');
    if (!_animatedSVGContent || !staticImg || !animDiv) return;
    animDiv.innerHTML = _animatedSVGContent;
    const svg = animDiv.querySelector('svg');
    if (svg) {
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '100%');
      svg.style.cssText = 'width:100%;height:100%;position:absolute;inset:0';
    }
    staticImg.style.opacity = '0';
    animDiv.style.opacity   = '1';
  }

  function hideAnim() {
    const staticImg = document.getElementById('farmer-static');
    const animDiv   = document.getElementById('farmer-anim');
    if (!staticImg || !animDiv) return;
    staticImg.style.opacity = '1';
    animDiv.style.opacity   = '0';
    setTimeout(function() { animDiv.innerHTML = ''; }, 700);
  }
</script>

<!-- Script normal procesado por Astro para usar auth-astro/client -->
<script>
  import { signIn } from 'auth-astro/client';

  const loginForm  = document.getElementById('login-form');
  const loginBtn   = document.getElementById('login-btn') as HTMLButtonElement;
  const btnText    = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const errorMsg   = document.getElementById('error-message') as HTMLElement;

  function setLoading(on: boolean) {
    loginBtn.disabled = on;
    if (btnText) btnText.textContent = on ? 'Cargando…' : 'Iniciar Sesión';
    btnSpinner?.classList.toggle('hidden', !on);
  }

  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');
      setLoading(true);
      (window as any).showAnim?.();

      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const result = await signIn('credentials', {
          username,
          password,
          redirect: false,
        } as any);

        // Esperar mínimo 3s para ver la animación completa
        await new Promise(r => setTimeout(r, 3000));

        if ((result as any)?.error) {
          (window as any).hideAnim?.();
          setLoading(false);
          errorMsg.textContent = 'Credenciales incorrectas. Intenta nuevamente.';
          errorMsg.classList.remove('hidden');
        } else {
          window.location.href = '/';
        }
      } catch (err) {
        console.error('Login error:', err);
        await new Promise(r => setTimeout(r, 2000));
        (window as any).hideAnim?.();
        setLoading(false);
        errorMsg.textContent = 'Error inesperado. Intenta nuevamente.';
        errorMsg.classList.remove('hidden');
      }
    });
  }
</script>
