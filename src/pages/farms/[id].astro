---
import Layout from "../../frontend/layouts/Layout.astro";
import Navbar from "../../frontend/components/Navbar.astro";
import {
  getAuthUser,
  getFincaAccess,
  canManageFinca,
  canHardDeleteFinca,
} from "../../backend/services/authz";
import {
  getFincaById,
  listMembers,
  listInvitaciones,
  listPlantas,
} from "../../backend/services/farms";

const user = await getAuthUser(Astro.request);
if (!user) return Astro.redirect("/");

const fincaId = Number(Astro.params.id);
if (!Number.isInteger(fincaId) || fincaId <= 0) return Astro.redirect("/farms");

const access = await getFincaAccess(fincaId, user);
if (access === "none") return Astro.redirect("/farms");

const finca = await getFincaById(fincaId);
if (!finca) return Astro.redirect("/farms");

const gestionar = canManageFinca(access);
const puedeArchivar = gestionar;
const puedeBorrar = canHardDeleteFinca(user.role);

const miembros = gestionar ? await listMembers(fincaId) : [];
const invitaciones = gestionar ? await listInvitaciones(fincaId) : [];
const plantas = await listPlantas(fincaId);

const hoy = new Date().toISOString().slice(0, 10);
---

<Layout>
  <Navbar />
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a href="/farms" class="text-sm text-green-600 dark:text-green-400 hover:underline mb-4 inline-block">← Volver a Mis Fincas</a>

    <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-green-950 dark:text-white mb-1">{finca.nombre}</h1>
        <p class="text-green-700 dark:text-stone-300">
          Dueño: {finca.dueno_nombre} · {plantas.length} plantas · {finca.miembros_count ?? 0} miembro(s)
          {finca.ubicacion && ` · 📍 ${finca.ubicacion}`}
        </p>
        {!finca.activa && (
          <span class="mt-2 inline-block px-2.5 py-1 rounded-full text-xs font-bold bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-300">
            Finca archivada
          </span>
        )}
      </div>
      <div class="flex flex-wrap gap-2">
        {finca.activa && (
          <button data-activar class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors">
            Trabajar aquí
          </button>
        )}
        {puedeArchivar && (
          <button
            data-archivo={finca.activa ? "archivar" : "restaurar"}
            class="px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 dark:hover:bg-amber-900/60 text-sm font-semibold rounded-xl transition-colors"
          >
            {finca.activa ? "Archivar" : "Restaurar"}
          </button>
        )}
        {puedeBorrar && (
          <button
            data-borrar
            class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors"
          >
            Eliminar finca
          </button>
        )}
      </div>
    </div>

    <div id="finca-alert" class="hidden mb-6 px-4 py-3 rounded-xl text-sm font-medium"></div>

    <div class="space-y-6">
      <!-- Editar datos (dueño / staff) -->
      {
        gestionar && (
          <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 overflow-hidden">
            <div class="p-6 border-b border-stone-100 dark:border-stone-700">
              <h2 class="text-xl font-bold text-green-950 dark:text-white">Datos de la finca</h2>
              <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">Nombre, ubicación y descripción.</p>
            </div>
            <div class="p-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5">Nombre</label>
                <input id="edit-nombre" value={finca.nombre} class="w-full px-4 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none shadow-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5">Ubicación</label>
                <input id="edit-ubicacion" value={finca.ubicacion || ""} class="w-full px-4 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none shadow-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5">Descripción</label>
                <input id="edit-descripcion" value={finca.descripcion || ""} class="w-full px-4 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none shadow-sm" />
              </div>
            </div>
            <div class="px-6 py-4 bg-stone-50 dark:bg-stone-900/50 border-t border-stone-100 dark:border-stone-700 flex justify-end">
              <button id="edit-save" class="px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors">
                Guardar cambios
              </button>
            </div>
          </div>
        )
      }

      <!-- Invitaciones (dueño / staff) -->
      {
        gestionar && (
          <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 overflow-hidden">
            <div class="p-6 border-b border-stone-100 dark:border-stone-700">
              <h2 class="text-xl font-bold text-green-950 dark:text-white">Invitaciones</h2>
              <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">
                Genera códigos para que campesinos se unan a esta finca.
              </p>
            </div>
            <div class="p-6">
              <div class="flex flex-wrap items-end gap-3 mb-6">
                <div>
                  <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5">Expira en</label>
                  <select id="inv-dias" class="px-3 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white shadow-sm outline-none focus:ring-2 focus:ring-green-500">
                    <option value="1">1 día</option>
                    <option value="7" selected>7 días</option>
                    <option value="30">30 días</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5">Usos máximos</label>
                  <select id="inv-usos" class="px-3 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white shadow-sm outline-none focus:ring-2 focus:ring-green-500">
                    <option value="1" selected>1 (una persona)</option>
                    <option value="5">5 personas</option>
                    <option value="10">10 personas</option>
                    <option value="100">100 personas</option>
                  </select>
                </div>
                <button id="inv-crear" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors">
                  Generar código
                </button>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full min-w-[620px] text-sm">
                  <thead>
                    <tr class="text-left text-xs uppercase tracking-wider text-stone-500 dark:text-stone-400 border-b border-stone-200 dark:border-stone-700">
                      <th class="py-2 pr-4">Código</th>
                      <th class="py-2 pr-4">Usos</th>
                      <th class="py-2 pr-4">Expira</th>
                      <th class="py-2 pr-4">Estado</th>
                      <th class="py-2">Link</th>
                      <th class="py-2"></th>
                    </tr>
                  </thead>
                  <tbody id="inv-body">
                    {invitaciones.length === 0 && (
                      <tr>
                        <td colspan="6" class="py-4 text-center text-stone-400 dark:text-stone-500">
                          Todavía no has generado invitaciones.
                        </td>
                      </tr>
                    )}
                    {invitaciones.map((inv) => {
                      const exp = new Date(inv.expira_en);
                      const expirada = exp < new Date() || inv.usos_usados >= inv.usos_maximos;
                      const estado = !inv.activa
                        ? "Revocada"
                        : expirada
                          ? "Agotada"
                          : "Activa";
                      const link = `${Astro.url.origin}/invite/${inv.codigo}`;
                      return (
                        <tr data-inv={inv.id} class="border-b border-stone-100 dark:border-stone-700/50">
                          <td class="py-3 pr-4 font-mono font-bold text-green-700 dark:text-green-400">{inv.codigo}</td>
                          <td class="py-3 pr-4">{inv.usos_usados}/{inv.usos_maximos}</td>
                          <td class="py-3 pr-4">{exp.toLocaleDateString("es-CO")}</td>
                          <td class="py-3 pr-4">
                            <span class={`px-2 py-0.5 rounded-full text-[11px] font-bold ${
                              estado === "Activa"
                                ? "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300"
                                : "bg-stone-200 text-stone-600 dark:bg-stone-700 dark:text-stone-300"
                            }`}>{estado}</span>
                          </td>
                          <td class="py-3 pr-4">
                            <button data-copy={link} class="copy-link text-xs text-green-600 dark:text-green-400 hover:underline font-semibold">Copiar link</button>
                          </td>
                          <td class="py-3 text-right">
                            {inv.activa && (
                              <button data-revocar={inv.id} class="text-xs text-rose-600 dark:text-rose-400 hover:underline font-semibold">Revocar</button>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )
      }

      <!-- Miembros (dueño / staff) -->
      {
        gestionar && (
          <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 overflow-hidden">
            <div class="p-6 border-b border-stone-100 dark:border-stone-700">
              <h2 class="text-xl font-bold text-green-950 dark:text-white">Miembros</h2>
              <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">Quién tiene acceso a esta finca.</p>
            </div>
            <ul class="divide-y divide-stone-100 dark:divide-stone-700/60">
              {miembros.map((m) => (
                <li class="px-6 py-4 flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold text-stone-900 dark:text-white">{m.name}</p>
                    <p class="text-xs text-stone-500 dark:text-stone-400">{m.email || m.phone || `#${m.user_id}`}</p>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class={`px-2 py-0.5 rounded-full text-[11px] font-bold ${
                      m.rol_finca === "dueno"
                        ? "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300"
                        : "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300"
                    }`}>{m.rol_finca === "dueno" ? "Dueño" : "Miembro"}</span>
                    {m.rol_finca !== "dueno" && (
                      <button data-expulsar={m.user_id} class="text-xs text-rose-600 dark:text-rose-400 hover:underline font-semibold">Expulsar</button>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Datos sin permisos de gestión: vista simple de plantas -->
      {!gestionar && (
        <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 p-6">
          <h2 class="text-xl font-bold text-green-950 dark:text-white mb-2">Plantas de la finca</h2>
          <p class="text-sm text-stone-500 dark:text-stone-400 mb-4">
            {plantas.length} plantas registradas. Puedes ver y registrar mediciones desde el tablero.
          </p>
          <div class="flex flex-wrap gap-2">
            {plantas.map((p) => (
              <span class="px-3 py-1.5 rounded-lg bg-[#f4fce3] dark:bg-stone-900/50 text-green-800 dark:text-green-300 text-xs font-bold border border-green-100 dark:border-[#104d28]">
                {p.plant_id} · {p.fila.toUpperCase()}-{p.columna}
              </span>
            ))}
          </div>
          <a href="/metrics" class="mt-4 inline-block px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors">
            Ir al tablero
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ fincaId, hoy }}>
  const sileo = () => window.sileo;

  function alerta(msg, tipo) {
    const box = document.getElementById("finca-alert");
    box.textContent = msg;
    box.className = `mb-6 px-4 py-3 rounded-xl text-sm font-medium ${
      tipo === "success"
        ? "bg-green-50 text-green-800 border border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800"
        : tipo === "error"
          ? "bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-900/30 dark:text-rose-300 dark:border-rose-800"
          : "bg-stone-50 text-stone-700 border border-stone-200 dark:bg-stone-800 dark:text-stone-300"
    }`;
    sileo()?.[tipo]?.({ title: msg });
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  async function api(path, options = {}) {
    const res = await fetch(path, {
      headers: { "Content-Type": "application/json" },
      ...options,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Error del servidor.");
    return data;
  }

  document.querySelector("[data-activar]")?.addEventListener("click", async () => {
    try {
      await api("/api/farms/active", { method: "POST", body: JSON.stringify({ fincaId }) });
      alerta("Finca activada. Redirigiendo al tablero…", "success");
      setTimeout(() => (window.location.href = "/metrics"), 500);
    } catch (err) {
      alerta(err.message, "error");
    }
  });

  document.getElementById("edit-save")?.addEventListener("click", async () => {
    try {
      await api(`/api/farms/${fincaId}`, {
        method: "PATCH",
        body: JSON.stringify({
          nombre: document.getElementById("edit-nombre").value.trim(),
          ubicacion: document.getElementById("edit-ubicacion").value.trim() || null,
          descripcion: document.getElementById("edit-descripcion").value.trim() || null,
        }),
      });
      alerta("Datos de la finca actualizados.", "success");
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      alerta(err.message, "error");
    }
  });

  document.querySelector("[data-archivo]")?.addEventListener("click", async (e) => {
    const modo = e.currentTarget.dataset.archivo;
    const activa = modo === "restaurar";
    try {
      const data = await api(`/api/farms/${fincaId}/archive`, {
        method: "POST",
        body: JSON.stringify({ activa }),
      });
      alerta(data.message, "success");
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      alerta(err.message, "error");
    }
  });

  document.querySelector("[data-borrar]")?.addEventListener("click", async () => {
    if (!confirm("¿Eliminar esta finca DEFINITIVAMENTE con todas sus plantas y mediciones? Esta acción no se puede deshacer.")) return;
    try {
      const data = await api(`/api/farms/${fincaId}`, { method: "DELETE" });
      alerta(data.message, "success");
      setTimeout(() => (window.location.href = "/farms"), 900);
    } catch (err) {
      alerta(err.message, "error");
    }
  });

  document.getElementById("inv-crear")?.addEventListener("click", async () => {
    try {
      const expiraDias = Number(document.getElementById("inv-dias").value);
      const usosMaximos = Number(document.getElementById("inv-usos").value);
      const data = await api(`/api/farms/${fincaId}/invitations`, {
        method: "POST",
        body: JSON.stringify({ expiraDias, usosMaximos }),
      });
      alerta(`Código generado: ${data.invitacion.codigo}`, "success");
      setTimeout(() => location.reload(), 900);
    } catch (err) {
      alerta(err.message, "error");
    }
  });

  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        alerta("Link de invitación copiado.", "success");
      } catch {
        prompt("Copia el link:", btn.dataset.copy);
      }
    });
  });

  document.querySelectorAll("[data-revocar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("¿Revocar esta invitación? Dejará de funcionar de inmediato.")) return;
      try {
        await api(`/api/farms/${fincaId}/invitations/${btn.dataset.revocar}`, { method: "DELETE" });
        alerta("Invitación revocada.", "success");
        setTimeout(() => location.reload(), 700);
      } catch (err) {
        alerta(err.message, "error");
      }
    });
  });

  document.querySelectorAll("[data-expulsar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("¿Expulsar a este miembro de la finca?")) return;
      try {
        await api(`/api/farms/${fincaId}/members?userId=${btn.dataset.expulsar}`, { method: "DELETE" });
        alerta("Miembro expulsado.", "success");
        setTimeout(() => location.reload(), 700);
      } catch (err) {
        alerta(err.message, "error");
      }
    });
  });
</script>
