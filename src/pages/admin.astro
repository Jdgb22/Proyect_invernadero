---
import Layout from "../frontend/layouts/Layout.astro";
import Navbar from "../frontend/components/Navbar.astro";
import { getAuthUser, canManageSystem } from "../backend/services/authz";
import { listFincasForUser } from "../backend/services/farms";

const user = await getAuthUser(Astro.request);
if (!user) return Astro.redirect("/");

const esSuperadmin = canManageSystem(user.role);
const esStaff = user.role === "Superadmin" || user.role === "Admin";
if (!esStaff) return Astro.redirect("/");

const fincas = await listFincasForUser(user.id, user.role, { soloActivas: false });
---

<Layout>
  <Navbar />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-green-950 dark:text-white mb-1">Panel de Administración</h1>
      <p class="text-green-700 dark:text-stone-300">
        {
          esSuperadmin
            ? "Control total: usuarios, roles y fincas del sistema."
            : "Vista operativa de todas las fincas del sistema."
        }
      </p>
    </div>

    <div id="admin-alert" class="hidden mb-6 px-4 py-3 rounded-xl text-sm font-medium"></div>

    <div class="space-y-8">
      {
        esSuperadmin && (
          <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 overflow-hidden">
            <div class="p-6 border-b border-stone-100 dark:border-stone-700 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-xl font-bold text-green-950 dark:text-white">Usuarios</h2>
                <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">
                  Cambia roles o elimina cuentas. Solo un Superadmin gestiona usuarios.
                </p>
              </div>
              <input
                id="users-search"
                type="search"
                placeholder="Buscar por nombre, correo o celular…"
                class="px-4 py-2.5 rounded-xl border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white text-sm focus:ring-2 focus:ring-green-500 outline-none shadow-sm w-full sm:w-72"
              />
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-sm">
                <thead>
                  <tr class="text-left text-xs uppercase tracking-wider text-stone-500 dark:text-stone-400 border-b border-stone-200 dark:border-stone-700">
                    <th class="py-3 px-6">Usuario</th>
                    <th class="py-3 pr-4">Contacto</th>
                    <th class="py-3 pr-4">Rol</th>
                    <th class="py-3 pr-4">Fincas</th>
                    <th class="py-3 pr-6 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="users-body">
                  <tr>
                    <td colspan="5" class="py-8 text-center text-stone-400">Cargando usuarios…</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        )
      }

      <!-- Fincas del sistema -->
      <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 overflow-hidden">
        <div class="p-6 border-b border-stone-100 dark:border-stone-700">
          <h2 class="text-xl font-bold text-green-950 dark:text-white">Fincas del sistema</h2>
          <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">
            Pulsa «Entrar» para trabajar en una finca.{" "}
            {esSuperadmin
              ? "Puedes archivar, restaurar o eliminar fincas."
              : "Puedes archivar o restaurar fincas; el borrado definitivo es solo Superadmin."}
          </p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[700px] text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wider text-stone-500 dark:text-stone-400 border-b border-stone-200 dark:border-stone-700">
                <th class="py-3 px-6">Finca</th>
                <th class="py-3 pr-4">Dueño</th>
                <th class="py-3 pr-4">Miembros</th>
                <th class="py-3 pr-4">Estado</th>
                <th class="py-3 pr-6 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {
                fincas.map((f) => (
                  <tr class="border-b border-stone-100 dark:border-stone-700/50">
                    <td class="py-3 px-6">
                      <a href={`/farms/${f.id}`} class="font-semibold text-green-800 dark:text-green-300 hover:underline">
                        {f.nombre}
                      </a>
                    </td>
                    <td class="py-3 pr-4 text-stone-600 dark:text-stone-300">{f.dueno_nombre}</td>
                    <td class="py-3 pr-4">{f.miembros_count ?? 0}</td>
                    <td class="py-3 pr-4">
                      <span class={`px-2 py-0.5 rounded-full text-[11px] font-bold ${f.activa ? "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300" : "bg-stone-200 text-stone-600 dark:bg-stone-700 dark:text-stone-300"}`}>
                        {f.activa ? "Activa" : "Archivada"}
                      </span>
                    </td>
                    <td class="py-3 pr-6 text-right space-x-3 whitespace-nowrap">
                      {f.activa && (
                        <button
                          data-admin-entrar={f.id}
                          class="text-xs font-semibold text-green-700 dark:text-green-400 hover:underline"
                        >
                          Entrar
                        </button>
                      )}
                      <button
                        data-admin-archivo={f.id}
                        data-activa={f.activa ? "1" : "0"}
                        class="text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline"
                      >
                        {f.activa ? "Archivar" : "Restaurar"}
                      </button>
                      {esSuperadmin && (
                        <button
                          data-admin-borrar={f.id}
                          data-nombre={f.nombre}
                          class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline"
                        >
                          Eliminar
                        </button>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ esSuperadmin }}>
  const ROLES = ["Superadmin", "Admin", "Agropecuario", "Campesino"];
  const sileo = () => window.sileo;

  function alerta(msg, tipo) {
    const box = document.getElementById("admin-alert");
    box.textContent = msg;
    box.className = `mb-6 px-4 py-3 rounded-xl text-sm font-medium ${
      tipo === "success"
        ? "bg-green-50 text-green-800 border border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800"
        : "bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-900/30 dark:text-rose-300 dark:border-rose-800"
    }`;
    sileo()?.[tipo]?.({ title: msg });
  }

  async function api(path, options = {}) {
    const res = await fetch(path, { headers: { "Content-Type": "application/json" }, ...options });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Error del servidor.");
    return data;
  }

  async function cargarUsuarios(q = "") {
    if (!esSuperadmin) return;
    const body = document.getElementById("users-body");
    try {
      const data = await api(`/api/admin/users?q=${encodeURIComponent(q)}`);
      if (data.users.length === 0) {
        body.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-stone-400">Sin resultados.</td></tr>`;
        return;
      }
      body.innerHTML = data.users
        .map(
          (u) => `
        <tr class="border-b border-stone-100 dark:border-stone-700/50" data-user-row="${u.id}">
          <td class="py-3 px-6">
            <p class="font-semibold text-stone-900 dark:text-white">${u.name || "(sin nombre)"}</p>
            <p class="text-xs text-stone-500 dark:text-stone-400">#${u.id}</p>
          </td>
          <td class="py-3 pr-4 text-stone-600 dark:text-stone-300 text-xs">
            ${u.email || ""}${u.email && u.phone ? "<br>" : ""}${u.phone || ""}
          </td>
          <td class="py-3 pr-4">
            <select data-role-select="${u.id}" class="px-2 py-1 rounded-lg border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 text-stone-900 dark:text-white text-xs outline-none focus:ring-2 focus:ring-green-500">
              ${ROLES.map((r) => `<option value="${r}" ${u.role === r ? "selected" : ""}>${r}</option>`).join("")}
            </select>
          </td>
          <td class="py-3 pr-4">${u.fincas_count}</td>
          <td class="py-3 pr-6 text-right">
            <button data-del-user="${u.id}" data-name="${u.name || ""}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline">Eliminar</button>
          </td>
        </tr>`,
        )
        .join("");

      body.querySelectorAll("[data-role-select]").forEach((sel) => {
        sel.addEventListener("change", async () => {
          const id = sel.dataset.roleSelect;
          try {
            const data = await api(`/api/admin/users/${id}`, {
              method: "PATCH",
              body: JSON.stringify({ role: sel.value }),
            });
            alerta(data.message, "success");
          } catch (err) {
            alerta(err.message, "error");
            cargarUsuarios(document.getElementById("users-search").value.trim());
          }
        });
      });

      body.querySelectorAll("[data-del-user]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm(`¿Eliminar la cuenta de ${btn.dataset.name}? Se eliminarán sus membresías. Si es dueño de alguna finca, no se podrá eliminar hasta transferirla o borrarla.`)) return;
          try {
            const data = await api(`/api/admin/users/${btn.dataset.delUser}`, { method: "DELETE" });
            alerta(data.message, "success");
            cargarUsuarios(document.getElementById("users-search").value.trim());
          } catch (err) {
            alerta(err.message, "error");
          }
        });
      });
    } catch (err) {
      body.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-500">${err.message}</td></tr>`;
    }
  }

  if (esSuperadmin) {
    cargarUsuarios();
    let t;
    document.getElementById("users-search")?.addEventListener("input", (e) => {
      clearTimeout(t);
      t = setTimeout(() => cargarUsuarios(e.target.value.trim()), 300);
    });
  }

  document.querySelectorAll("[data-admin-entrar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await api("/api/farms/active", {
          method: "POST",
          body: JSON.stringify({ fincaId: Number(btn.dataset.adminEntrar) }),
        });
        window.location.href = "/";
      } catch (err) {
        alerta(err.message, "error");
      }
    });
  });

  document.querySelectorAll("[data-admin-archivo]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const activa = btn.dataset.activa !== "1";
      try {
        const data = await api(`/api/farms/${btn.dataset.adminArchivo}/archive`, {
          method: "POST",
          body: JSON.stringify({ activa }),
        });
        alerta(data.message, "success");
        setTimeout(() => location.reload(), 600);
      } catch (err) {
        alerta(err.message, "error");
      }
    });
  });

  document.querySelectorAll("[data-admin-borrar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm(`¿Eliminar DEFINITIVAMENTE la finca "${btn.dataset.nombre}" con todos sus datos?`)) return;
      try {
        const data = await api(`/api/farms/${btn.dataset.adminBorrar}`, { method: "DELETE" });
        alerta(data.message, "success");
        setTimeout(() => location.reload(), 700);
      } catch (err) {
        alerta(err.message, "error");
      }
    });
  });
</script>
