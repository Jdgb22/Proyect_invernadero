---
import "../frontend/styles/global.css";

// SSR por defecto (`output: "server"` en astro.config.mjs). Se sirve como
// /landing en cualquier dominio; el día que se defina un subdominio se puede
// enlazar aquí sin cambiar la página ni sus rutas internas.

// Contenido verificado contra el código y la documentación de Macollo.
// La matriz y los estados son una representación visual, no datos en vivo.
const matriz = [
  ["ok", "ok", "warn", "ok", "ok"],
  ["ok", "critical", "ok", "ok", "warn"],
  ["ok", "ok", "ok", "none", "ok"],
  ["warn", "ok", "ok", "ok", "ok"],
];

const problemas = [
  {
    n: "01",
    title: "Datos que no se encuentran",
    text: "La lectura vive en hojas sueltas, sin una vista común por finca ni por planta.",
    icon: "sheet",
  },
  {
    n: "02",
    title: "Decisiones a ciegas",
    text: "Sin umbrales visibles, el estado del cultivo depende de la interpretación de cada persona.",
    icon: "eye",
  },
  {
    n: "03",
    title: "Plagas detectadas tarde",
    text: "El trips se identifica cuando el daño ya es visible, sin una foto asociada a la lectura.",
    icon: "bug",
  },
];

const pasos = [
  {
    n: "01",
    title: "Trae tus lecturas",
    text: "Importa un Excel/CSV o conecta una Google Sheets pública. Cada valor queda ligado a finca, planta, fecha y hora.",
  },
  {
    n: "02",
    title: "Mira el semáforo",
    text: "La matriz 4×5 y las métricas convierten esos números en óptimo, atención, crítico o sin datos.",
  },
  {
    n: "03",
    title: "Actúa con evidencia",
    text: "Revisa el historial, exporta reportes y usa la cámara para una segunda opinión con IA.",
  },
];

const funciones = [
  {
    title: "Matriz 4×5",
    text: "20 plantas por finca con semáforo agronómico y detalle por planta.",
    icon: "grid",
  },
  {
    title: "Métricas claras",
    text: "Promedios por fila, badges de pH, sanidad y productividad con umbrales explícitos.",
    icon: "chart",
  },
  {
    title: "Historial real",
    text: "Consulta por fecha, importa datos y exporta `.xlsx` o `.csv` cuando lo necesites.",
    icon: "history",
  },
  {
    title: "Multi-finca",
    text: "Invita a tu equipo, cambia de finca y mantén cada dato en su propio espacio.",
    icon: "farms",
  },
  {
    title: "Galería compartida",
    text: "Fotos de la finca accesibles para todos los miembros, con vista ampliable.",
    icon: "image",
  },
  {
    title: "Diagnóstico con IA",
    text: "Captura una hoja y recibe una clasificación de trips asistida por visión por computadora.",
    icon: "spark",
  },
];

const audiencias = [
  {
    role: "Operario de campo",
    label: "Campesino",
    text: "Consulta el tablero, registra lecturas, sube fotos y revisa el historial de las fincas a las que pertenece.",
    tone: "green",
  },
  {
    role: "Dueño de finca",
    label: "Agropecuario",
    text: "Crea su finca, invita al equipo, sincroniza hojas y exporta información para tomar decisiones.",
    tone: "lime",
  },
  {
    role: "Administración",
    label: "Admin / Superadmin",
    text: "Supervisa todas las fincas, entra a cualquier tablero y gestiona usuarios y roles.",
    tone: "deep",
  },
];

const stack = [
  {
    layer: "Interfaz",
    items: ["Astro 7.2.8", "React 19", "Tailwind CSS 4.3.3", "Three.js 0.185.1"],
  },
  {
    layer: "Aplicación",
    items: ["Auth.js", "Zod 4", "Astro SSR", "Vercel Functions"],
  },
  {
    layer: "Datos",
    items: ["PostgreSQL 17", "Google Sheets", "ExcelJS", "CSV / XLSX"],
  },
  {
    layer: "IA y clima",
    items: ["FastAPI", "BioCLIP 2.5", "Cloud Run", "Open-Meteo · WAQI"],
  },
];

const equipo = [
  "Nixon Ramirez",
  "Luis Manuel Florez",
  "Mateo Herrera",
  "Juan David Giraldo",
  "Alejandro Florez",
  "Victor Cordoba",
];

const tickerItems = [
  "20 plantas por finca",
  "Lecturas con fecha y hora",
  "Semáforo agronómico",
  "Diagnóstico de trips con IA",
  "Machine learning para el campo",
  "IA que explica el porqué",
  "Visión por computador BioCLIP",
  "Confianza por imagen",
  "Alertas tempranas",
  "Tendencias por planta",
  "Umbrales por cultivo",
  "Clima y calidad del aire",
  "Historial trazable",
  "Multi-finca y equipos",
  "Sheets, CSV y Excel",
  "Decisiones con evidencia",
];

const iconos: Record<string, string> = {
  sheet:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M4 15h16M10 3v18M15 3v18"/></svg>',
  eye:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>',
  bug:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="8" width="10" height="12" rx="5"/><path d="M9 8V6a3 3 0 0 1 6 0v2M3 11h4M17 11h4M4 17h3M17 17h3M12 8v12"/></svg>',
  grid:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
  chart:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
  history:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>',
  farms:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-7 9 7"/><path d="M5 10v10h14V10M9 20v-6h6v6"/></svg>',
  image:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 16-5-5L5 20"/></svg>',
  spark:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="M18 16.5 19 19l2.5 1-2.5 1-1 2.5-1-2.5L14.5 20 17 19l1-2.5Z"/></svg>',
  arrow:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  check:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>',
  mail:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
  phone:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>',
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="Macollo es la plataforma de monitoreo agronómico que convierte las lecturas de tu invernadero en decisiones claras: matriz por planta, métricas, historial y diagnóstico de trips con IA."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Macollo — Tu invernadero, planta por planta" />
    <meta
      property="og:description"
      content="Monitoreo agronómico multi-finca con semáforos, trazabilidad por planta y diagnóstico asistido de trips."
    />
    <meta property="og:image" content="/gulupa.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.url).href} />
    <link rel="icon" type="image/png" href="/gulupa.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Macollo — Monitoreo agronómico inteligente</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header" id="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/landing" aria-label="Macollo, inicio de la landing">
          <img src="/gulupa.svg" alt="" width="38" height="38" />
          <span>macollo<span class="brand-dot">.</span></span>
        </a>

        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#solucion">La solución</a>
          <a href="#que-hacemos">Qué hacemos</a>
          <a href="#por-que">Por qué</a>
          <a href="#stack">Stack</a>
          <a href="#equipo">Quiénes somos</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <div class="header-actions">
          <a class="btn btn-ghost header-doc" href="#stack">
            Stack
          </a>
          <a class="btn btn-primary btn-sm" href="/">
            Entrar a la app
            <span class="btn-icon" set:html={iconos.arrow} />
          </a>
          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        <a href="#solucion">La solución</a>
        <a href="#que-hacemos">Qué hacemos</a>
        <a href="#por-que">Por qué</a>
        <a href="#stack">Stack</a>
        <a href="#equipo">Quiénes somos</a>
        <a href="#contacto">Contacto</a>
        <a href="/">Entrar a la app →</a>
      </div>
    </header>

    <main id="contenido">
      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-glow hero-glow-a" aria-hidden="true"></div>
        <div class="hero-glow hero-glow-b" aria-hidden="true"></div>
        <div class="hero-grid" aria-hidden="true"></div>

        <div class="shell hero-inner">
          <div class="hero-copy">
            <p class="eyebrow reveal" data-reveal>
              <span class="eyebrow-dot"></span>
              Monitoreo agronómico · Multi-finca
            </p>
            <h1 class="reveal" data-reveal id="hero-title">
              Tu invernadero,<br />
              <span class="gradient-text">planta por planta.</span>
            </h1>
            <p class="hero-lead reveal" data-reveal>
              Macollo convierte las lecturas de tu cultivo en una vista clara: semáforos por planta,
              métricas por finca, historial trazable y una segunda opinión con IA para detectar trips.
            </p>
            <div class="hero-actions reveal" data-reveal>
              <a class="btn btn-primary" href="#solucion">
                Conocer la solución
                <span class="btn-icon" set:html={iconos.arrow} />
              </a>
              <a class="btn btn-outline" href="#que-hacemos">Ver capacidades</a>
            </div>
            <ul class="hero-points reveal" data-reveal>
              <li><span set:html={iconos.check} /> Matriz 4×5 por finca</li>
              <li><span set:html={iconos.check} /> Datos con fecha y responsable</li>
              <li><span set:html={iconos.check} /> Diagnóstico asistido</li>
            </ul>
          </div>

          <div class="hero-visual reveal" data-reveal aria-label="Vista ilustrativa del tablero de Macollo">
            <div class="mock-window">
              <div class="mock-topbar">
                <div class="mock-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                <span>macollo · tablero</span>
                <span class="mock-live"><i></i> en vivo</span>
              </div>

              <div class="mock-body">
                <div class="mock-heading">
                  <div>
                    <small>Finca demo · Gulupa</small>
                    <strong>Matriz de cultivo</strong>
                  </div>
                  <span class="mock-pill">20 plantas</span>
                </div>

                <div class="mock-matrix" role="img" aria-label="Matriz de 4 filas y 5 columnas con estados de las plantas">
                  {
                    matriz.map((fila, filaIndex) => (
                      <div class="mock-row">
                        {fila.map((estado, colIndex) => (
                          <span
                            class:list={["mock-cell", `cell-${estado}`]}
                            title={`T${filaIndex} · Planta ${colIndex + 1} · ${estado}`}
                          >
                            <i></i>
                          </span>
                        ))}
                      </div>
                    ))
                  }
                </div>

                <div class="mock-divider"></div>

                <div class="mock-metrics">
                  <div><small>pH promedio</small><strong>6,4</strong><em>Óptimo</em></div>
                  <div><small>Humedad</small><strong>72%</strong><em>Estable</em></div>
                  <div><small>Sanidad</small><strong>95%</strong><em>Atención</em></div>
                </div>
              </div>
            </div>

            <div class="float-card float-card-a" aria-hidden="true">
              <span class="float-icon">🌿</span>
              <div><small>Última lectura</small><strong>Hoy · 09:00</strong></div>
            </div>
            <div class="float-card float-card-b" aria-hidden="true">
              <span class="float-icon">🔬</span>
              <div><small>Trips</small><strong>Sin hallazgos</strong></div>
            </div>
          </div>
        </div>

        <div class="hero-fade" aria-hidden="true"></div>
      </section>

      <!-- TIRA DE CONFIANZA -->
      <div class="ticker" aria-label="Capacidades destacadas">
        <div class="ticker-track">
          <div class="ticker-group">
            {tickerItems.map((item) => (<span>{item}<b>✦</b></span>))}
          </div>
          <div class="ticker-group" aria-hidden="true">
            {tickerItems.map((item) => (<span>{item}<b>✦</b></span>))}
          </div>
        </div>
      </div>

      <!-- PROBLEMA -->
      <section class="section section-problema" id="problema" aria-labelledby="problema-title">
        <div class="shell">
          <div class="section-head reveal" data-reveal>
            <p class="kicker">El punto de partida</p>
            <h2 id="problema-title">El campo genera datos. <span class="muted">La dificultad está en leerlos.</span></h2>
            <p class="section-lead">
              Entre la hoja de cálculo y la decisión hay demasiados pasos manuales. Macollo nace para acortar ese camino.
            </p>
          </div>

          <div class="card-grid three">
            {
              problemas.map((item) => (
                <article class="soft-card reveal" data-reveal>
                  <span class="card-index">{item.n}</span>
                  <span class="card-icon" set:html={iconos[item.icon]} />
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- SOLUCIÓN -->
      <section class="section section-solucion" id="solucion" aria-labelledby="solucion-title">
        <div class="shell solution-grid">
          <div class="solution-copy reveal" data-reveal>
            <p class="kicker">La solución</p>
            <h2 id="solucion-title">De la medición a la acción, <span class="gradient-text">en un solo lugar.</span></h2>
            <p class="section-lead">
              Una plataforma web que ordena tus lecturas, las interpreta con reglas agronómicas claras y te deja registrar evidencia visual cuando la necesites.
            </p>

            <ol class="steps">
              {
                pasos.map((paso) => (
                  <li>
                    <span class="step-number">{paso.n}</span>
                    <div>
                      <h3>{paso.title}</h3>
                      <p>{paso.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="solution-visual reveal" data-reveal>
            <div class="before-after">
              <div class="ba-card ba-before">
                <p class="ba-label">Antes</p>
                <div class="ba-lines" aria-hidden="true">
                  <span></span><span></span><span></span><span></span>
                </div>
                <p>Hojas dispersas, interpretación manual y poca trazabilidad.</p>
              </div>
              <div class="ba-arrow" aria-hidden="true">→</div>
              <div class="ba-card ba-after">
                <p class="ba-label">Con Macollo</p>
                <div class="ba-status">
                  <span class="s-ok">Óptimo</span>
                  <span class="s-warn">Atención</span>
                  <span class="s-crit">Crítico</span>
                  <span class="s-none">Sin datos</span>
                </div>
                <p>Una vista por finca, con reglas explícitas y evidencia adjunta.</p>
              </div>
            </div>
            <p class="visual-note">Ilustración conceptual basada en el tablero real de la aplicación.</p>
          </div>
        </div>
      </section>

      <!-- QUÉ HACEMOS -->
      <section class="section section-features" id="que-hacemos" aria-labelledby="features-title">
        <div class="shell">
          <div class="section-head reveal" data-reveal>
            <p class="kicker">Qué hacemos</p>
            <h2 id="features-title">Todo lo que necesitas para <span class="muted">mirar el cultivo con claridad.</span></h2>
            <p class="section-lead">Seis capacidades que trabajan juntas, sin dejar de lado la sencillez de uso en el campo.</p>
          </div>

          <div class="card-grid features-grid">
            {
              funciones.map((feature) => (
                <article class="feature-card reveal" data-reveal>
                  <span class="feature-icon" set:html={iconos[feature.icon]} />
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                  <span class="feature-line" aria-hidden="true"></span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- POR QUÉ -->
      <section class="section section-why" id="por-que" aria-labelledby="why-title">
        <div class="shell why-grid">
          <div class="why-intro reveal" data-reveal>
            <p class="kicker">Por qué Macollo</p>
            <h2 id="why-title">Menos hojas, <span class="gradient-text">más criterio.</span></h2>
            <p class="section-lead">
              No prometemos automatizar el campo. Prometemos que cada lectura tenga un lugar, una regla y una respuesta clara.
            </p>
            <ul class="why-list">
              <li><span set:html={iconos.check} /> Trazabilidad por finca, planta, fecha y hora.</li>
              <li><span set:html={iconos.check} /> Umbrales visibles en lugar de corazonadas.</li>
              <li><span set:html={iconos.check} /> Acceso por roles y membresías por finca.</li>
            </ul>
          </div>

          <div class="stats-grid reveal" data-reveal>
            <div class="stat">
              <strong data-count="20">20</strong>
              <span>plantas por finca</span>
            </div>
            <div class="stat">
              <strong data-count="4">4</strong>
              <span>roles de acceso</span>
            </div>
            <div class="stat">
              <strong data-count="3">3</strong>
              <span>fuentes de datos</span>
            </div>
            <div class="stat">
              <strong data-count="1">1</strong>
              <span>segunda opinión con IA</span>
            </div>
          </div>
        </div>
      </section>

      <!-- PARA QUIÉN -->
      <section class="section section-audience" aria-labelledby="audience-title">
        <div class="shell">
          <div class="section-head reveal" data-reveal>
            <p class="kicker">Para quién</p>
            <h2 id="audience-title">Un mismo tablero, <span class="muted">distintas responsabilidades.</span></h2>
          </div>
          <div class="card-grid three">
            {
              audiencias.map((item) => (
                <article class="audience-card reveal" data-reveal>
                  <span class:list={["audience-badge", `tone-${item.tone}`]}>{item.label}</span>
                  <h3>{item.role}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- STACK -->
      <section class="section section-stack" id="stack" aria-labelledby="stack-title">
        <div class="shell">
          <div class="section-head reveal" data-reveal>
            <p class="kicker">Stack</p>
            <h2 id="stack-title">Tecnología que se puede <span class="muted">leer y mantener.</span></h2>
            <p class="section-lead">Versiones reales del repositorio, organizadas por la capa que resuelven.</p>
          </div>

          <div class="stack-grid">
            {
              stack.map((group) => (
                <article class="stack-card reveal" data-reveal>
                  <div class="stack-head">
                    <span class="stack-dot"></span>
                    <h3>{group.layer}</h3>
                  </div>
                  <ul>
                    {group.items.map((item) => <li>{item}</li>)}
                  </ul>
                </article>
              ))
            }
          </div>
          <p class="stack-foot reveal" data-reveal>
            Cada decisión técnica está documentada en ADR-001…007 dentro de la documentación del proyecto.
          </p>
        </div>
      </section>

      <!-- EQUIPO -->
      <section class="section section-team" id="equipo" aria-labelledby="team-title">
        <div class="shell team-grid">
          <div class="team-art reveal" data-reveal aria-hidden="true">
            <div class="team-art-ring"></div>
            <img src="/static-farmer.svg" alt="" loading="lazy" />
            <span class="team-art-leaf">🌱</span>
          </div>
