---
import Layout from "../../frontend/layouts/Layout.astro";
import { getAuthUser } from "../../backend/services/authz";
import { peekInvitacion } from "../../backend/services/farms";

const code = (Astro.params.code || "").trim().toUpperCase();
const user = await getAuthUser(Astro.request);
const invitacion = code ? await peekInvitacion(code) : null;
---

<Layout>
  <main class="min-h-dvh flex items-center justify-center px-4 py-12 bg-[#f4fce3] dark:bg-[#062c16]">
    <div class="w-full max-w-md">
      <div class="text-center mb-6">
        <img src="/gulupa.svg" alt="Logo" class="w-14 h-14 mx-auto mb-3 drop-shadow-md" />
        <h1 class="text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-green-600 to-lime-500 dark:from-green-400 dark:to-lime-400">
          Invitación a una finca
        </h1>
      </div>

      <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 p-6 sm:p-8">
        {
          !code ? (
            <p class="text-center text-stone-600 dark:text-stone-300">Falta el código de invitación.</p>
          ) : !invitacion ? (
            <>
              <p class="text-center text-5xl mb-3">🚫</p>
              <p class="text-center font-bold text-stone-900 dark:text-white mb-2">Código no válido</p>
              <p class="text-center text-sm text-stone-500 dark:text-stone-400 mb-6">
                El código <span class="font-mono font-bold">{code}</span> no existe, expiró, fue revocado o ya no tiene usos disponibles.
              </p>
              <a href="/farms" class="block text-center px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors">
                Ir a Mis Fincas
              </a>
            </>
          ) : !user ? (
            <>
              <p class="text-center text-5xl mb-3">🌾</p>
              <p class="text-center font-bold text-stone-900 dark:text-white mb-1">
                Te invitan a "{invitacion.fincaNombre}"
              </p>
              <p class="text-center text-sm text-stone-500 dark:text-stone-400 mb-6">
                Inicia sesión o crea una cuenta para unirte. Conservaremos el código.
              </p>
              <a
                href={`/?desde=${encodeURIComponent(`/invite/${code}`)}`}
                class="block text-center px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors mb-3"
              >
                Iniciar sesión / Registrarme
              </a>
              <a href="/" class="block text-center text-xs text-stone-500 hover:underline">Cancelar</a>
            </>
          ) : (
            <>
              <p class="text-center text-5xl mb-3">🤝</p>
              <p class="text-center font-bold text-stone-900 dark:text-white mb-1">
                {user.name}, te unirás a "{invitacion.fincaNombre}"
              </p>
              <p class="text-center text-sm text-stone-500 dark:text-stone-400 mb-6">
                Entrarás como <span class="font-semibold">Campesino/Miembro</span>: podrás trabajar en la finca, pero no configurarla.
              </p>
              <button
                id="join-confirm"
                class="w-full px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors mb-3"
              >
                Confirmar unión
              </button>
              <p id="join-msg" class="hidden text-center text-sm mb-3"></p>
              <a href="/farms" class="block text-center text-xs text-stone-500 hover:underline">Cancelar</a>
            </>
          )
        }
      </div>
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ code }}>
  document.getElementById("join-confirm")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const msg = document.getElementById("join-msg");
    btn.disabled = true;
    try {
      const res = await fetch("/api/invitations/use", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || "No se pudo unir a la finca.");
      msg.textContent = "✅ " + data.message + " Redirigiendo…";
      msg.className = "text-center text-sm mb-3 text-green-600 dark:text-green-400 font-medium";
      window.sileo?.success?.({ title: data.message });
      setTimeout(() => (window.location.href = "/farms"), 900);
    } catch (err) {
      msg.textContent = "⚠️ " + err.message;
      msg.className = "text-center text-sm mb-3 text-rose-600 dark:text-rose-400 font-medium";
      btn.disabled = false;
    }
  });
</script>
