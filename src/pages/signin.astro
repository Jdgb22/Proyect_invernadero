---
import { getSession } from 'auth-astro/server';

/**
 * Deprecated: el inicio de sesión y registro viven en la página principal (/),
 * dentro del componente Welcome. Esta ruta se conserva solo como alias para no
 * romper enlaces antiguos y redirige conservando el destino y la invitación.
 *
 *  - ?desde=/invite/XXXX  → destino tras iniciar sesión
 *  - ?code=K7M4XP9Q      → código de invitación (se reenvía por si se usa)
 */

const session = await getSession(Astro.request);
const code = Astro.url.searchParams.get('code')?.trim() || '';
const desde = Astro.url.searchParams.get('desde') || '';

const params = new URLSearchParams();
if (desde) params.set('desde', desde);
if (code) params.set('code', code);

if (!session) {
  return Astro.redirect(`/${params.toString() ? `?${params.toString()}` : ''}`);
}

return Astro.redirect(desde || '/');
---
