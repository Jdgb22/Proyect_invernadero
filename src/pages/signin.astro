---
import { getSession } from 'auth-astro/server';
import { SignIn } from 'auth-astro/components';

/**
 * Página de inicio de sesión y registro del Proyecto Invernadero.
 * Si el usuario ya tiene sesión activa, redirige al dashboard.
 *
 * Funcionalidades:
 *  - Login con email + contraseña (contra PostgreSQL / pgAdmin)
 *  - Registro de nuevo usuario con asignación de rol
 *  - Login con Google OAuth
 */

const session = await getSession(Astro.request);

if (session) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar Sesión | Proyecto Invernadero</title>
  <meta name="description" content="Accede al sistema de monitoreo del invernadero con tu cuenta institucional." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- FONDO ANIMADO -->
  <div class="bg-scene">
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="bg-orb orb-3"></div>
    <div class="grid-overlay"></div>
  </div>

  <main class="auth-wrapper">

    <!-- LOGO / HEADER SUPERIOR -->
    <div class="brand-header">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M12 3C8 3 4 6 4 10c0 2.5 1.5 4.7 3.7 5.8L7 21h10l-.7-5.2C18.5 14.7 20 12.5 20 10c0-4-4-7-8-7z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v9m-3-4.5 3 4.5 3-4.5"/>
        </svg>
      </div>
      <span class="brand-name">Invernadero</span>
    </div>

    <!-- CARD PRINCIPAL -->
    <div class="auth-card">

      <!-- Encabezado -->
      <div class="auth-header">
        <h1>Bienvenido</h1>
        <p>Sistema de monitoreo ambiental</p>
      </div>

      <!-- Alertas -->
      <div id="alert-box" class="alert hidden" role="alert"></div>

      <!-- TABS -->
      <div class="auth-tabs" role="tablist">
        <button id="tab-login"    class="tab-btn active" role="tab" aria-selected="true">Iniciar Sesión</button>
        <button id="tab-register" class="tab-btn"         role="tab" aria-selected="false">Registrarse</button>
      </div>

      <!-- ── FORMULARIO LOGIN ── -->
      <div id="form-login" class="tab-content active">
        <form id="login-form" class="auth-form" novalidate>
          <div class="form-group">
            <label for="login-email">Correo Electrónico</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <input type="email" id="login-email" name="email"
                placeholder="ejemplo@correo.com" required autocomplete="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="login-password">Contraseña</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <input type="password" id="login-password" name="password"
                placeholder="••••••••" required autocomplete="current-password" />
            </div>
          </div>

          <button type="submit" id="btn-login-submit" class="btn-primary">
            <span class="btn-text">Iniciar Sesión</span>
            <span class="btn-spinner hidden"></span>
          </button>
        </form>

        <!-- Divisor OAuth -->
        <div class="divider"><span>o continúa con</span></div>

        <div class="oauth-area">
          <SignIn provider="google" class="btn-oauth">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Continuar con Google
          </SignIn>
        </div>
      </div>

      <!-- ── FORMULARIO REGISTRO ── -->
      <div id="form-register" class="tab-content">
        <form id="register-form" class="auth-form" novalidate>
          <div class="form-group">
            <label for="reg-name">Nombre completo</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zm-4 7a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <input type="text" id="reg-name" name="name" placeholder="Juan Pérez" autocomplete="name" />
            </div>
          </div>

          <div class="form-group">
            <label for="reg-email">Correo Electrónico</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <input type="email" id="reg-email" name="email"
                placeholder="ejemplo@correo.com" required autocomplete="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="reg-password">Contraseña</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <input type="password" id="reg-password" name="password"
                placeholder="Mínimo 8 caracteres" required autocomplete="new-password" />
            </div>
          </div>

          <div class="form-group">
            <label for="reg-role">Rol en el sistema</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <select id="reg-role" name="role" class="form-select">
                <option value="Usuario X">Usuario X (por defecto)</option>
                <option value="Estudiante">Estudiante</option>
                <option value="Profesor">Profesor</option>
                <option value="Admin">Admin</option>
                <option value="Super admin">Super Admin</option>
              </select>
            </div>
          </div>

          <button type="submit" id="btn-register-submit" class="btn-primary">
            <span class="btn-text">Crear Cuenta</span>
            <span class="btn-spinner hidden"></span>
          </button>
        </form>
      </div>

    </div><!-- /auth-card -->

    <!-- Pie de página -->
    <p class="footer-note">
      Proyecto Invernadero &copy; {new Date().getFullYear()} — Sistema de Monitoreo Ambiental
    </p>
  </main>

</body>
</html>

<script>
  import { signIn } from 'auth-astro/client';

  // ─── Utilidades ─────────────────────────────────────────────
  function showAlert(msg: string, type: 'info' | 'success' | 'error') {
    const box = document.getElementById('alert-box')!;
    box.textContent = msg;
    box.className   = `alert alert-${type}`;
  }

  function setLoading(btn: HTMLButtonElement, loading: boolean) {
    const text    = btn.querySelector('.btn-text')!;
    const spinner = btn.querySelector('.btn-spinner')!;
    btn.disabled  = loading;
    text.classList.toggle('hidden', loading);
    spinner.classList.toggle('hidden', !loading);
  }

  // ─── Tabs ────────────────────────────────────────────────────
  function switchTab(tab: 'login' | 'register') {
    const isLogin = tab === 'login';
    document.getElementById('tab-login')!.classList.toggle('active', isLogin);
    document.getElementById('tab-register')!.classList.toggle('active', !isLogin);
    document.getElementById('form-login')!.classList.toggle('active', isLogin);
    document.getElementById('form-register')!.classList.toggle('active', !isLogin);
    document.getElementById('tab-login')!.setAttribute('aria-selected', String(isLogin));
    document.getElementById('tab-register')!.setAttribute('aria-selected', String(!isLogin));
    // Limpiar alerta al cambiar pestaña
    const box = document.getElementById('alert-box')!;
    box.className = 'alert hidden';
  }

  document.getElementById('tab-login')?.addEventListener('click', () => switchTab('login'));
  document.getElementById('tab-register')?.addEventListener('click', () => switchTab('register'));

  // ─── Login ───────────────────────────────────────────────────
  document.getElementById('login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn      = document.getElementById('btn-login-submit') as HTMLButtonElement;
    const email    = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value;

    showAlert('Verificando credenciales en PostgreSQL...', 'info');
    setLoading(btn, true);

    try {
      // Las credenciales van en el tercer argumento (authorizationParams)
      // Se usa 'as any' porque AstroSignInOptions no re-exporta callbackUrl en su tipo
      await signIn('credentials', { callbackUrl: '/dashboard' } as any, { email, password });
      // Si no redirigió automáticamente, lo hacemos manualmente
      showAlert('¡Sesión iniciada! Redirigiendo...', 'success');
      window.location.href = '/dashboard';
    } catch (err: any) {
      console.error('[Login] Error:', err);
      const msg = err?.message || '';
      if (msg.includes('CredentialsSignin') || msg.includes('credentials')) {
        showAlert('Credenciales incorrectas. Verifica tu correo y contraseña.', 'error');
      } else {
        showAlert('Error de inicio de sesión: ' + msg, 'error');
      }
    } finally {
      setLoading(btn, false);
    }
  });

  // ─── Registro ────────────────────────────────────────────────
  document.getElementById('register-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn      = document.getElementById('btn-register-submit') as HTMLButtonElement;
    const name     = (document.getElementById('reg-name') as HTMLInputElement).value.trim();
    const email    = (document.getElementById('reg-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('reg-password') as HTMLInputElement).value;
    const role     = (document.getElementById('reg-role') as HTMLSelectElement).value;

    if (password.length < 8) {
      showAlert('La contraseña debe tener al menos 8 caracteres.', 'error');
      return;
    }

    showAlert(`Registrando como "${role}" en PostgreSQL...`, 'info');
    setLoading(btn, true);

    try {
      const res  = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password, role }),
      });
      const data = await res.json();

      if (res.ok) {
        showAlert(`¡Cuenta creada como "${data.user.role}"! Redirigiendo al login...`, 'success');
        setTimeout(() => {
          switchTab('login');
          (document.getElementById('login-email') as HTMLInputElement).value = email;
        }, 1500);
      } else {
        showAlert(data.message || 'Error al registrar el usuario.', 'error');
      }
    } catch (err: any) {
      showAlert('Error de conexión con el servidor: ' + err.message, 'error');
    } finally {
      setLoading(btn, false);
    }
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --green-900: #14532d;
    --green-800: #166534;
    --green-700: #15803d;
    --green-500: #22c55e;
    --green-400: #4ade80;
    --green-300: #86efac;
    --lime-400:  #a3e635;
    --lime-300:  #bef264;
    --text-main: #f0fdf4;
    --text-muted:#a1a1aa;
    --bg-card:   rgba(10, 26, 10, 0.75);
    --border:    rgba(34, 197, 94, 0.2);
    --radius-md: 12px;
    --radius-lg: 20px;
    --font: 'Inter', system-ui, sans-serif;
  }

  html, body {
    height: 100%;
    font-family: var(--font);
    background: #030f06;
    color: var(--text-main);
    overflow-x: hidden;
  }

  /* ── Fondo animado ───────────────────────────────────────── */
  .bg-scene {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    overflow: hidden;
  }
  .bg-orb {
    position: absolute; border-radius: 50%;
    filter: blur(80px); opacity: 0.35;
    animation: float 12s ease-in-out infinite;
  }
  .orb-1 { width: 500px; height: 500px; top: -100px; left: -100px; background: radial-gradient(circle, #166534, transparent); animation-delay: 0s; }
  .orb-2 { width: 400px; height: 400px; bottom: -50px; right: -80px; background: radial-gradient(circle, #a3e635, transparent); animation-delay: -4s; }
  .orb-3 { width: 300px; height: 300px; top: 50%; left: 50%; transform: translate(-50%,-50%); background: radial-gradient(circle, #14532d, transparent); animation-delay: -8s; }
  .grid-overlay {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(34,197,94,0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(34,197,94,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(20px, -20px) scale(1.05); }
    66%       { transform: translate(-15px, 15px) scale(0.97); }
  }

  /* ── Layout ──────────────────────────────────────────────── */
  .auth-wrapper {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    min-height: 100vh;
    padding: 1.5rem;
    gap: 1rem;
  }

  /* ── Marca superior ──────────────────────────────────────── */
  .brand-header {
    display: flex; align-items: center; gap: 0.6rem;
    margin-bottom: 0.25rem;
  }
  .brand-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, var(--green-700), var(--lime-400));
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: #fff; padding: 6px;
    box-shadow: 0 0 18px rgba(34,197,94,0.4);
  }
  .brand-icon svg { width: 100%; height: 100%; }
  .brand-name {
    font-size: 1.2rem; font-weight: 700;
    background: linear-gradient(90deg, var(--green-400), var(--lime-300));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  /* ── Card ────────────────────────────────────────────────── */
  .auth-card {
    width: 100%; max-width: 420px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(34,197,94,0.08);
  }

  /* ── Header ──────────────────────────────────────────────── */
  .auth-header { text-align: center; margin-bottom: 1.5rem; }
  .auth-header h1 {
    font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--green-400), var(--lime-300));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .auth-header p { color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem; }

  /* ── Tabs ────────────────────────────────────────────────── */
  .auth-tabs {
    display: flex;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 4px; gap: 4px;
    margin-bottom: 1.25rem;
  }
  .tab-btn {
    flex: 1; padding: 0.55rem 0.5rem;
    border: none; border-radius: 9px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font); font-weight: 600; font-size: 0.875rem;
    cursor: pointer; transition: all 0.2s ease;
  }
  .tab-btn.active {
    background: linear-gradient(135deg, var(--green-700), var(--green-800));
    color: var(--green-300);
    box-shadow: 0 2px 8px rgba(22,101,52,0.5);
  }
  .tab-btn:not(.active):hover { color: var(--green-300); background: rgba(34,197,94,0.06); }

  /* ── Contenido tab ───────────────────────────────────────── */
  .tab-content { display: none; }
  .tab-content.active { display: block; }

  /* ── Formulario ──────────────────────────────────────────── */
  .auth-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-group label { font-size: 0.8rem; font-weight: 600; color: #d1fae5; }
  .input-wrapper { position: relative; }
  .input-icon {
    position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; color: var(--text-muted); pointer-events: none;
  }
  .input-wrapper input,
  .input-wrapper .form-select {
    width: 100%; padding: 0.7rem 0.9rem 0.7rem 2.4rem;
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(34,197,94,0.15);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-family: var(--font); font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    appearance: none;
  }
  .input-wrapper input:focus,
  .input-wrapper .form-select:focus {
    border-color: var(--green-500);
    box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
  }
  .input-wrapper input::placeholder { color: rgba(161,161,170,0.6); }
  .form-select option { background: #0f1f0f; color: #fff; }

  /* ── Botón primario ──────────────────────────────────────── */
  .btn-primary {
    width: 100%; margin-top: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(135deg, var(--green-700), var(--green-800));
    border: 1px solid rgba(34,197,94,0.3);
    border-radius: var(--radius-md);
    color: var(--green-300);
    font-family: var(--font); font-weight: 700; font-size: 0.9rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(22,101,52,0.35);
  }
  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--green-800), #14532d);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(22,101,52,0.5);
  }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .btn-spinner {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--green-300);
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Divisor ─────────────────────────────────────────────── */
  .divider {
    display: flex; align-items: center; gap: 0.75rem;
    margin: 1.25rem 0; color: var(--text-muted); font-size: 0.78rem;
  }
  .divider::before, .divider::after {
    content: ''; flex: 1;
    border-bottom: 1px solid rgba(34,197,94,0.15);
  }

  /* ── OAuth ───────────────────────────────────────────────── */
  .oauth-area { display: flex; flex-direction: column; gap: 0.75rem; }
  .btn-oauth {
    display: flex; align-items: center; justify-content: center; gap: 0.65rem;
    width: 100%; padding: 0.7rem 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-family: var(--font); font-weight: 600; font-size: 0.875rem;
    cursor: pointer; text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-oauth:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.22);
    transform: translateY(-1px);
  }

  /* ── Alertas ─────────────────────────────────────────────── */
  .alert {
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.83rem; font-weight: 500;
    margin-bottom: 1rem; word-break: break-word;
  }
  .alert.hidden { display: none; }
  .alert-info    { background: rgba(59,130,246,0.12);  color: #93c5fd; border: 1px solid rgba(59,130,246,0.25); }
  .alert-success { background: rgba(34,197,94,0.12);   color: #86efac; border: 1px solid rgba(34,197,94,0.25); }
  .alert-error   { background: rgba(239,68,68,0.12);   color: #fca5a5; border: 1px solid rgba(239,68,68,0.25); }

  /* ── Footer ──────────────────────────────────────────────── */
  .footer-note { font-size: 0.75rem; color: rgba(161,161,170,0.5); text-align: center; }

  .hidden { display: none !important; }
</style>
