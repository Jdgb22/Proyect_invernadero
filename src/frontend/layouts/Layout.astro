---
import "../styles/global.css";
import SileoProvider from "../components/SileoProvider.tsx";
---

<!doctype html>
<html lang="es-co">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <style is:inline>
      html {
        background-color: #fafaf9;
      }
      html.dark {
        background-color: #0c0a09;
      }
      @media (prefers-color-scheme: dark) {
        html:not(.light) {
          background-color: #0c0a09;
        }
      }
    </style>
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var media = window.matchMedia("(prefers-color-scheme: dark)");
          function preference() {
            try {
              var stored = localStorage.getItem("macollo-theme");
              return stored === "light" || stored === "dark" ? stored : "system";
            } catch (error) {
              return "system";
            }
          }
          function apply() {
            var pref = preference();
            var dark = pref === "dark" || (pref === "system" && media.matches);
            root.classList.toggle("dark", dark);
            root.classList.toggle("light", pref === "light");
            root.style.colorScheme = dark ? "dark" : "light";
          }
          apply();
          var onMediaChange = function () {
            if (preference() === "system") apply();
          };
          if (media.addEventListener) {
            media.addEventListener("change", onMediaChange);
          }
          window.addEventListener("storage", function (event) {
            if (event.key === "macollo-theme") apply();
          });
        } catch (error) {
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/gulupa.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Macollo</title>
  </head>
  <body>
    <slot />
    <SileoProvider client:load />
    <script>
      import {
        applyTempUnitToDocument,
        applyTheme,
        onPreferencesChanged,
      } from "../../shared/preferences";

      applyTheme();

      const refresh = () => applyTempUnitToDocument();
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", refresh, { once: true });
      } else {
        refresh();
      }
      onPreferencesChanged(() => refresh());
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
