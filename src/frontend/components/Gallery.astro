---
import { pool } from "../../db/client";
import { getAuthUser } from "../../backend/services/authz";
import { getFincaCookie } from "../../backend/services/authz";
import { listFincasForUser } from "../../backend/services/farms";

const user = await getAuthUser(Astro.request);

let rows: any[] = [];
let fincaActivaId: number | null = null;

if (user) {
  const fincas = await listFincasForUser(user.id, user.role);
  const cookieId = Number(getFincaCookie(Astro.request));
  
  if (Number.isInteger(cookieId) && cookieId > 0) {
    const puedeUsar =
      user.role === "Superadmin" ||
      user.role === "Admin" ||
      fincas.some((f: any) => f.id === cookieId && f.activa);
    if (puedeUsar) fincaActivaId = cookieId;
  } else if (fincas.length === 1) {
    fincaActivaId = fincas[0].id;
  }
}

try {
  if (fincaActivaId) {
    const res = await pool.query(
      `
      SELECT 
        p.id, p.url, p.filename, p.width, p.height, p.size_bytes, p.caption, 
        p.taken_at, p.uploaded_at, p.user_id, p.finca_id,
        u.name as user_name, u.image as user_image
      FROM photos p
      LEFT JOIN users u ON u.id = p.user_id
      WHERE p.finca_id = $1
      ORDER BY COALESCE(p.taken_at, p.uploaded_at) DESC
      `,
      [fincaActivaId]
    );
    rows = res.rows;
  } else {
    rows = [];
  }
} catch (e) {
  rows = [];
}

function formatDate(d: Date | string | null) {
  if (!d) return "";
  const date = typeof d === "string" ? new Date(d) : d;
  return date.toLocaleString("es-CO", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}

function formatSize(bytes: number | null) {
  if (!bytes) return "";
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-stone-900 dark:text-white flex items-center gap-2">
        <svg class="w-7 h-7 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Galería
      </h1>
      <p class="text-sm text-stone-600 dark:text-stone-400 mt-1">Fotografías registradas en el invernadero</p>
    </div>
    <div class="text-sm text-stone-500 dark:text-stone-400">
      {rows.length} {rows.length === 1 ? "fotografía" : "fotografías"}
    </div>
  </header>

  {rows.length === 0 && (
    <div class="flex flex-col items-center justify-center py-16 px-4">
      <div class="w-20 h-20 rounded-full bg-stone-100 dark:bg-stone-800 flex items-center justify-center mb-4">
        <svg class="w-10 h-10 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-stone-900 dark:text-white mb-2">No hay fotos aún</h2>
      <p class="text-sm text-stone-600 dark:text-stone-400 text-center max-w-md">
        Las fotografías tomadas en esta finca por cualquier usuario aparecerán aquí.
      </p>
    </div>
  )}

  {rows.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {rows.map((photo: any) => (
        <article class="group relative bg-white dark:bg-stone-900 rounded-xl overflow-hidden shadow-sm border border-stone-200 dark:border-stone-700 hover:shadow-md hover:border-emerald-300 dark:hover:border-emerald-700 transition-all duration-200">
          <a href={`/gallery/${photo.id}`} class="block">
            <div class="aspect-square w-full overflow-hidden bg-stone-100 dark:bg-stone-800">
              <img
                src={`/api/gallery/${photo.id}/file`}
                alt={photo.caption || "Fotografía del invernadero"}
                class="w-full h-full object-contain bg-stone-50 dark:bg-stone-900 group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          </a>
          <div class="p-3 space-y-2">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0 flex-1">
                <img
                  src={photo.user_image || "/avatar-default.png"}
                  alt={photo.user_name || "Usuario"}
                  class="w-7 h-7 rounded-full object-cover flex-shrink-0 border border-stone-200 dark:border-stone-600"
                  onerror="this.src='/avatar-default.png'"
                />
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-medium text-stone-900 dark:text-white truncate">{photo.user_name || "Usuario"}</p>
                  <p class="text-[10px] text-stone-500 dark:text-stone-400">
                    {formatDate(photo.taken_at || photo.uploaded_at)}
                  </p>
                </div>
              </div>
              <a
                href={`/gallery/${photo.id}`}
                class="p-1.5 rounded-lg hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors flex-shrink-0"
                title="Ver en grande"
              >
                <svg class="w-4 h-4 text-stone-500 dark:text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                </svg>
              </a>
            </div>
            {photo.caption && (
              <p class="text-xs text-stone-600 dark:text-stone-300 line-clamp-2 leading-relaxed">{photo.caption}</p>
            )}
            <div class="flex items-center gap-3 text-[10px] text-stone-400 dark:text-stone-500">
              {photo.width && photo.height && (
                <span>{photo.width} × {photo.height}</span>
              )}
              {photo.size_bytes && (
                <span>{formatSize(photo.size_bytes)}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
