---
// src/frontend/components/TripsDiagnosticModal.astro
// Modal de Inspección Fitosanitaria con Cámara / Subida de Foto y Machine Learning (BioCLIP 2.5).
// Integrado al diseño del Invernadero Macollo.
---

<!-- Botón Flotante / Acceso Rápido para Abrir Escáner -->
<div class="fixed bottom-6 right-6 z-40">
  <button
    id="open-trips-scanner-btn"
    type="button"
    class="flex items-center gap-2.5 px-4 py-3 bg-gradient-to-r from-emerald-600 via-green-600 to-lime-600 hover:from-emerald-700 hover:to-lime-700 text-white rounded-full shadow-xl shadow-green-900/30 font-bold text-sm transform hover:scale-105 active:scale-95 transition-all duration-200 border-2 border-white/20"
    title="Escanear Trips con Cámara y BioCLIP 2.5"
  >
    <span class="text-xl">📸</span>
    <span>Escanear Trips</span>
  </button>
</div>

<!-- Modal Principal de Diagnóstico -->
<div
  id="trips-scanner-modal"
  class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 p-3 sm:p-4 overflow-y-auto"
>
  <div class="absolute inset-0 bg-black/75 backdrop-blur-sm cursor-pointer" id="trips-modal-backdrop"></div>

  <div
    class="relative bg-[#f4fce3] dark:bg-stone-900 rounded-3xl shadow-2xl border border-green-200 dark:border-green-800/60 w-full max-w-2xl p-5 sm:p-7 transform scale-95 transition-transform duration-300 text-stone-900 dark:text-stone-100"
    id="trips-modal-content"
    style="max-height: calc(100dvh - 2rem); overflow-y: auto;"
  >
    <!-- Header del Modal -->
    <div class="flex items-start justify-between border-b border-green-200/70 dark:border-green-900/50 pb-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 to-lime-400 flex items-center justify-center text-2xl shadow-md">
          🐛
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-lg sm:text-xl font-black text-green-950 dark:text-white">Detección de Trips</h3>
            <span class="px-2 py-0.5 text-[10px] font-extrabold rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700">BioCLIP 2.5</span>
          </div>
          <p class="text-xs text-green-800 dark:text-stone-300 mt-0.5">Monitoreo fitosanitario en Gulupa (<i>Passiflora edulis</i>)</p>
        </div>
      </div>
      <button
        id="close-trips-modal-btn"
        type="button"
        class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 bg-stone-100 dark:bg-stone-800 p-2 rounded-full transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Indicador de Estado del Servidor ML -->
    <div id="ml-status-pill" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold mb-4 bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 border border-stone-200 dark:border-stone-700">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse" id="ml-status-dot"></span>
        <span id="ml-status-text">Verificando servidor de IA...</span>
      </span>
      <span class="text-[10px] text-stone-600 dark:text-stone-300" id="ml-status-device">--</span>
    </div>

    <!-- Temperatura Ambiental -->
    <div class="bg-white/70 dark:bg-stone-800/60 p-3 rounded-2xl border border-green-100 dark:border-green-900/40 mb-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">🌡️</span>
        <div>
          <div class="text-[11px] font-bold text-green-900 dark:text-green-300">Temperatura Invernadero (automática)</div>
          <div class="text-[10px] text-stone-600 dark:text-stone-300">Tomada del clima actual del inicio; no editable</div>
        </div>
      </div>
      <div class="flex items-center gap-1.5 bg-green-50 dark:bg-stone-900 px-2.5 py-1 rounded-xl border border-green-200 dark:border-stone-700">
        <input
          type="number"
          id="trips-temp-input"
          value="22.0"
          step="0.5"
          min="10"
          max="40"
          readonly
          aria-readonly="true"
          title="Temperatura automática del inicio"
          class="w-14 bg-transparent font-bold font-mono text-sm text-green-900 dark:text-green-200 text-right outline-none cursor-default"
        />
        <span id="trips-temp-unit" class="text-xs font-bold text-green-700 dark:text-stone-300">°C</span>
      </div>
    </div>

    <!-- Visor de Cámara y Vista Previa -->
    <div class="relative bg-black rounded-2xl overflow-hidden aspect-[4/3] max-h-72 w-full mb-4 flex items-center justify-center border border-stone-800 shadow-inner">
      <video id="trips-video" autoplay playsinline muted class="w-full h-full object-cover hidden"></video>
      <img id="trips-preview" alt="Foto capturada" class="w-full h-full object-cover hidden" />

      <!-- Mensaje Inicial si cámara no está activa -->
      <div id="trips-placeholder" class="text-center p-6 text-stone-400">
        <div class="text-4xl mb-2">📸</div>
        <div class="text-xs font-bold text-stone-300">Toma una foto con tu cámara o sube un archivo</div>
        <div class="text-[11px] text-stone-500 mt-1">Centra el trips, la flor o la hoja con buena luz</div>
      </div>

      <!-- Spinner durante análisis -->
      <div id="trips-loading-overlay" class="absolute inset-0 bg-black/80 backdrop-blur-xs flex flex-col items-center justify-center text-white hidden z-20">
        <div class="w-10 h-10 border-4 border-emerald-500/30 border-t-emerald-400 rounded-full animate-spin mb-3"></div>
        <div class="text-xs font-bold text-emerald-300">BioCLIP 2.5 procesando inferencia...</div>
        <div class="text-[10px] text-stone-400 mt-1">Discriminando taxonomía y estadio biológico</div>
      </div>
    </div>

    <!-- Controles de Captura -->
    <div class="flex items-center justify-center gap-3 mb-5">
      <button
        id="trips-toggle-camera-btn"
        type="button"
        class="px-4 py-2.5 rounded-xl bg-white dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 border border-stone-200 dark:border-stone-700 font-bold text-xs flex items-center gap-1.5 transition-colors"
      >
        <span>📷</span> <span id="camera-btn-label">Activar Cámara</span>
      </button>

      <button
        id="trips-capture-btn"
        type="button"
        class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs shadow-md shadow-emerald-700/20 flex items-center gap-1.5 transition-all hidden"
      >
        <span>⚡</span> Capturar y Analizar
      </button>

      <label
        for="trips-file-input"
        class="px-4 py-2.5 rounded-xl bg-white dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 border border-stone-200 dark:border-stone-700 font-bold text-xs flex items-center gap-1.5 cursor-pointer transition-colors"
      >
        <span>📁</span> Subir Foto
      </label>
      <input
        type="file"
        id="trips-file-input"
        accept="image/*"
        capture="environment"
        class="hidden"
      />
    </div>

    <!-- Resultados del Diagnóstico -->
    <div id="trips-results-card" class="hidden animate-fadeIn">
      <!-- Banner de Diagnóstico -->
      <div id="trips-result-banner" class="p-4 rounded-2xl border mb-3 flex items-center justify-between">
        <div>
          <div id="trips-result-title" class="text-base font-black">--</div>
          <div id="trips-result-sub" class="text-xs mt-0.5 opacity-90">--</div>
        </div>
        <div class="text-right pl-3">
          <div class="text-[10px] uppercase tracking-wider font-bold opacity-75">Confianza</div>
          <div id="trips-result-conf" class="text-xl font-black font-mono">--%</div>
        </div>
      </div>

      <!-- Tarjetas de Información Biológica -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
        <!-- Estadio Biológico -->
        <div class="bg-white/80 dark:bg-stone-800/80 p-3.5 rounded-2xl border border-green-100 dark:border-green-900/40">
          <div class="text-[10px] font-bold uppercase tracking-wider text-green-700 dark:text-green-400 mb-1">🧬 Estadio Detectado</div>
          <div id="trips-stage-name" class="text-sm font-bold text-stone-900 dark:text-stone-100">--</div>
          <div id="trips-stage-conf" class="text-[11px] text-stone-500 dark:text-stone-400 mt-1">--</div>
        </div>

        <!-- Ciclo Térmico & Urgencia -->
        <div class="bg-white/80 dark:bg-stone-800/80 p-3.5 rounded-2xl border border-green-100 dark:border-green-900/40">
          <div class="text-[10px] font-bold uppercase tracking-wider text-green-700 dark:text-green-400 mb-1">⏱️ Ciclo Térmico & Urgencia</div>
          <div class="flex items-center gap-2 mb-1">
            <span id="trips-urgency-badge" class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wide">--</span>
            <span id="trips-days-to-adult" class="text-xs font-bold font-mono">--</span>
          </div>
          <div id="trips-urgency-rationale" class="text-[11px] text-stone-500 dark:text-stone-400 line-clamp-3">--</div>
        </div>
      </div>

      <!-- Plan de Acción Agronómica MIP -->
      <div id="trips-mip-section" class="bg-white/80 dark:bg-stone-800/80 p-4 rounded-2xl border border-green-100 dark:border-green-900/40 text-xs">
        <div class="font-extrabold text-green-900 dark:text-green-300 text-sm mb-2 flex items-center gap-2">
          <span>📋</span> Plan de Manejo Integrado de Plagas (Gulupa)
        </div>

        <div class="space-y-2 mt-3">
          <div>
            <div class="font-bold text-emerald-700 dark:text-emerald-400 text-[11px] mb-1">🐞 Control Biológico</div>
            <ul id="trips-bio-list" class="list-disc pl-4 space-y-1 text-stone-600 dark:text-stone-300 text-[11px]"></ul>
          </div>
          <div>
            <div class="font-bold text-blue-700 dark:text-blue-400 text-[11px] mb-1">🟦 Trampas Azules (460 nm)</div>
            <ul id="trips-etho-list" class="list-disc pl-4 space-y-1 text-stone-600 dark:text-stone-300 text-[11px]"></ul>
          </div>
          <div>
            <div class="font-bold text-amber-700 dark:text-amber-400 text-[11px] mb-1">🧪 Control Biorracional y Químico (IRAC)</div>
            <ul id="trips-chem-list" class="list-disc pl-4 space-y-1 text-stone-600 dark:text-stone-300 text-[11px]"></ul>
          </div>
        </div>

        <!-- Alerta de Exportación -->
        <div id="trips-export-alert" class="mt-3 p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-800 dark:text-rose-200 text-[11px] leading-relaxed">
          --
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { getTempUnit } from "../../shared/preferences";

  let videoStream: MediaStream | null = null;
  let activeImageBlob: Blob | null = null;

  const modal = document.getElementById("trips-scanner-modal");
  const modalContent = document.getElementById("trips-modal-content");
  const openBtn = document.getElementById("open-trips-scanner-btn");
  const closeBtn = document.getElementById("close-trips-modal-btn");
  const backdrop = document.getElementById("trips-modal-backdrop");

  const videoEl = document.getElementById("trips-video") as HTMLVideoElement | null;
  const previewEl = document.getElementById("trips-preview") as HTMLImageElement | null;
  const placeholderEl = document.getElementById("trips-placeholder");
  const loadingOverlay = document.getElementById("trips-loading-overlay");

  const toggleCamBtn = document.getElementById("trips-toggle-camera-btn");
  const captureBtn = document.getElementById("trips-capture-btn");
  const fileInput = document.getElementById("trips-file-input") as HTMLInputElement | null;
  const tempInput = document.getElementById("trips-temp-input") as HTMLInputElement | null;
  const tempUnitEl = document.getElementById("trips-temp-unit");
  const camBtnLabel = document.getElementById("camera-btn-label");

  function updateAutoTemperature() {
    const celsius = Number((window as any).__MACOLLO_WEATHER__?.temperatureC);
    if (!Number.isFinite(celsius)) return;
    const unit = getTempUnit();
    const value = unit === "F" ? (celsius * 9) / 5 + 32 : celsius;
    if (tempInput) tempInput.value = value.toFixed(1);
    if (tempUnitEl) tempUnitEl.textContent = unit === "F" ? "°F" : "°C";
  }

  window.addEventListener("macollo:weather-updated", updateAutoTemperature);
  window.addEventListener("macollo:preferences-changed", updateAutoTemperature);
  updateAutoTemperature();

  // Apertura y Cierre del Modal
  function openModal() {
    if (!modal || !modalContent) return;
    updateAutoTemperature();
    modal.classList.remove("hidden");
    void modal.offsetWidth;
    modal.classList.remove("opacity-0");
    modalContent.classList.remove("scale-95");
    checkMlHealth();
  }

  function closeModal() {
    if (!modal || !modalContent) return;
    stopCamera();
    modal.classList.add("opacity-0");
    modalContent.classList.add("scale-95");
    setTimeout(() => {
      modal.classList.add("hidden");
    }, 300);
  }

  openBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);

  // Cámara
  async function startCamera() {
    try {
      const isSecureContext =
        window.isSecureContext ||
        location.protocol === "https:" ||
        location.hostname === "localhost" ||
        location.hostname === "127.0.0.1" ||
        location.hostname === "[::1]";

      if (!isSecureContext) {
        // Los navegadores bloquean getUserMedia en HTTP por IP. Usar cámara nativa con <input capture>
        alert("Por seguridad, este navegador bloquea la cámara en HTTP por IP. Se abrirá la cámara nativa para tomar la foto.");
        fileInput?.click();
        return;
      }

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert("Este navegador no permite acceder a la cámara directamente. Usa el botón 'Subir archivo' para abrir la cámara nativa.");
        fileInput?.click();
        return;
      }

      // Intentar primero con cámara trasera (ideal para campo)
      try {
        videoStream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: { facingMode: { exact: "environment" }, width: { ideal: 1280 }, height: { ideal: 720 } },
        });
      } catch (errEnv) {
        // intentar fallback a cualquier cámara
        // Fallback: cualquier cámara disponible
        videoStream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 } },
        });
      }

      if (videoEl) {
        videoEl.srcObject = videoStream;
        videoEl.setAttribute("playsinline", "true");
        videoEl.muted = true;
        videoEl.classList.remove("hidden");
        await videoEl.play().catch(() => {});
      }
      previewEl?.classList.add("hidden");
      placeholderEl?.classList.add("hidden");
      captureBtn?.classList.remove("hidden");
      if (camBtnLabel) camBtnLabel.textContent = "Apagar Cámara";
    } catch (err: any) {
      alert("No se pudo acceder a la cámara. Abriendo la cámara nativa desde archivos...");
      fileInput?.click();
    }
  }

  function stopCamera() {
    if (videoStream) {
      videoStream.getTracks().forEach((t) => t.stop());
      videoStream = null;
    }
    videoEl?.classList.add("hidden");
    captureBtn?.classList.add("hidden");
    if (camBtnLabel) camBtnLabel.textContent = "Activar Cámara";
  }

  toggleCamBtn?.addEventListener("click", () => {
    if (videoStream) {
      stopCamera();
      if (!activeImageBlob) placeholderEl?.classList.remove("hidden");
    } else {
      startCamera();
    }
  });

  async function saveToGallery(blob: Blob) {
    try {
      const formData = new FormData();
      formData.append("file", blob, "trips-diagnostico.jpg");
      formData.append("caption", "Diagnóstico de trips - Escáner BioCLIP 2.5");
      await fetch("/api/gallery/upload", {
        method: "POST",
        body: formData,
      });
    } catch (e) {
    }
  }

  // Captura de frame desde el video
  captureBtn?.addEventListener("click", () => {
    if (!videoEl || !videoEl.videoWidth) return;
    const canvas = document.createElement("canvas");
    canvas.width = videoEl.videoWidth;
    canvas.height = videoEl.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(videoEl, 0, 0);

    canvas.toBlob((blob) => {
      if (!blob) return;
      activeImageBlob = blob;
      if (previewEl) {
        previewEl.src = URL.createObjectURL(blob);
        previewEl.classList.remove("hidden");
      }
      stopCamera();
      saveToGallery(blob);
      ejecutarDiagnostico(blob);
    }, "image/jpeg", 0.92);
  });

  // Subir archivo desde galería/cámara nativa del celular
  fileInput?.addEventListener("change", (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    stopCamera();
    activeImageBlob = file;
    if (previewEl) {
      previewEl.src = URL.createObjectURL(file);
      previewEl.classList.remove("hidden");
    }
    placeholderEl?.classList.add("hidden");
    saveToGallery(file);
    ejecutarDiagnostico(file);
  });

  // Health check hacia la API
  async function checkMlHealth() {
    const dot = document.getElementById("ml-status-dot");
    const text = document.getElementById("ml-status-text");
    const device = document.getElementById("ml-status-device");
    try {
      const res = await fetch("/api/trips-diagnosis");
      const data = await res.json();
      if (data.status === "online" && data.ml_service?.model_loaded) {
        if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-500";
        if (text) text.textContent = "IA BioCLIP 2.5 Conectada y Lista";
        if (device) device.textContent = `Dispositivo: ${String(data.ml_service.device).toUpperCase()}`;
      } else {
        throw new Error("Modelo no listo");
      }
    } catch {
      if (dot) dot.className = "w-2 h-2 rounded-full bg-rose-500";
      if (text) text.textContent = "Servidor IA offline (inicia Macollo ./run_server.sh)";
      if (device) device.textContent = "Puerto 8000";
    }
  }

  // Diagnóstico
  async function ejecutarDiagnostico(blob: Blob) {
    loadingOverlay?.classList.remove("hidden");
    const resultsCard = document.getElementById("trips-results-card");
    resultsCard?.classList.add("hidden");

    const shownTemp = tempInput ? parseFloat(tempInput.value) : NaN;
    const unit = getTempUnit();
    const tempC = Number.isFinite(shownTemp)
      ? unit === "F"
        ? ((shownTemp - 32) * 5) / 9
        : shownTemp
      : 22.0;

    const fd = new FormData();
    fd.append("file", blob, "muestra.jpg");
    fd.append("temperature_c", tempC.toFixed(1));
    fd.append("crop", "gulupa");

    try {
      const res = await fetch("/api/trips-diagnosis", {
        method: "POST",
        body: fd,
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || `HTTP ${res.status}`);
      }

      renderResultados(data);
    } catch (err: any) {
      alert("❌ " + err.message);
    } finally {
      loadingOverlay?.classList.add("hidden");
    }
  }

  function renderResultados(data: any) {
    const card = document.getElementById("trips-results-card");
    const banner = document.getElementById("trips-result-banner");
    const title = document.getElementById("trips-result-title");
    const sub = document.getElementById("trips-result-sub");
    const conf = document.getElementById("trips-result-conf");

    const stageName = document.getElementById("trips-stage-name");
    const stageConf = document.getElementById("trips-stage-conf");
    const urgencyBadge = document.getElementById("trips-urgency-badge");
    const daysToAdult = document.getElementById("trips-days-to-adult");
    const urgencyRationale = document.getElementById("trips-urgency-rationale");

    const mipSection = document.getElementById("trips-mip-section");
    const bioList = document.getElementById("trips-bio-list");
    const ethoList = document.getElementById("trips-etho-list");
    const chemList = document.getElementById("trips-chem-list");
    const exportAlert = document.getElementById("trips-export-alert");

    if (!card || !banner || !title || !sub || !conf) return;
    card.classList.remove("hidden");

    const confPct = (data.thrips_confidence * 100).toFixed(1);
    conf.textContent = `${confPct}%`;

    if (data.is_thrips) {
      banner.className = "p-4 rounded-2xl border mb-3 flex items-center justify-between bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-900 text-rose-900 dark:text-rose-100";
      title.textContent = "⚠️ TRIPS DETECTADO";
      sub.textContent = `${data.detected_target} • Latencia: ${data.inference_time_ms} ms`;

      if (stageName) stageName.textContent = data.detected_stage;
      if (stageConf) stageConf.textContent = `Confianza de estadio: ${(data.stage_confidence * 100).toFixed(1)}%`;

      if (data.cycle_info) {
        if (urgencyBadge) {
          urgencyBadge.textContent = data.cycle_info.urgency_level;
          urgencyBadge.className = data.cycle_info.urgency_level === "CRÍTICO"
            ? "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wide bg-rose-200 text-rose-900 dark:bg-rose-900 dark:text-rose-200"
            : "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wide bg-amber-200 text-amber-900 dark:bg-amber-900 dark:text-amber-200";
        }
        if (daysToAdult) daysToAdult.textContent = data.cycle_info.days_to_adult;
        if (urgencyRationale) urgencyRationale.textContent = `${data.cycle_info.urgency_rationale} (${data.cycle_info.temperature_c}°C)`;
      }

      if (mipSection && data.recommendations) {
        mipSection.classList.remove("hidden");
        if (bioList) bioList.innerHTML = data.recommendations.biological_control.map((i: string) => `<li>${i}</li>`).join("");
        if (ethoList) ethoList.innerHTML = data.recommendations.ethological_control.map((i: string) => `<li>${i}</li>`).join("");
        if (chemList) chemList.innerHTML = data.recommendations.chemical_biorational_control.map((i: string) => `<li>${i}</li>`).join("");
        if (exportAlert) exportAlert.textContent = data.recommendations.export_impact_alert;
      }
    } else {
      banner.className = "p-4 rounded-2xl border mb-3 flex items-center justify-between bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-900 text-emerald-900 dark:text-emerald-100";
      title.textContent = "✅ NO CORRESPONDE A TRIPS";
      sub.textContent = `Clasificación: ${data.detected_target} • Latencia: ${data.inference_time_ms} ms`;

      if (stageName) stageName.textContent = "Sin infestación confirmada";
      if (stageConf) stageConf.textContent = "La muestra no presenta morfología diagnóstica de Trips.";

      if (urgencyBadge) {
        urgencyBadge.textContent = "MONITOREO";
        urgencyBadge.className = "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wide bg-emerald-200 text-emerald-900 dark:bg-emerald-900 dark:text-emerald-200";
      }
      if (daysToAdult) daysToAdult.textContent = "Cultivo Protegido";
      if (urgencyRationale) urgencyRationale.textContent = "Mantén la inspección regular semanal con trampas cromotrópicas azules.";

      if (mipSection) mipSection.classList.add("hidden");
    }

    card.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
</script>

