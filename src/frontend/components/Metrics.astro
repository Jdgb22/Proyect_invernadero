---
// src/frontend/components/Metrics.astro
// Panel Profesional de Métricas Agronómicas para Invernadero AquaSens.
// Matriz de 4 Filas (t0 a t3) × 5 Columnas (Col 1 a Col 5) = 20 Plantas.
// Al hacer clic en cualquier planta (en el selector rápido o en la tabla Excel),
// se abre un MODAL emergente con la última medición de hoy y sus gráficos individuales.

import {
  getAllPlantsGrid,
  type PlantMatrixItem,
  type MetricRecord
} from "../../backend/services/metricsData";

interface Props {
  currentUserName?: string;
  currentUserRole?: string;
}

const { currentUserName = "Administrador", currentUserRole = "Líder de Cultivo" } = Astro.props;

const plants: PlantMatrixItem[] = getAllPlantsGrid();

// Helpers para badges y semáforos
function getPhBadge(ph: number) {
  if (ph >= 6.0 && ph <= 6.8) {
    return { label: "Óptimo", class: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300" };
  }
  if (ph >= 5.5 && ph <= 7.2) {
    return { label: "Atención", class: "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300" };
  }
  return { label: "Crítico", class: "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300" };
}

function getProdBadge(prod: string) {
  if (prod === 'Alta') return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300";
  if (prod === 'Media') return "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300";
  return "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300";
}

function getHealthBadge(sanidad: string) {
  if (sanidad === 'Excelente' || sanidad === 'Saludable') {
    return { icon: '🟢', label: sanidad, class: "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800" };
  }
  if (sanidad === 'Vulnerable') {
    return { icon: '🟡', label: sanidad, class: "bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border-amber-200 dark:border-amber-800" };
  }
  return { icon: '🔴', label: sanidad, class: "bg-rose-50 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 border-rose-200 dark:border-rose-800" };
}

// Agregaciones y métricas globales para los 6 gráficos generales del invernadero
const totalPlants = plants.length || 20;
const globalAvgPh = +(plants.reduce((acc, p) => acc + p.latestMetric.phSuelo, 0) / totalPlants).toFixed(2);
const globalAvgTin = +(plants.reduce((acc, p) => acc + p.latestMetric.tempInterna, 0) / totalPlants).toFixed(1);
const globalAvgTout = +(plants.reduce((acc, p) => acc + p.latestMetric.tempExterna, 0) / totalPlants).toFixed(1);
const globalAvgTsoil = +(plants.reduce((acc, p) => acc + p.latestMetric.tempSuelo, 0) / totalPlants).toFixed(1);
const globalAvgGrowth = Math.round(plants.reduce((acc, p) => acc + p.latestMetric.crecimiento, 0) / totalPlants);

const filasKeys = ['t0', 't1', 't2', 't3'] as const;
const filaMetrics = filasKeys.map((f) => {
  const fPlants = plants.filter(p => p.fila === f);
  const count = fPlants.length || 1;
  const avgPh = +(fPlants.reduce((acc, p) => acc + p.latestMetric.phSuelo, 0) / count).toFixed(2);
  const avgTin = +(fPlants.reduce((acc, p) => acc + p.latestMetric.tempInterna, 0) / count).toFixed(1);
  const avgTout = +(fPlants.reduce((acc, p) => acc + p.latestMetric.tempExterna, 0) / count).toFixed(1);
  const avgTsoil = +(fPlants.reduce((acc, p) => acc + p.latestMetric.tempSuelo, 0) / count).toFixed(1);
  const avgGrowth = Math.round(fPlants.reduce((acc, p) => acc + p.latestMetric.crecimiento, 0) / count);
  return {
    fila: f,
    label: `Fila ${f}`,
    plants: fPlants,
    avgPh,
    avgTin,
    avgTout,
    avgTsoil,
    avgGrowth
  };
});

const healthCounts = {
  Excelente: plants.filter(p => p.latestMetric.sanidad === 'Excelente').length,
  Saludable: plants.filter(p => p.latestMetric.sanidad === 'Saludable').length,
  Vulnerable: plants.filter(p => p.latestMetric.sanidad === 'Vulnerable').length,
  Crítica: plants.filter(p => p.latestMetric.sanidad === 'Crítica').length,
};

const prodCounts = {
  Alta: plants.filter(p => p.latestMetric.productividad === 'Alta').length,
  Media: plants.filter(p => p.latestMetric.productividad === 'Media').length,
  Baja: plants.filter(p => p.latestMetric.productividad === 'Baja').length,
};

const healthyRatio = Math.round(((healthCounts.Excelente + healthCounts.Saludable) / totalPlants) * 100);
---

<!-- Datos de plantas serializados de forma segura para el script de cliente -->
<script id="plants-data-source" type="application/json" set:html={JSON.stringify(plants)}></script>

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8">
  
  <!-- Encabezado Principal -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="flex items-center gap-3.5">
      <div class="p-3 bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-2xl shadow-md">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-black text-gray-900 dark:text-white tracking-tight">
            Métricas de Cultivo por Planta
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
          Sesión activa: <strong class="text-gray-800 dark:text-gray-200 font-semibold">{currentUserName}</strong> ({currentUserRole})
        </p>
      </div>
    </div>

    <!-- Botones de Acción Superiores -->
    <div class="flex flex-wrap items-center gap-2.5">
      <button
        id="btn-toggle-charts"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 border border-indigo-200 dark:border-indigo-800 transition-all cursor-pointer"
      >
        <span id="charts-toggle-icon">🌐</span>
        <span id="charts-toggle-text">Ver Gráficas Globales</span>
      </button>

      <button
        id="btn-toggle-table-top"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 border border-emerald-300 dark:border-emerald-800 transition-all cursor-pointer"
      >
        <span id="top-table-toggle-icon">📑</span>
        <span id="top-table-toggle-text">Ampliar Tabla Excel</span>
      </button>

      <button
        id="btn-open-modal"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 shadow-md shadow-emerald-600/20 hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 cursor-pointer transform hover:-translate-y-0.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Nueva Medición</span>
      </button>

      <button
        id="btn-export-csv"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-emerald-800 dark:text-emerald-200 bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 border border-emerald-300 dark:border-emerald-700 transition-all cursor-pointer shadow-xs"
        title="Descargar base de datos agronómica organizada en formato Excel (.xlsx)"
      >
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span id="btn-export-text">Exportar Excel (.xlsx)</span>
      </button>
    </div>
  </div>

  <!-- 1. SELECTOR RÁPIDO: MATRIZ DE PLANTAS 4x5 (t0 a t3 × Col 1 a Col 5) -->
  <div class="bg-white dark:bg-gray-800 p-5 sm:p-6 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
      <div>
        <h2 class="text-base sm:text-lg font-black text-gray-900 dark:text-white flex items-center gap-2">
          <span>🌱</span> Selector Rápido: Estado de los Cultivos
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
          Haz clic en cualquier planta para <strong>abrir su ficha de medición de hoy y sus gráficos individuales</strong>.
        </p>
      </div>

      <!-- Leyenda de Estados -->
      <div class="flex items-center gap-3 text-xs font-semibold text-gray-600 dark:text-gray-300">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Óptimo
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Atención
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Crítico
        </div>
      </div>
    </div>

    <!-- Cuadrícula 4x5 de 20 botones de planta -->
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3">
      {plants.map((plant) => {
        const m = plant.latestMetric;
        const isCritical = m.sanidad === 'Crítica';
        const isWarning = m.sanidad === 'Vulnerable';
        const statusBorder = isCritical
          ? 'border-rose-300 dark:border-rose-800 bg-rose-50/60 dark:bg-rose-950/20 hover:border-rose-500'
          : isWarning
            ? 'border-amber-300 dark:border-amber-800 bg-amber-50/60 dark:bg-amber-950/20 hover:border-amber-500'
            : 'border-emerald-200 dark:border-emerald-800/40 bg-emerald-50/50 dark:bg-emerald-950/10 hover:border-emerald-500';

        const dotColor = isCritical ? 'bg-rose-500' : isWarning ? 'bg-amber-400' : 'bg-emerald-500';
        const plantIcon = isCritical ? '🥀' : isWarning ? '🌿' : '🪴';

        return (
          <button
            type="button"
            class={`plant-card-btn text-left p-3 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-pointer relative group ${statusBorder}`}
            data-fila={plant.fila}
            data-columna={plant.columna}
            data-plantid={plant.plantId}
            title={`Ver métricas y gráficos de ${plant.plantId} (${plant.fila} • ${plant.columna})`}
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[10px] font-black font-mono uppercase tracking-wider text-gray-600 dark:text-gray-300">
                {plant.plantId} • {plant.fila}
              </span>
              <span class={`w-2.5 h-2.5 rounded-full ${dotColor} shadow-xs`}></span>
            </div>

            <div class="flex items-center justify-between my-1">
              <span class="text-2xl group-hover:scale-115 transition-transform duration-200">{plantIcon}</span>
              <div class="text-right">
                <span class="text-xs font-mono font-black text-gray-800 dark:text-gray-200 block">
                  {plant.columna}
                </span>
                <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold">
                  {m.crecimiento}%
                </span>
              </div>
            </div>

            <div class="mt-2 flex items-center justify-between text-[9px] font-mono text-gray-500 dark:text-gray-400 border-t border-gray-200/70 dark:border-gray-700/70 pt-1.5">
              <span>🧪 {m.phSuelo.toFixed(1)} pH</span>
              <span>🌡️ {m.tempInterna.toFixed(1)}°C</span>
            </div>

            <div class="mt-1 text-center">
              <span class="text-[9px] font-bold text-indigo-600 dark:text-indigo-400 group-hover:underline flex items-center justify-center gap-1">
                <span>Ver Analítica</span>
                <span>→</span>
              </span>
            </div>
          </button>
        );
      })}
    </div>
  </div>

  <!-- 2. GRÁFICOS GENERALES CONSOLIDADOS DEL INVERNADERO (COLAPSABLE / MINIMIZABLE) -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
    
    <!-- Barra superior de Gráficos Globales (con botón Minimizar / Ampliar) -->
    <div class="px-5 py-3.5 bg-gray-50 dark:bg-gray-800/90 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="p-1.5 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 text-sm">🌐</span>
        <div>
          <h3 class="font-black text-gray-900 dark:text-white text-sm">
            Gráficos Generales del Invernadero AquaSens
          </h3>
          <p class="text-[11px] text-gray-500 dark:text-gray-400">
            Consolidado estadístico y tendencias agronómicas de todas las plantas (Filas t0 a t3)
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <span class="px-2.5 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-[11px] font-bold hidden sm:inline">
          Vista Global 20 Plantas
        </span>

        <button
          id="btn-toggle-charts-inline"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl font-bold text-xs bg-white dark:bg-gray-700 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-gray-600 border border-indigo-200 dark:border-gray-600 shadow-xs transition-all cursor-pointer"
        >
          <span id="charts-inline-toggle-icon">⤢</span>
          <span id="charts-inline-toggle-text">Ampliar Gráficos Globales</span>
        </button>
      </div>
    </div>

    <!-- Contenedor Colapsable de Gráficos (Inicia Minimizado) -->
    <div id="general-charts-collapsible" class="hidden p-5 sm:p-6 space-y-6 transition-all duration-300">
      
      <!-- Resumen Superior de Indicadores Globales -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pb-2">
        <div class="p-3 bg-blue-50/70 dark:bg-blue-950/30 rounded-xl border border-blue-200 dark:border-blue-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block">pH Promedio</span>
          <span class="text-xl font-black text-blue-900 dark:text-blue-100">{globalAvgPh} <span class="text-xs font-normal opacity-70">pH</span></span>
          <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 block mt-0.5">● Rango Óptimo</span>
        </div>
        <div class="p-3 bg-amber-50/70 dark:bg-amber-950/30 rounded-xl border border-amber-200 dark:border-amber-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 block">Temp. Interna</span>
          <span class="text-xl font-black text-amber-900 dark:text-amber-100">{globalAvgTin}°C</span>
          <span class="text-[10px] text-gray-500 dark:text-gray-400 block mt-0.5">Microclima</span>
        </div>
        <div class="p-3 bg-sky-50/70 dark:bg-sky-950/30 rounded-xl border border-sky-200 dark:border-sky-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block">Temp. Externa</span>
          <span class="text-xl font-black text-sky-900 dark:text-sky-100">{globalAvgTout}°C</span>
          <span class="text-[10px] text-gray-500 dark:text-gray-400 block mt-0.5">Ambiente</span>
        </div>
        <div class="p-3 bg-emerald-50/70 dark:bg-emerald-950/30 rounded-xl border border-emerald-200 dark:border-emerald-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block">Temp. Suelo</span>
          <span class="text-xl font-black text-emerald-900 dark:text-emerald-100">{globalAvgTsoil}°C</span>
          <span class="text-[10px] text-gray-500 dark:text-gray-400 block mt-0.5">Radicular</span>
        </div>
        <div class="p-3 bg-teal-50/70 dark:bg-teal-950/30 rounded-xl border border-teal-200 dark:border-teal-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 block">Crecimiento</span>
          <span class="text-xl font-black text-teal-900 dark:text-teal-100">{globalAvgGrowth}%</span>
          <span class="text-[10px] text-gray-500 dark:text-gray-400 block mt-0.5">Avance Foliar</span>
        </div>
        <div class="p-3 bg-purple-50/70 dark:bg-purple-950/30 rounded-xl border border-purple-200 dark:border-purple-900/40 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 block">Sanidad General</span>
          <span class="text-xl font-black text-purple-900 dark:text-purple-100">{healthyRatio}%</span>
          <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 block mt-0.5">16/20 Plantas OK</span>
        </div>
      </div>

      <!-- Cuadrícula de 6 Gráficos Generales (1 por cada medición agronómica) -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        
        <!-- GRÁFICO 1: pH del Suelo de todas las plantas -->
        <div class="chart-card-maximizable bg-gray-50 dark:bg-gray-900/40 p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-xs flex flex-col justify-between cursor-pointer hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all group relative"
          data-chart-title="1. pH del Suelo (General Invernadero)"
          data-chart-subtitle="Zona óptima (6.0 - 6.8 pH) y dispersión de las 20 plantas"
          data-chart-icon="🧪"
          data-chart-badge={`${globalAvgPh} pH Promedio`}
          data-chart-info="El pH del suelo regula directamente la solubilidad y absorción de nutrientes. El promedio general es de ${globalAvgPh} pH, ubicándose en la banda óptima agronómica. Se aprecian valores controlados en las 4 filas con alertas puntuales en t2 Col 4."
        >
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="p-2 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 text-base">🧪</span>
              <div>
                <h4 class="font-extrabold text-gray-900 dark:text-white text-sm">1. pH del Suelo (General)</h4>
                <p class="text-[10px] text-gray-500 dark:text-gray-400">Zona óptima (6.0 - 6.8 pH) y dispersión por fila</p>
              </div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-black px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 text-[11px]">
                {globalAvgPh} pH
              </span>
              <span class="opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-300 text-xs font-bold" title="Click para maximizar">⤢</span>
            </div>
          </div>

          <div class="w-full h-44 relative bg-white dark:bg-gray-800/80 rounded-xl p-3 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
            <svg class="w-full h-full overflow-visible" viewBox="0 0 460 130">
              <!-- Zona Óptima -->
              <rect x="40" y="53" width="390" height="32" fill="rgba(16, 185, 129, 0.12)" rx="4"></rect>
              <text x="45" y="49" fill="#10B981" font-size="8.5" font-weight="bold">Banda Óptima (6.0 - 6.8)</text>

              <!-- Guías -->
              <line x1="40" y1="25" x2="430" y2="25" stroke="currentColor" stroke-dasharray="3,3" class="text-gray-300 dark:text-gray-700" stroke-width="1" />
              <text x="15" y="28" class="fill-gray-400 text-[9px] font-mono">7.5</text>
              <line x1="40" y1="65" x2="430" y2="65" stroke="currentColor" stroke-dasharray="3,3" class="text-gray-300 dark:text-gray-700" stroke-width="1" />
              <text x="15" y="68" class="fill-gray-400 text-[9px] font-mono">6.5</text>
              <line x1="40" y1="105" x2="430" y2="105" stroke="currentColor" stroke-dasharray="3,3" class="text-gray-300 dark:text-gray-700" stroke-width="1" />
              <text x="15" y="108" class="fill-gray-400 text-[9px] font-mono">5.5</text>

              <!-- Curva de Promedios por Fila -->
              <path d="M 70,75 Q 120,77 170,79 T 270,71 T 370,69" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />

              <!-- Nodos de Fila -->
              <circle cx="70" cy="75" r="5" fill="#3B82F6" stroke="#fff" stroke-width="2"><title>Fila t0: {filaMetrics[0].avgPh} pH</title></circle>
              <text x="60" y="65" fill="#1E40AF" class="dark:fill-blue-300 text-[10px] font-bold">{filaMetrics[0].avgPh}</text>

