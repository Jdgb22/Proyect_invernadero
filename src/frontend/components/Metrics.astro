    if (rawData) plantsState = JSON.parse(rawData);
  } catch (err) {
    console.error("Error al cargar datos de plantas:", err);
  }

  // Elementos del Modal de Planta Individual
  const plantModal = document.getElementById('plant-metrics-modal');
  const plantModalBackdrop = document.getElementById('plant-modal-backdrop');
  const btnClosePlantModal = document.getElementById('btn-close-plant-modal');
  const btnClosePlantModalBottom = document.getElementById('btn-close-plant-modal-bottom');
  const btnMeasureThisPlant = document.getElementById('btn-measure-this-plant');

  const modalPlantIcon = document.getElementById('modal-plant-icon');
  const modalPlantTitle = document.getElementById('modal-plant-title');
  const modalPlantSubtitle = document.getElementById('modal-plant-subtitle');
  const modalPlantHealth = document.getElementById('modal-plant-health');
  const modalPlantPhase = document.getElementById('modal-plant-phase');
  const modalPlantTime = document.getElementById('modal-plant-time');
  const modalPlantResp = document.getElementById('modal-plant-resp');
  const modalPlantObs = document.getElementById('modal-plant-obs');

  const modalKpiPh = document.getElementById('modal-kpi-ph');
  const modalKpiPhDesc = document.getElementById('modal-kpi-ph-desc');
  const modalKpiTin = document.getElementById('modal-kpi-tin');
  const modalKpiTsoil = document.getElementById('modal-kpi-tsoil');
  const modalKpiTout = document.getElementById('modal-kpi-tout');
  const modalKpiGrowth = document.getElementById('modal-kpi-growth');
  const modalKpiGrowthBar = document.getElementById('modal-kpi-growth-bar');
  const modalKpiProd = document.getElementById('modal-kpi-prod');
  const modalGrowthGain = document.getElementById('modal-growth-gain');

  const modalSvgPh = document.getElementById('modal-svg-ph');
  const modalSvgTin = document.getElementById('modal-svg-tin');
  const modalSvgTout = document.getElementById('modal-svg-tout');
  const modalSvgTsoil = document.getElementById('modal-svg-tsoil');
  const modalSvgGrowth = document.getElementById('modal-svg-growth');
  const modalSvgHealth = document.getElementById('modal-svg-health');
  const modalHealthBadgeChart = document.getElementById('modal-health-badge-chart');

  let currentOpenPlant: any = null;

  // Función para cerrar el modal de planta
  function closePlantModal() {
    plantModal?.classList.add('hidden');
  }

  btnClosePlantModal?.addEventListener('click', closePlantModal);
  btnClosePlantModalBottom?.addEventListener('click', closePlantModal);
  plantModalBackdrop?.addEventListener('click', closePlantModal);

  // Renderizar Gráfico 1: pH Individual (SVG)
  function renderSvgPh(history: any[]) {
    if (!modalSvgPh || !history || history.length === 0) return;
    const minPh = 5.0;
    const maxPh = 8.0;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getY = (val: number) => h - pad - ((val - minPh) / (maxPh - minPh)) * (h - pad * 2);
    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    const yOptTop = getY(6.8);
    const yOptBottom = getY(6.0);
    const optHeight = Math.abs(yOptBottom - yOptTop);

    let pathD = '';
    const points: any[] = [];

    history.forEach((rec, idx) => {
      const x = getX(idx);
      const y = getY(rec.phSuelo);
      points.push({ x, y, val: rec.phSuelo });
      if (idx === 0) pathD += `M ${x},${y}`;
      else pathD += ` L ${x},${y}`;
    });

    let circlesSvg = '';
    points.forEach((pt) => {
      const fillColor = pt.val >= 6.0 && pt.val <= 6.8 ? '#10B981' : pt.val >= 5.5 && pt.val <= 7.2 ? '#F59E0B' : '#EF4444';
      circlesSvg += `
        <circle cx="${pt.x}" cy="${pt.y}" r="4.5" fill="${fillColor}" stroke="#ffffff" stroke-width="2">
          <title>${pt.val} pH</title>
        </circle>
        <text x="${pt.x}" y="${pt.y - 6}" fill="#374151" class="dark:fill-gray-200" font-size="8.5" font-weight="bold" text-anchor="middle">
          ${pt.val}
        </text>
      `;
    });

    modalSvgPh.innerHTML = `
      <rect x="${pad}" y="${yOptTop}" width="${w - pad * 2}" height="${optHeight}" fill="rgba(16, 185, 129, 0.15)" rx="3" />
      <text x="${pad + 4}" y="${yOptTop + 8}" fill="#10B981" font-size="7" font-weight="bold">Óptimo (6.0 - 6.8)</text>
      
      <line x1="${pad}" y1="${getY(7.5)}" x2="${w - pad}" y2="${getY(7.5)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(6.5)}" x2="${w - pad}" y2="${getY(6.5)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(5.5)}" x2="${w - pad}" y2="${getY(5.5)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />

      <path d="${pathD}" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      ${circlesSvg}
    `;
  }

  // Renderizar Gráfico 2: Temperatura Interna Individual
  function renderSvgTin(history: any[]) {
    if (!modalSvgTin || !history || history.length === 0) return;
    const minT = 20;
    const maxT = 32;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getY = (val: number) => h - pad - ((val - minT) / (maxT - minT)) * (h - pad * 2);
    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    const yConfTop = getY(26);
    const yConfBot = getY(23);
    const confHeight = Math.abs(yConfBot - yConfTop);

    let pathD = '';
    const points: any[] = [];

    history.forEach((rec, idx) => {
      const x = getX(idx);
      const y = getY(rec.tempInterna);
      points.push({ x, y, val: rec.tempInterna });
      if (idx === 0) pathD += `M ${x},${y}`;
      else pathD += ` L ${x},${y}`;
    });

    let circlesSvg = '';
    points.forEach((pt) => {
      circlesSvg += `
        <circle cx="${pt.x}" cy="${pt.y}" r="4" fill="#F59E0B" stroke="#ffffff" stroke-width="2">
          <title>${pt.val}°C</title>
        </circle>
        <text x="${pt.x}" y="${pt.y - 6}" fill="#B45309" class="dark:fill-amber-300" font-size="8.5" font-weight="bold" text-anchor="middle">
          ${pt.val}°
        </text>
      `;
    });

    modalSvgTin.innerHTML = `
      <rect x="${pad}" y="${yConfTop}" width="${w - pad * 2}" height="${confHeight}" fill="rgba(245, 158, 11, 0.12)" rx="3" />
      <text x="${pad + 4}" y="${yConfTop + 8}" fill="#D97706" font-size="7" font-weight="bold">Confort (23° - 26°C)</text>
      
      <line x1="${pad}" y1="${getY(30)}" x2="${w - pad}" y2="${getY(30)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(26)}" x2="${w - pad}" y2="${getY(26)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(22)}" x2="${w - pad}" y2="${getY(22)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />

      <path d="${pathD}" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      ${circlesSvg}
    `;
  }

  // Renderizar Gráfico 3: Temperatura Externa Individual
  function renderSvgTout(history: any[]) {
    if (!modalSvgTout || !history || history.length === 0) return;
    const minT = 16;
    const maxT = 26;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getY = (val: number) => h - pad - ((val - minT) / (maxT - minT)) * (h - pad * 2);
    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    let pathD = '';
    const points: any[] = [];

    history.forEach((rec, idx) => {
      const x = getX(idx);
      const y = getY(rec.tempExterna);
      points.push({ x, y, val: rec.tempExterna });
      if (idx === 0) pathD += `M ${x},${y}`;
      else pathD += ` L ${x},${y}`;
    });

    let circlesSvg = '';
    points.forEach((pt) => {
      circlesSvg += `
        <circle cx="${pt.x}" cy="${pt.y}" r="3.5" fill="#0EA5E9" stroke="#ffffff" stroke-width="2">
          <title>${pt.val}°C</title>
        </circle>
        <text x="${pt.x}" y="${pt.y - 6}" fill="#0369A1" class="dark:fill-sky-300" font-size="8.5" font-weight="bold" text-anchor="middle">
          ${pt.val}°
        </text>
      `;
    });

    modalSvgTout.innerHTML = `
      <line x1="${pad}" y1="${getY(24)}" x2="${w - pad}" y2="${getY(24)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(20)}" x2="${w - pad}" y2="${getY(20)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />

      <path d="${pathD}" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-dasharray="4,2" stroke-linecap="round" stroke-linejoin="round" />
      ${circlesSvg}
    `;
  }

  // Renderizar Gráfico 4: Temperatura Suelo Individual
  function renderSvgTsoil(history: any[]) {
    if (!modalSvgTsoil || !history || history.length === 0) return;
    const minT = 16;
    const maxT = 28;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getY = (val: number) => h - pad - ((val - minT) / (maxT - minT)) * (h - pad * 2);
    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    const yOptTop = getY(22);
    const yOptBot = getY(19);
    const optHeight = Math.abs(yOptBot - yOptTop);

    let pathD = '';
    const points: any[] = [];

    history.forEach((rec, idx) => {
      const x = getX(idx);
      const y = getY(rec.tempSuelo);
      points.push({ x, y, val: rec.tempSuelo });
      if (idx === 0) pathD += `M ${x},${y}`;
      else pathD += ` L ${x},${y}`;
    });

    let circlesSvg = '';
    points.forEach((pt) => {
      const isGood = pt.val >= 19 && pt.val <= 22.5;
      circlesSvg += `
        <circle cx="${pt.x}" cy="${pt.y}" r="4" fill="${isGood ? '#10B981' : '#EF4444'}" stroke="#ffffff" stroke-width="2">
          <title>${pt.val}°C</title>
        </circle>
        <text x="${pt.x}" y="${pt.y - 6}" fill="#047857" class="dark:fill-emerald-300" font-size="8.5" font-weight="bold" text-anchor="middle">
          ${pt.val}°
        </text>
      `;
    });

    modalSvgTsoil.innerHTML = `
      <rect x="${pad}" y="${yOptTop}" width="${w - pad * 2}" height="${optHeight}" fill="rgba(16, 185, 129, 0.12)" rx="3" />
      <text x="${pad + 4}" y="${yOptTop + 8}" fill="#10B981" font-size="7" font-weight="bold">Radicular Óptimo (19° - 22°C)</text>

      <line x1="${pad}" y1="${getY(26)}" x2="${w - pad}" y2="${getY(26)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(22)}" x2="${w - pad}" y2="${getY(22)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <line x1="${pad}" y1="${getY(18)}" x2="${w - pad}" y2="${getY(18)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />

      <path d="${pathD}" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      ${circlesSvg}
    `;
  }

  // Renderizar Gráfico 5: Crecimiento Individual
  function renderSvgGrowth(history: any[]) {
    if (!modalSvgGrowth || !history || history.length === 0) return;
    const minG = 0;
    const maxG = 100;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getY = (val: number) => h - pad - ((val - minG) / (maxG - minG)) * (h - pad * 2);
    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    let pathLine = '';
    let pathArea = '';

    history.forEach((rec, idx) => {
      const x = getX(idx);
      const y = getY(rec.crecimiento);

      if (idx === 0) {
        pathLine += `M ${x},${y}`;
        pathArea += `M ${x},${h - pad} L ${x},${y}`;
      } else {
        pathLine += ` L ${x},${y}`;
        pathArea += ` L ${x},${y}`;
      }
    });

    const lastX = getX(history.length - 1);
    pathArea += ` L ${lastX},${h - pad} Z`;

    const firstG = history[0].crecimiento;
    const lastG = history[history.length - 1].crecimiento;
    const diff = lastG - firstG;
    if (modalGrowthGain) {
      modalGrowthGain.textContent = `${diff >= 0 ? '+' : ''}${diff}% este ciclo`;
    }

    modalSvgGrowth.innerHTML = `
      <defs>
        <linearGradient id="modalGrowthGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#14B8A6" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#14B8A6" stop-opacity="0.0"/>
        </linearGradient>
      </defs>

      <line x1="${pad}" y1="${getY(80)}" x2="${w - pad}" y2="${getY(80)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <text x="4" y="${getY(80) + 3}" fill="#9CA3AF" font-size="7.5">80%</text>
      <line x1="${pad}" y1="${getY(50)}" x2="${w - pad}" y2="${getY(50)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <text x="4" y="${getY(50) + 3}" fill="#9CA3AF" font-size="7.5">50%</text>
      <line x1="${pad}" y1="${getY(20)}" x2="${w - pad}" y2="${getY(20)}" stroke="#E5E7EB" stroke-dasharray="2,2" stroke-width="1" />
      <text x="4" y="${getY(20) + 3}" fill="#9CA3AF" font-size="7.5">20%</text>

      <path d="${pathArea}" fill="url(#modalGrowthGrad)" />
      <path d="${pathLine}" fill="none" stroke="#0D9488" stroke-width="2.5" stroke-linecap="round" />

      <circle cx="${lastX}" cy="${getY(lastG)}" r="4.5" fill="#0D9488" stroke="#fff" stroke-width="2">
        <title>Crecimiento actual: ${lastG}%</title>
      </circle>
      <text x="${lastX}" y="${getY(lastG) - 6}" fill="#0D9488" font-size="8.5" font-weight="bold" text-anchor="middle">
        ${lastG}%
      </text>
    `;
  }

  // Renderizar Gráfico 6: Sanidad & Productividad Individual
  function renderSvgHealth(history: any[]) {
    if (!modalSvgHealth || !history || history.length === 0) return;
    const h = 100;
    const w = 280;
    const pad = 24;

    const getX = (idx: number) => pad + (idx / (history.length - 1 || 1)) * (w - pad * 2);

    let barsSvg = '';
    history.forEach((rec, idx) => {
      const x = getX(idx);
      const isGood = rec.sanidad === 'Excelente' || rec.sanidad === 'Saludable';
      const isCrit = rec.sanidad === 'Crítica';
      const color = isCrit ? '#EF4444' : isGood ? '#10B981' : '#F59E0B';
      const prodHeight = rec.productividad === 'Alta' ? 48 : rec.productividad === 'Media' ? 32 : 16;
      const y = h - pad - prodHeight;

      barsSvg += `
        <rect x="${x - 9}" y="${y}" width="18" height="${prodHeight}" rx="4" fill="${color}" opacity="0.85">
          <title>${rec.fecha}: ${rec.sanidad} • Prod ${rec.productividad}</title>
        </rect>
        <text x="${x}" y="${y - 4}" fill="${color}" font-size="8" font-weight="bold" text-anchor="middle">
          ${rec.productividad}
        </text>
      `;
    });

    const last = history[history.length - 1];
    if (modalHealthBadgeChart) {
      modalHealthBadgeChart.textContent = `${last.sanidad} • ${last.productividad}`;
    }

    modalSvgHealth.innerHTML = `
      <line x1="${pad}" y1="${h - pad}" x2="${w - pad}" y2="${h - pad}" stroke="#E5E7EB" stroke-width="1.5" />
      ${barsSvg}
    `;
  }

  // FUNCIÓN PRINCIPAL: ABRIR MODAL CON DATOS Y GRÁFICOS DE LA PLANTA
  function openPlantModal(fila: string, columna: string) {
    const found = plantsState.find(p => p.fila === fila && p.columna === columna);
    if (!found) return;
    currentOpenPlant = found;
    const m = found.latestMetric;

    // Poblar textos de cabecera
    if (modalPlantTitle) modalPlantTitle.textContent = `Planta ${found.plantId} (Fila ${found.fila} • ${found.columna})`;
    if (modalPlantSubtitle) {
      modalPlantSubtitle.innerHTML = `Medición de hoy registrada a las <strong id="modal-plant-time">${m.hora}</strong> (${m.fecha}) • Responsable: <strong id="modal-plant-resp">${m.responsable}</strong>`;
    }

    const isCritical = m.sanidad === 'Crítica';
    const isWarning = m.sanidad === 'Vulnerable';
    const icon = isCritical ? '🥀' : isWarning ? '🌿' : '🪴';
    if (modalPlantIcon) modalPlantIcon.textContent = icon;

    if (modalPlantHealth) {
      modalPlantHealth.textContent = `${isCritical ? '🔴' : isWarning ? '🟡' : '🟢'} ${m.sanidad}`;
      modalPlantHealth.className = `px-2.5 py-0.5 rounded-full text-xs font-bold border ${
        isCritical 
          ? 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800'
          : isWarning
            ? 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800'
            : 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800'
      }`;
    }

    if (modalPlantPhase) modalPlantPhase.textContent = m.faseCrecimiento;
    if (modalPlantObs) modalPlantObs.textContent = m.observaciones || 'Sin observaciones adicionales registradas hoy.';

    // Poblar KPIs numéricos
    if (modalKpiPh) modalKpiPh.textContent = m.phSuelo.toFixed(1);
    if (modalKpiPhDesc) {
      const isPhOpt = m.phSuelo >= 6.0 && m.phSuelo <= 6.8;
      modalKpiPhDesc.textContent = isPhOpt ? 'Óptimo (6.0-6.8)' : m.phSuelo < 6.0 ? 'Ácido (<6.0)' : 'Alcalino (>6.8)';
      modalKpiPhDesc.className = `block text-[10px] font-bold mt-0.5 ${isPhOpt ? 'text-emerald-600' : 'text-amber-600'}`;
    }

    if (modalKpiTin) modalKpiTin.textContent = `${m.tempInterna.toFixed(1)}°C`;
    if (modalKpiTsoil) modalKpiTsoil.textContent = `${m.tempSuelo.toFixed(1)}°C`;
    if (modalKpiTout) modalKpiTout.textContent = `${m.tempExterna.toFixed(1)}°C`;
    if (modalKpiGrowth) modalKpiGrowth.textContent = `${m.crecimiento}%`;
    if (modalKpiGrowthBar) modalKpiGrowthBar.style.width = `${m.crecimiento}%`;
    if (modalKpiProd) modalKpiProd.textContent = m.productividad;

    // Mostrar modal
    plantModal?.classList.remove('hidden');

    // Renderizar los 6 gráficos SVG vectoriales individuales
    renderSvgPh(found.history);
    renderSvgTin(found.history);
    renderSvgTout(found.history);
    renderSvgTsoil(found.history);
    renderSvgGrowth(found.history);
    renderSvgHealth(found.history);
  }

  // Elementos del Modal de Maximización de Gráfico (Lightbox Fullscreen)
  const chartMaxModal = document.getElementById('chart-maximize-modal');
  const chartMaxBackdrop = document.getElementById('chart-max-backdrop');
  const btnCloseChartMax = document.getElementById('btn-close-chart-max');
  const btnCloseChartMaxBottom = document.getElementById('btn-close-chart-max-bottom');
  const maxChartIcon = document.getElementById('max-chart-icon');
  const maxChartTitle = document.getElementById('max-chart-title');
  const maxChartSubtitle = document.getElementById('max-chart-subtitle');
  const maxChartBadge = document.getElementById('max-chart-badge');
  const maxChartSvgContainer = document.getElementById('max-chart-svg-container');
  const maxChartFooter = document.getElementById('max-chart-footer');
  const maxChartInfoText = document.getElementById('max-chart-info-text');

  function closeChartMax() {
    chartMaxModal?.classList.add('hidden');
  }

  btnCloseChartMax?.addEventListener('click', closeChartMax);
  btnCloseChartMaxBottom?.addEventListener('click', closeChartMax);
  chartMaxBackdrop?.addEventListener('click', closeChartMax);

  function openChartMaxFromCard(card: HTMLElement) {
    const title = card.dataset.chartTitle || 'Gráfico Agronómico';
    const subtitle = card.dataset.chartSubtitle || 'Visualización detallada de la medición';
    const icon = card.dataset.chartIcon || '📊';
    const badge = card.dataset.chartBadge || 'Métrica';
    const info = card.dataset.chartInfo || 'Detalle agronómico ampliado de los parámetros evaluados.';

    if (maxChartTitle) maxChartTitle.textContent = title;
    if (maxChartSubtitle) maxChartSubtitle.textContent = subtitle;
    if (maxChartIcon) maxChartIcon.textContent = icon;
    if (maxChartBadge) maxChartBadge.textContent = badge;
    if (maxChartInfoText) maxChartInfoText.textContent = info;

    const svg = card.querySelector('svg');
    if (svg && maxChartSvgContainer) {
      const clone = svg.cloneNode(true) as SVGElement;
      clone.removeAttribute('id');
      clone.setAttribute('class', 'w-full h-full max-h-[320px] overflow-visible');
      maxChartSvgContainer.innerHTML = '';
      maxChartSvgContainer.appendChild(clone);
    }

    const footerDiv = card.querySelector('.flex.justify-between:last-child');
    if (footerDiv && maxChartFooter) {
      maxChartFooter.innerHTML = footerDiv.innerHTML;
    }

    chartMaxModal?.classList.remove('hidden');
  }

  // Delegar clics para maximizar en cualquier tarjeta con clase .chart-card-maximizable
  document.querySelectorAll<HTMLElement>('.chart-card-maximizable').forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('button') && !target.closest('.chart-card-maximizable')) return;
      openChartMaxFromCard(card);
    });
  });

  // Manejo de tecla Escape para ambos modales
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (chartMaxModal && !chartMaxModal.classList.contains('hidden')) {
        closeChartMax();
        e.stopPropagation();
      } else if (plantModal && !plantModal.classList.contains('hidden')) {
        closePlantModal();
      }
    }
  });

  // Vincular clics en la cuadrícula de botones del Selector Rápido
  document.querySelectorAll<HTMLButtonElement>('.plant-card-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const fila = btn.dataset.fila;
      const col = btn.dataset.columna;
      if (fila && col) openPlantModal(fila, col);
    });
  });

  // Vincular clics en las filas de la tabla Excel
  document.querySelectorAll<HTMLTableRowElement>('.plant-table-row').forEach((row) => {
    row.addEventListener('click', () => {
      const fila = row.dataset.fila;
      const col = row.dataset.columna;
      if (fila && col) openPlantModal(fila, col);
    });
  });

  // Botón dentro del modal de planta para medir directamente esa planta
  btnMeasureThisPlant?.addEventListener('click', () => {
    if (currentOpenPlant) {
      closePlantModal();
      const inputFila = document.getElementById('input-fila') as HTMLSelectElement | null;
      const inputCol = document.getElementById('input-columna') as HTMLSelectElement | null;
      if (inputFila) inputFila.value = currentOpenPlant.fila;
      if (inputCol) inputCol.value = currentOpenPlant.columna;
      modalAdd?.classList.remove('hidden');
    }
  });

  // Toggle de Gráficos Globales (Minimizar / Ampliar)
  const btnToggleCharts = document.getElementById('btn-toggle-charts');
  const btnToggleChartsInline = document.getElementById('btn-toggle-charts-inline');
  const generalChartsCollapsible = document.getElementById('general-charts-collapsible');
  const chartsToggleText = document.getElementById('charts-toggle-text');
  const chartsInlineToggleIcon = document.getElementById('charts-inline-toggle-icon');
  const chartsInlineToggleText = document.getElementById('charts-inline-toggle-text');
  let generalChartsVisible = false;

  function toggleGeneralCharts() {
    generalChartsVisible = !generalChartsVisible;
    generalChartsCollapsible?.classList.toggle('hidden', !generalChartsVisible);

    if (chartsToggleText) {
      chartsToggleText.textContent = generalChartsVisible ? 'Minimizar Gráficas Globales' : 'Ver Gráficas Globales';
    }
    if (chartsInlineToggleIcon) {
      chartsInlineToggleIcon.textContent = generalChartsVisible ? '⌃' : '⤢';
    }
    if (chartsInlineToggleText) {
      chartsInlineToggleText.textContent = generalChartsVisible ? 'Minimizar Gráficos' : 'Ampliar Gráficos Globales';
    }

    if (generalChartsVisible) {
      generalChartsCollapsible?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  btnToggleCharts?.addEventListener('click', toggleGeneralCharts);
  btnToggleChartsInline?.addEventListener('click', toggleGeneralCharts);

  // Toggle Minimizar / Ampliar Tabla Excel
  const btnToggleExcelTable = document.getElementById('btn-toggle-excel-table');
  const btnToggleTableTop = document.getElementById('btn-toggle-table-top');
  const excelTableCollapsible = document.getElementById('excel-table-collapsible');
  const excelToggleIcon = document.getElementById('excel-toggle-icon');
  const excelToggleText = document.getElementById('excel-toggle-text');
  const topTableToggleText = document.getElementById('top-table-toggle-text');
  let tableExpanded = false;

  function toggleExcelTable() {
    tableExpanded = !tableExpanded;
    excelTableCollapsible?.classList.toggle('hidden', !tableExpanded);

    if (excelToggleIcon) excelToggleIcon.textContent = tableExpanded ? '⌃' : '⤢';
    if (excelToggleText) excelToggleText.textContent = tableExpanded ? 'Minimizar Tabla' : 'Ampliar Tabla Completa';
    if (topTableToggleText) topTableToggleText.textContent = tableExpanded ? 'Minimizar Tabla Excel' : 'Ampliar Tabla Excel';

    if (tableExpanded) {
      excelTableCollapsible?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  btnToggleExcelTable?.addEventListener('click', toggleExcelTable);
  btnToggleTableTop?.addEventListener('click', toggleExcelTable);

  // Filtrado de la Tabla
  const tableSearch = document.getElementById('table-search') as HTMLInputElement | null;
  const filterRowSelect = document.getElementById('filter-row-select') as HTMLSelectElement | null;
  const filterHealthSelect = document.getElementById('filter-health-select') as HTMLSelectElement | null;
  const showingCount = document.getElementById('plants-showing-count');

  function filterTable() {
    const q = tableSearch?.value.toLowerCase().trim() || '';
    const rowFilter = filterRowSelect?.value || 'all';
    const healthFilter = filterHealthSelect?.value || 'all';

    const rows = document.querySelectorAll<HTMLTableRowElement>('.plant-table-row');
    let visible = 0;

    rows.forEach((r) => {
      const fila = r.dataset.fila || '';
      const col = r.dataset.columna || '';
      const id = r.dataset.plantid?.toLowerCase() || '';
      const resp = r.dataset.resp?.toLowerCase() || '';
      const health = r.dataset.health || '';

      const matchText = !q || id.includes(q) || fila.toLowerCase().includes(q) || col.toLowerCase().includes(q) || resp.includes(q);
      const matchRow = rowFilter === 'all' || fila === rowFilter;
      const matchHealth = healthFilter === 'all' || health === healthFilter;

      if (matchText && matchRow && matchHealth) {
        r.style.display = '';
        visible++;
      } else {
        r.style.display = 'none';
      }
    });

    if (showingCount) showingCount.textContent = visible.toString();
  }

  tableSearch?.addEventListener('input', filterTable);
  filterRowSelect?.addEventListener('change', filterTable);
  filterHealthSelect?.addEventListener('change', filterTable);

  // Exportar Excel Nativo (.xlsx) Organizado y Formateado
  const handleExportExcel = async (btn: HTMLElement | null) => {
    const originalContent = btn ? btn.innerHTML : '';
    if (btn) {
      btn.style.pointerEvents = 'none';
      btn.innerHTML = `
        <svg class="animate-spin w-4 h-4 text-emerald-700 dark:text-emerald-300" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Generando Excel...</span>
      `;
    }

    try {
      const response = await fetch('/api/export-excel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plants: plantsState })
      });

      if (!response.ok) {
        throw new Error(`Error en servidor (${response.status})`);
      }

      const blob = await response.blob();
      const nowStr = new Date().toISOString().slice(0, 10);
      const filename = `AquaSens_Mediciones_Invernadero_${nowStr}.xlsx`;

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (btn) {
        btn.innerHTML = `
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>¡Excel Descargado!</span>
        `;
        setTimeout(() => {
          btn.innerHTML = originalContent;
          btn.style.pointerEvents = '';
        }, 2200);
      }
    } catch (err) {
      console.error('Error al exportar Excel:', err);
      // Fallback a CSV formateado con UTF-8 BOM y punto y coma (;) para compatibilidad en Excel español
      let csv = "PlantaID;Invernadero;Fila;Columna;Fecha;Hora;pH Suelo;Temp Interna (°C);Temp Externa (°C);Temp Suelo (°C);Crecimiento (%);Productividad;Sanidad;Responsable;Observaciones\n";
      plantsState.forEach((p) => {
        const m = p.latestMetric;
        csv += `"${p.plantId}";"Invernadero AquaSens";"${p.fila}";"${p.columna}";"${m.fecha}";"${m.hora}";${m.phSuelo};${m.tempInterna};${m.tempExterna};${m.tempSuelo};${m.crecimiento}%;"${m.productividad}";"${m.sanidad}";"${m.responsable}";"${m.observaciones || ''}"\n`;
      });

      const bom = "\uFEFF";
      const blob = new Blob([bom + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `AquaSens_Mediciones_Invernadero_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (btn) {
        btn.innerHTML = originalContent;
        btn.style.pointerEvents = '';
      }
    }
  };

  const btnExportTop = document.getElementById('btn-export-csv');
  btnExportTop?.addEventListener('click', () => handleExportExcel(btnExportTop));

  const btnExportTable = document.getElementById('btn-export-excel-table');
  btnExportTable?.addEventListener('click', () => handleExportExcel(btnExportTable));

  // Modal Nueva Medición Formulario
  const modalAdd = document.getElementById('modal-add');
  const btnOpenModal = document.getElementById('btn-open-modal');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const formNewMetric = document.getElementById('form-new-metric') as HTMLFormElement | null;

  btnOpenModal?.addEventListener('click', () => modalAdd?.classList.remove('hidden'));
  const closeModalForm = () => modalAdd?.classList.add('hidden');
  btnCloseModal?.addEventListener('click', closeModalForm);
  btnCancelModal?.addEventListener('click', closeModalForm);

  formNewMetric?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fila = (document.getElementById('input-fila') as HTMLSelectElement).value;
    const columna = (document.getElementById('input-columna') as HTMLSelectElement).value;
    const ph = parseFloat((document.getElementById('input-ph') as HTMLInputElement).value);
    const tin = parseFloat((document.getElementById('input-tin') as HTMLInputElement).value);
    const tout = parseFloat((document.getElementById('input-tout') as HTMLInputElement).value);
    const tsoil = parseFloat((document.getElementById('input-tsoil') as HTMLInputElement).value);
    const growth = parseInt((document.getElementById('input-growth') as HTMLInputElement).value, 10);
    const prod = (document.getElementById('input-prod') as HTMLSelectElement).value as any;
    const health = (document.getElementById('input-health') as HTMLSelectElement).value as any;
    const obs = (document.getElementById('input-obs') as HTMLTextAreaElement).value || 'Nueva toma de datos.';

    const respName = document.getElementById('session-user-name')?.textContent?.trim() || "Usuario Activo";
    const respRole = document.getElementById('session-user-role')?.textContent?.trim() || "Personal de Campo";

    const todayStr = new Date().toISOString().slice(0, 10);
    const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });

    const targetPlant = plantsState.find(p => p.fila === fila && p.columna === columna);
    if (targetPlant) {
      const newRecord = {
        id: `MET-${fila}-${columna.replace(' ', '')}-${Date.now()}`,
        invernadero: 'Invernadero AquaSens',
        fila: fila as any,
        columna: columna as any,
        plantId: targetPlant.plantId,
        fecha: todayStr,
        hora: timeStr,
        timestampTexto: `Hoy, ${timeStr}`,
        phSuelo: ph,
        tempInterna: tin,
        tempExterna: tout,
        tempSuelo: tsoil,
        crecimiento: growth,
        faseCrecimiento: targetPlant.latestMetric.faseCrecimiento,
        productividad: prod,
        sanidad: health,
        responsable: respName,
        responsableRol: respRole,
        avatarColor: targetPlant.latestMetric.avatarColor,
        observaciones: obs
      };

      targetPlant.latestMetric = newRecord;
      targetPlant.history.push(newRecord);

      // Actualizar fila de la tabla
      const row = Array.from(document.querySelectorAll<HTMLTableRowElement>('.plant-table-row'))
        .find(r => r.dataset.fila === fila && r.dataset.columna === columna);

      if (row) {
        row.dataset.ph = ph.toString();
        row.dataset.tin = tin.toString();
        row.dataset.tout = tout.toString();
        row.dataset.tsoil = tsoil.toString();
        row.dataset.growth = growth.toString();
        row.dataset.prod = prod;
        row.dataset.health = health;
        row.dataset.resp = respName;
        row.dataset.hora = timeStr;
        row.dataset.fecha = todayStr;
        row.dataset.obs = obs;

        const cells = row.querySelectorAll('td');
        if (cells[2]) cells[2].innerHTML = `<span class="font-semibold text-gray-900 dark:text-white block text-xs">${todayStr}</span><span class="text-[11px] text-gray-500 font-mono">${timeStr}</span>`;
        if (cells[3]) cells[3].innerHTML = `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-xs font-black border bg-emerald-100 text-emerald-800 border-emerald-300"><span>${ph.toFixed(1)}</span><span class="text-[9px] opacity-75">pH</span></span>`;
        if (cells[4]) cells[4].innerHTML = `<span class="px-2 py-0.5 rounded bg-amber-50 font-mono font-bold text-amber-700">${tin.toFixed(1)}°C</span>`;
        if (cells[5]) cells[5].innerHTML = `<span class="px-2 py-0.5 rounded bg-blue-50 font-mono font-bold text-blue-700">${tout.toFixed(1)}°C</span>`;
        if (cells[6]) cells[6].innerHTML = `<span class="px-2 py-0.5 rounded bg-emerald-50 font-mono font-bold text-emerald-700">${tsoil.toFixed(1)}°C</span>`;
        if (cells[7]) cells[7].innerHTML = `<div class="flex items-center justify-between text-xs font-bold text-gray-700 mb-1"><span>${targetPlant.latestMetric.faseCrecimiento}</span><span class="text-emerald-600 font-mono">${growth}%</span></div><div class="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden"><div class="bg-gradient-to-r from-teal-500 to-emerald-500 h-full rounded-full" style="width: ${growth}%"></div></div>`;
      }

      // Reabrir modal de la planta con los datos actualizados
      openPlantModal(fila, columna);
    }

    closeModalForm();
    formNewMetric?.reset();
  });
</script>
