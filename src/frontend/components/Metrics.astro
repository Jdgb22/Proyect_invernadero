  <!-- MODAL: FICHA DE DETALLE -->
  <div id="modal-detail" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 max-w-md w-full p-6">
      <div class="flex justify-between items-start mb-4 pb-3 border-b border-gray-100 dark:border-gray-700">
        <div>
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300">
            Invernadero AquaSens (Único)
          </span>
          <h3 id="detail-pos" class="text-lg font-black text-gray-900 dark:text-white mt-1">Fila t0 • Col 1</h3>
          <p id="detail-date" class="text-xs text-gray-500 dark:text-gray-400">2026-09-03 - 09:30 AM</p>
        </div>
        <button id="btn-close-detail" type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-2xl font-bold p-1 cursor-pointer">&times;</button>
      </div>

      <div class="space-y-3 text-xs">
        <div class="p-2.5 rounded-xl bg-blue-50/70 dark:bg-blue-900/20 flex justify-between items-center">
          <span class="font-bold text-gray-700 dark:text-gray-300">🧪 pH del Suelo</span>
          <span id="detail-ph" class="text-sm font-black text-blue-700 dark:text-blue-300">6.4 pH</span>
        </div>

        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="p-2 rounded-lg bg-amber-50 dark:bg-amber-900/20">
            <span class="text-[10px] text-gray-500 block">T. Interna</span>
            <span id="detail-tin" class="text-xs font-black text-amber-700 dark:text-amber-300">24.5°C</span>
          </div>
          <div class="p-2 rounded-lg bg-blue-50 dark:bg-blue-900/20">
            <span class="text-[10px] text-gray-500 block">T. Externa</span>
            <span id="detail-tout" class="text-xs font-black text-blue-700 dark:text-blue-300">20.1°C</span>
          </div>
          <div class="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-900/20">
            <span class="text-[10px] text-gray-500 block">T. Suelo</span>
            <span id="detail-tsoil" class="text-xs font-black text-emerald-700 dark:text-emerald-300">20.3°C</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40">
            <span class="text-[10px] text-gray-500 block">Crecimiento</span>
            <span id="detail-growth" class="text-sm font-black text-emerald-600 dark:text-emerald-400">85%</span>
          </div>
          <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40">
            <span class="text-[10px] text-gray-500 block">Productividad / Sanidad</span>
            <span id="detail-health" class="text-xs font-bold text-indigo-600 dark:text-indigo-400">Alta • 🟢 Excelente</span>
          </div>
        </div>

        <div class="p-2.5 rounded-xl border border-gray-200 dark:border-gray-700">
          <span class="text-[10px] text-gray-400 font-bold uppercase block">Responsable de Medición</span>
          <span id="detail-resp" class="font-bold text-gray-900 dark:text-white text-xs">Luis Manuel Florez</span>
        </div>

        <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/30">
          <span class="text-[10px] text-gray-400 font-bold block mb-0.5">Notas de Campo</span>
          <p id="detail-obs" class="text-gray-700 dark:text-gray-300 italic text-xs"></p>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- SCRIPT CLIENTE -->
<script>
  // Elementos DOM
  const tableBody = document.getElementById('metrics-table-body');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const filterDate = document.getElementById('filter-date') as HTMLInputElement | null;
  const btnClearDate = document.getElementById('btn-clear-date');
  const filterFila = document.getElementById('filter-fila') as HTMLSelectElement | null;
  const filterHealth = document.getElementById('filter-health') as HTMLSelectElement | null;
  const emptyState = document.getElementById('empty-state');
  const showingCount = document.getElementById('showing-count');
  const totalCount = document.getElementById('total-count');

  // Toggle de Gráficos
  const btnToggleCharts = document.getElementById('btn-toggle-charts');
  const chartsPanel = document.getElementById('analytics-charts-panel');
  const chartsToggleText = document.getElementById('charts-toggle-text');
  let chartsVisible = true;

  btnToggleCharts?.addEventListener('click', () => {
    chartsVisible = !chartsVisible;
    if (chartsPanel) {
      chartsPanel.classList.toggle('hidden', !chartsVisible);
    }
    if (chartsToggleText) {
      chartsToggleText.textContent = chartsVisible ? 'Ocultar Gráficas' : 'Mostrar Gráficas';
    }
  });

  // Filtrado integral (Buscador general, Fecha exacta, Fila y Sanidad)
  function filterTable() {
    if (!tableBody) return;
    const query = searchInput?.value.toLowerCase().trim() || '';
    const dateQuery = filterDate?.value || '';
    const filaQuery = filterFila?.value || 'all';
    const healthQuery = filterHealth?.value || 'all';

    const rows = tableBody.querySelectorAll<HTMLTableRowElement>('.metric-row');
    let visible = 0;

    rows.forEach((row) => {
      const fila = row.dataset.fila?.toLowerCase() || '';
      const columna = row.dataset.columna?.toLowerCase() || '';
      const fecha = row.dataset.fecha || '';
      const resp = row.dataset.resp?.toLowerCase() || '';
      const health = row.dataset.health || '';

      const matchesText = !query || fila.includes(query) || columna.includes(query) || resp.includes(query) || fecha.includes(query);
      const matchesDate = !dateQuery || fecha === dateQuery;
      const matchesFila = filaQuery === 'all' || fila === filaQuery.toLowerCase();
      const matchesHealth = healthQuery === 'all' || health === healthQuery;

      if (matchesText && matchesDate && matchesFila && matchesHealth) {
        row.style.display = '';
        visible++;
      } else {
        row.style.display = 'none';
      }
    });

    if (showingCount) showingCount.textContent = visible.toString();
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', filterTable);
  filterDate?.addEventListener('change', filterTable);
  btnClearDate?.addEventListener('click', () => {
    if (filterDate) filterDate.value = '';
    filterTable();
  });
  filterFila?.addEventListener('change', filterTable);
  filterHealth?.addEventListener('change', filterTable);

  // Inicializar filtro de fecha a hoy si no está seteado
  if (filterDate && !filterDate.value) {
    filterDate.value = new Date().toISOString().slice(0, 10);
  }
  
  // Ejecutar filtro al cargar
  setTimeout(filterTable, 10);

  // Modales
  const modalAdd = document.getElementById('modal-add');
  const btnOpenModal = document.getElementById('btn-open-modal');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const formNewMetric = document.getElementById('form-new-metric') as HTMLFormElement | null;

  btnOpenModal?.addEventListener('click', () => modalAdd?.classList.remove('hidden'));
  const closeModal = () => modalAdd?.classList.add('hidden');
  btnCloseModal?.addEventListener('click', closeModal);
  btnCancelModal?.addEventListener('click', closeModal);

  // Registro de Nueva Medición (Usa sesión activa)
  formNewMetric?.addEventListener('submit', (e) => {
    e.preventDefault();

    const fila = (document.getElementById('input-fila') as HTMLSelectElement).value;
    const columna = (document.getElementById('input-columna') as HTMLSelectElement).value;
    const ph = parseFloat((document.getElementById('input-ph') as HTMLInputElement).value);
    const tin = parseFloat((document.getElementById('input-tin') as HTMLInputElement).value);
    const tout = parseFloat((document.getElementById('input-tout') as HTMLInputElement).value);
    const tsoil = parseFloat((document.getElementById('input-tsoil') as HTMLInputElement).value);
    const growth = parseInt((document.getElementById('input-growth') as HTMLInputElement).value, 10);
    const prod = (document.getElementById('input-prod') as HTMLSelectElement).value;
    const health = (document.getElementById('input-health') as HTMLSelectElement).value;
    const obs = (document.getElementById('input-obs') as HTMLTextAreaElement).value || 'Registro recién ingresado.';

    // Responsable detectado por sesión
    const respName = document.getElementById('session-user-name')?.textContent?.trim() || "Usuario Activo";
    const respRole = document.getElementById('session-user-role')?.textContent?.trim() || "Personal de Campo";

    const todayStr = new Date().toISOString().slice(0, 10);
    const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });

    // Determinar estilo de pH
    let phClass = "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300";
    if (ph < 6.0 || ph > 6.8) {
      phClass = (ph >= 5.5 && ph <= 7.2) 
        ? "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300"
        : "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300";
    }

    const prodClass = prod === 'Alta' 
      ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300"
      : prod === 'Media'
        ? "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300"
        : "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300";

    const healthIcon = (health === 'Excelente' || health === 'Saludable') ? '🟢' : health === 'Vulnerable' ? '🟡' : '🔴';
    const healthClass = (health === 'Excelente' || health === 'Saludable')
      ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border-emerald-200"
      : health === 'Vulnerable'
        ? "bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border-amber-200"
        : "bg-rose-50 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 border-rose-200";

    const newTr = document.createElement('tr');
    newTr.className = "hover:bg-indigo-50/50 dark:hover:bg-indigo-950/20 transition-colors metric-row cursor-pointer";
    newTr.dataset.id = `MET-${Date.now()}`;
    newTr.dataset.fila = fila;
    newTr.dataset.columna = columna;
    newTr.dataset.fecha = todayStr;
    newTr.dataset.hora = timeStr;
    newTr.dataset.timestamp = `Hoy, ${timeStr}`;
    newTr.dataset.ph = ph.toString();
    newTr.dataset.tin = tin.toString();
    newTr.dataset.tout = tout.toString();
    newTr.dataset.tsoil = tsoil.toString();
    newTr.dataset.growth = growth.toString();
    newTr.dataset.fase = "En seguimiento";
    newTr.dataset.prod = prod;
    newTr.dataset.health = health;
    newTr.dataset.resp = respName;
    newTr.dataset.rol = respRole;
    newTr.dataset.obs = obs;

    newTr.innerHTML = `
      <td class="py-3 px-2 text-center font-mono text-xs text-emerald-600 font-bold bg-emerald-50/50 dark:bg-emerald-950/30 border-r border-gray-300 dark:border-gray-600 select-none">
        NUEVO
      </td>
      <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700">
        <div class="flex items-center gap-2">
          <span class="px-2 py-1 rounded bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300 font-mono font-black text-xs">
            ${fila}
          </span>
          <span class="font-bold text-gray-900 dark:text-white font-mono text-xs">
            ${columna}
          </span>
        </div>
      </td>
      <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700">
        <span class="font-semibold text-gray-900 dark:text-white block text-xs">${todayStr}</span>
        <span class="text-[11px] text-gray-500 dark:text-gray-400">${timeStr}</span>
      </td>
      <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-xs font-black border ${phClass}">
          <span>${ph.toFixed(1)}</span>
          <span class="text-[9px] opacity-75">pH</span>
        </span>
      </td>
      <td class="py-3 px-3 text-center font-bold text-amber-700 dark:text-amber-300 border-r border-gray-200 dark:border-gray-700">
        <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-900/20 font-mono">${tin.toFixed(1)}°C</span>
      </td>
      <td class="py-3 px-3 text-center text-blue-700 dark:text-blue-300 border-r border-gray-200 dark:border-gray-700">
        <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900/20 font-mono text-xs font-bold">${tout.toFixed(1)}°C</span>
      </td>
      <td class="py-3 px-3 text-center text-emerald-700 dark:text-emerald-300 border-r border-gray-200 dark:border-gray-700">
        <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-900/20 font-mono text-xs font-bold">${tsoil.toFixed(1)}°C</span>
      </td>
      <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700 min-w-[140px]">
        <div class="flex items-center justify-between text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">
          <span class="text-[11px]">En seguimiento</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-mono">${growth}%</span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 h-1.5 rounded-full overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-emerald-500 h-full rounded-full" style="width: ${growth}%"></div>
        </div>
      </td>
      <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-extrabold border ${prodClass}">${prod}</span>
      </td>
      <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border ${healthClass}">
          <span>${healthIcon}</span>
          <span>${health}</span>
        </span>
      </td>
      <td class="py-3 px-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-indigo-600 text-white font-black text-[11px] flex items-center justify-center flex-shrink-0">
            ${respName.split(" ").map((n: string) => n[0]).slice(0, 2).join("").toUpperCase()}
          </div>
          <div>
            <span class="font-bold text-gray-900 dark:text-white text-xs block">${respName}</span>
            <span class="text-[10px] text-gray-500 dark:text-gray-400 block font-normal">${respRole}</span>
          </div>
        </div>
      </td>
    `;

    tableBody?.prepend(newTr);

    if (totalCount && showingCount) {
      const c = parseInt(totalCount.textContent || '0', 10) + 1;
      totalCount.textContent = c.toString();
      showingCount.textContent = c.toString();
    }

    bindClicks();
    closeModal();
    formNewMetric?.reset();
  });

  // Modal detalle
  const modalDetail = document.getElementById('modal-detail');
  const btnCloseDetail = document.getElementById('btn-close-detail');
  btnCloseDetail?.addEventListener('click', () => modalDetail?.classList.add('hidden'));

  function bindClicks() {
    const rows = document.querySelectorAll<HTMLTableRowElement>('.metric-row');
    rows.forEach((r) => {
      r.onclick = () => {
        const d = r.dataset;
        const pos = document.getElementById('detail-pos');
        const date = document.getElementById('detail-date');
        const ph = document.getElementById('detail-ph');
        const tin = document.getElementById('detail-tin');
        const tout = document.getElementById('detail-tout');
        const tsoil = document.getElementById('detail-tsoil');
        const growth = document.getElementById('detail-growth');
        const health = document.getElementById('detail-health');
        const resp = document.getElementById('detail-resp');
        const obs = document.getElementById('detail-obs');

        if (pos) pos.textContent = `Fila ${d.fila} • ${d.columna}`;
        if (date) date.textContent = `${d.fecha} — ${d.hora}`;
        if (ph) ph.textContent = `${parseFloat(d.ph || '0').toFixed(1)} pH`;
        if (tin) tin.textContent = `${parseFloat(d.tin || '0').toFixed(1)}°C`;
        if (tout) tout.textContent = `${parseFloat(d.tout || '0').toFixed(1)}°C`;
        if (tsoil) tsoil.textContent = `${parseFloat(d.tsoil || '0').toFixed(1)}°C`;
        if (growth) growth.textContent = `${d.growth}%`;
        if (health) health.textContent = `${d.prod} • ${d.health}`;
        if (resp) resp.textContent = `${d.resp} (${d.rol || 'Personal'})`;
        if (obs) obs.textContent = d.obs || 'Sin observaciones registradas.';

        modalDetail?.classList.remove('hidden');
      };
    });
  }
  bindClicks();

  // Exportar Excel CSV
  document.getElementById('btn-export-csv')?.addEventListener('click', () => {
    const rows = document.querySelectorAll<HTMLTableRowElement>('.metric-row');
    let csv = "Invernadero,Fila,Columna,Fecha,Hora,pHSuelo,TempInterna,TempExterna,TempSuelo,Crecimiento,Productividad,Sanidad,Responsable,Observaciones\n";
    rows.forEach((r) => {
      if (r.style.display !== 'none') {
        const d = r.dataset;
        csv += `"Invernadero AquaSens","${d.fila}","${d.columna}","${d.fecha}","${d.hora}",${d.ph},${d.tin},${d.tout},${d.tsoil},${d.growth}%,"${d.prod}","${d.health}","${d.resp}","${d.obs}"\n`;
      }
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `AquaSens_Metricas_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
