---
// src/frontend/components/Metrics.astro
// Panel Profesional de Métricas Agronómicas para Invernadero AquaSens (Invernadero Único).
// Incluye gráficos individuales por métrica, tabla estructurada estilo Excel por Filas (t0, t1...) y Columnas (Col 1, Col 2...),
// filtro por fecha y asignación automática del responsable según la sesión autenticada.

import { getAllMetrics, type MetricRecord } from "../../backend/services/metricsData";

interface Props {
  currentUserName?: string;
  currentUserRole?: string;
}

const { currentUserName = "Administrador", currentUserRole = "Líder de Cultivo" } = Astro.props;

// Filtrar 't4' ya que la matriz ahora es máximo de t0 a t3
const metrics: MetricRecord[] = getAllMetrics().filter(m => m.fila !== 't4');

// Helpers para badges y semáforos
function getPhBadge(ph: number) {
  if (ph >= 6.0 && ph <= 6.8) {
    return { label: "Óptimo", class: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300" };
  }
  if (ph >= 5.5 && ph <= 7.2) {
    return { label: "Atención", class: "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300" };
  }
  return { label: "Crítico", class: "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300" };
}

function getProdBadge(prod: string) {
  if (prod === 'Alta') return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border-emerald-300";
  if (prod === 'Media') return "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 border-amber-300";
  return "bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300 border-rose-300";
}

function getHealthBadge(sanidad: string) {
  if (sanidad === 'Excelente' || sanidad === 'Saludable') {
    return { icon: '🟢', class: "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800" };
  }
  if (sanidad === 'Vulnerable') {
    return { icon: '🟡', class: "bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border-amber-200 dark:border-amber-800" };
  }
  return { icon: '🔴', class: "bg-rose-50 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 border-rose-200 dark:border-rose-800" };
}
---

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10">
  
  <!-- Encabezado Profesional -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="flex items-center gap-3.5">
      <div class="p-3 bg-gradient-to-br from-indigo-600 to-emerald-600 text-white rounded-2xl shadow-md">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-black text-gray-900 dark:text-white tracking-tight">
            Panel de Métricas y Analítica Agronómica
          </h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300 border border-emerald-300">
            Invernadero AquaSens (Único)
          </span>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
          Sesión activa: <strong class="text-gray-800 dark:text-gray-200 font-semibold">{currentUserName}</strong> ({currentUserRole})
        </p>
      </div>
    </div>

    <!-- Botones Superiores -->
    <div class="flex flex-wrap items-center gap-2.5">
      <button
        id="btn-toggle-charts"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 border border-indigo-200 dark:border-indigo-800 transition-all cursor-pointer"
      >
        <span id="charts-toggle-icon">📊</span>
        <span id="charts-toggle-text">Ocultar Gráficas</span>
      </button>

      <button
        id="btn-open-modal"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 shadow-md shadow-emerald-600/20 hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 cursor-pointer transform hover:-translate-y-0.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Nueva Medición</span>
      </button>

      <button
        id="btn-export-csv"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-gray-700 dark:text-gray-200 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 transition-all cursor-pointer"
        title="Descargar en formato CSV compatible con Excel"
      >
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Exportar Excel</span>
      </button>
    </div>
  </div>

  <!-- BARRA DE BÚSQUEDA Y FILTROS (INCLUYE BÚSQUEDA POR FECHA EXACTA) -->
  <div class="bg-white dark:bg-gray-800 p-4 sm:p-5 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm mb-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    
    <!-- Filtros de búsqueda combinada -->
    <div class="flex flex-wrap items-center gap-3 flex-1">
      
      <!-- Buscador por texto (Fila, Columna, Responsable, etc.) -->
      <div class="relative flex-1 min-w-[240px]">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="search-input"
          type="text"
          placeholder="Buscar fila (ej: t0, t1), columna, responsable..."
          class="w-full pl-9 pr-3 py-2 text-xs sm:text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <!-- Búsqueda específica por FECHA -->
      <div class="flex items-center gap-2">
        <label for="filter-date" class="text-xs font-bold text-gray-600 dark:text-gray-300 flex items-center gap-1">
          <span>📅</span> Fecha:
        </label>
        <input
          id="filter-date"
          type="date"
          class="py-2 px-3 text-xs sm:text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
          title="Filtrar por fecha específica"
        />
        <button
          id="btn-clear-date"
          type="button"
          class="p-2 text-xs font-bold text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer"
          title="Limpiar filtro de fecha"
        >
          ✕
        </button>
      </div>

      <!-- Filtro Fila -->
      <div class="flex items-center gap-1.5">
        <label for="filter-fila" class="text-xs font-bold text-gray-600 dark:text-gray-300">Fila:</label>
        <select
          id="filter-fila"
          class="py-2 px-2.5 text-xs sm:text-sm font-semibold rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <option value="all">Todas</option>
          <option value="t0">Fila t0</option>
          <option value="t1">Fila t1</option>
          <option value="t2">Fila t2</option>
          <option value="t3">Fila t3</option>
        </select>
      </div>

      <!-- Filtro Sanidad -->
      <div class="flex items-center gap-1.5">
        <label for="filter-health" class="text-xs font-bold text-gray-600 dark:text-gray-300">Sanidad:</label>
        <select
          id="filter-health"
          class="py-2 px-2.5 text-xs sm:text-sm font-semibold rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <option value="all">Todas</option>
          <option value="Excelente">Excelente</option>
          <option value="Saludable">Saludable</option>
          <option value="Vulnerable">Vulnerable</option>
          <option value="Crítica">Crítica</option>
        </select>
      </div>
    </div>
  </div>

  <!-- TABLA AGRONÓMICA TIPO EXCEL (FILAS t0, t1... Y COLUMNAS Col 1, Col 2...) -->
  <div class="bg-gray-50 dark:bg-gray-800 rounded-2xl border-2 border-gray-300 dark:border-gray-700 shadow-sm overflow-hidden">
    
    <!-- Barra superior de la hoja de cálculo -->
    <div class="px-4 py-2 bg-gray-100 dark:bg-gray-800/80 border-b border-gray-300 dark:border-gray-700 flex items-center justify-between text-xs font-mono text-gray-600 dark:text-gray-300">
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded bg-emerald-600 text-white font-bold text-[10px]">EXCEL GRID</span>
        <span class="font-bold">Invernadero_AquaSens_Registro.xlsx</span>
      </div>
      <div class="flex items-center gap-3 text-[11px]">
        <span>Filas: <strong>t0 — t3</strong></span>
        <span>•</span>
        <span>Columnas: <strong>Col 1 — Col 5</strong></span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[1050px]">
        <thead>
          <!-- Fila de Encabezados con Letras de Columna tipo Excel (A, B, C...) -->
          <tr class="bg-gray-200/80 dark:bg-gray-700 text-gray-500 dark:text-gray-400 font-mono text-[10px] text-center select-none border-b border-gray-300 dark:border-gray-600">
            <th class="w-10 py-1 border-r border-gray-300 dark:border-gray-600">#</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">A</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">B</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">C</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">D</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">E</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">F</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">G</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">H</th>
            <th class="py-1 border-r border-gray-300 dark:border-gray-600">I</th>
            <th class="py-1">J</th>
          </tr>

          <!-- Encabezados Reales con separación y estilo Excel -->
          <tr class="bg-gray-100 dark:bg-gray-800/80 border-b-2 border-gray-300 dark:border-gray-600 text-xs font-black uppercase text-gray-700 dark:text-gray-200 select-none">
            <th class="py-3 px-2 text-center border-r border-gray-300 dark:border-gray-600 bg-gray-200/60 dark:bg-gray-700/60 w-10">
              N°
            </th>
            <th class="py-3 px-4 border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1.5">📍 Ubicación (Fila / Col)</span>
            </th>
            <th class="py-3 px-4 border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1.5">📅 Fecha & Hora</span>
            </th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1">🧪 pH Suelo</span>
            </th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1">🌡️ T. Interna</span>
            </th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1">☀️ T. Externa</span>
            </th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1">🌱 T. Suelo</span>
            </th>
            <th class="py-3 px-4 border-r border-gray-300 dark:border-gray-600">
              <span class="inline-flex items-center gap-1">📈 Crecimiento</span>
            </th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">Productividad</th>
            <th class="py-3 px-3 text-center border-r border-gray-300 dark:border-gray-600">Sanidad</th>
            <th class="py-3 px-4">Responsable (Toma)</th>
          </tr>
        </thead>
        <tbody id="metrics-table-body" class="divide-y divide-gray-200 dark:divide-gray-700 text-xs sm:text-sm font-medium">
          {metrics.map((row, idx) => {
            const ph = getPhBadge(row.phSuelo);
            const prodClass = getProdBadge(row.productividad);
            const health = getHealthBadge(row.sanidad);

            return (
              <tr 
                class="hover:bg-indigo-50/50 dark:hover:bg-indigo-950/20 transition-colors metric-row cursor-pointer"
                data-id={row.id}
                data-fila={row.fila}
                data-columna={row.columna}
                data-fecha={row.fecha}
                data-hora={row.hora}
                data-timestamp={row.timestampTexto}
                data-ph={row.phSuelo}
                data-tin={row.tempInterna}
                data-tout={row.tempExterna}
                data-tsoil={row.tempSuelo}
                data-growth={row.crecimiento}
                data-fase={row.faseCrecimiento}
                data-prod={row.productividad}
                data-health={row.sanidad}
                data-resp={row.responsable}
                data-rol={row.responsableRol}
                data-obs={row.observaciones}
              >
                <!-- Índice de fila estilo Excel -->
                <td class="py-3 px-2 text-center font-mono text-xs text-gray-400 bg-gray-50/80 dark:bg-gray-800/80 border-r border-gray-300 dark:border-gray-600 select-none">
                  {idx + 1}
                </td>

                <!-- Columna A: Fila y Columna -->
                <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300 font-mono font-black text-xs">
                      {row.fila}
                    </span>
                    <span class="font-bold text-gray-900 dark:text-white font-mono text-xs">
                      {row.columna}
                    </span>
                  </div>
                </td>

                <!-- Columna B: Fecha y Hora -->
                <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700">
                  <span class="font-semibold text-gray-900 dark:text-white block text-xs">
                    {row.fecha}
                  </span>
                  <span class="text-[11px] text-gray-500 dark:text-gray-400">
                    {row.hora}
                  </span>
                </td>

                <!-- Columna C: pH Suelo -->
                <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
                  <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-xs font-black border ${ph.class}`}>
                    <span>{row.phSuelo.toFixed(1)}</span>
                    <span class="text-[9px] opacity-75">pH</span>
                  </span>
                </td>

                <!-- Columna D: Temp Interna -->
                <td class="py-3 px-3 text-center font-bold text-amber-700 dark:text-amber-300 border-r border-gray-200 dark:border-gray-700">
                  <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-900/20 font-mono">
                    {row.tempInterna.toFixed(1)}°C
                  </span>
                </td>

                <!-- Columna E: Temp Externa -->
                <td class="py-3 px-3 text-center text-blue-700 dark:text-blue-300 border-r border-gray-200 dark:border-gray-700">
                  <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900/20 font-mono text-xs font-bold">
                    {row.tempExterna.toFixed(1)}°C
                  </span>
                </td>

                <!-- Columna F: Temp Suelo -->
                <td class="py-3 px-3 text-center text-emerald-700 dark:text-emerald-300 border-r border-gray-200 dark:border-gray-700">
                  <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-900/20 font-mono text-xs font-bold">
                    {row.tempSuelo.toFixed(1)}°C
                  </span>
                </td>

                <!-- Columna G: Crecimiento -->
                <td class="py-3 px-4 border-r border-gray-200 dark:border-gray-700 min-w-[140px]">
                  <div class="flex items-center justify-between text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">
                    <span class="text-[11px] truncate max-w-[90px]">{row.faseCrecimiento}</span>
                    <span class="text-emerald-600 dark:text-emerald-400 font-mono">{row.crecimiento}%</span>
                  </div>
                  <div class="w-full bg-gray-200 dark:bg-gray-700 h-1.5 rounded-full overflow-hidden">
                    <div 
                      class="bg-gradient-to-r from-teal-500 to-emerald-500 h-full rounded-full" 
                      style={`width: ${row.crecimiento}%`}
                    ></div>
                  </div>
                </td>

                <!-- Columna H: Productividad -->
                <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-extrabold border ${prodClass}`}>
                    {row.productividad}
                  </span>
                </td>

                <!-- Columna I: Sanidad -->
                <td class="py-3 px-3 text-center border-r border-gray-200 dark:border-gray-700">
                  <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border ${health.class}`}>
                    <span>{health.icon}</span>
                    <span>{row.sanidad}</span>
                  </span>
                </td>

                <!-- Columna J: Responsable -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2">
                    <div class={`w-7 h-7 rounded-full ${row.avatarColor} text-white font-black text-[11px] flex items-center justify-center flex-shrink-0`}>
                      {row.responsable.split(" ").map(n => n[0]).slice(0, 2).join("")}
                    </div>
                    <div>
                      <span class="font-bold text-gray-900 dark:text-white text-xs block">
                        {row.responsable}
                      </span>
                      <span class="text-[10px] text-gray-500 dark:text-gray-400 block font-normal">
                        {row.responsableRol}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Estado vacío de búsqueda -->
    <div id="empty-state" class="hidden p-10 text-center">
      <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-gray-100 dark:bg-gray-700 text-gray-400 flex items-center justify-center text-2xl">
        🔍
      </div>
      <h3 class="text-sm font-bold text-gray-900 dark:text-white">Sin coincidencias para la fecha o búsqueda</h3>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Prueba con otra fecha o haz clic en "✕" para ver todos los registros.</p>
    </div>

    <!-- Pie de tabla estilo Excel -->
    <div class="px-4 py-2.5 bg-gray-100 dark:bg-gray-800/80 border-t border-gray-300 dark:border-gray-700 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400 font-mono">
      <div class="flex items-center gap-2">
        <span>Mostrando</span>
        <span id="showing-count" class="font-bold text-gray-900 dark:text-white">{metrics.length}</span>
        <span>de</span>
        <span id="total-count" class="font-bold text-gray-900 dark:text-white">{metrics.length}</span>
        <span>filas</span>
      </div>
      <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-[11px]">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Invernadero AquaSens Activo</span>
      </div>
    </div>
  </div>

  <!-- SECCIÓN PROFESIONAL: GRÁFICOS Y GRAFOS DEDICADOS POR MÉTRICA -->
  <div id="analytics-charts-panel" class="transition-all duration-300 mb-8 space-y-6">
    
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-black text-gray-900 dark:text-white flex items-center gap-2">
        <span>📈</span> Gráficos de Comportamiento por Métrica
      </h2>
      <span class="text-xs text-gray-500 dark:text-gray-400">
        Tendencias temporales y espaciales del Invernadero
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- GRÁFICO 1: pH del Suelo -->
      <div class="bg-white dark:bg-gray-800 p-5 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 text-lg">🧪</span>
            <div>
              <h3 class="font-extrabold text-gray-900 dark:text-white text-sm">pH del Suelo</h3>
