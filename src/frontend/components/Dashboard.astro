---
// Dashboard.astro
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-6 mb-8 border border-gray-100 dark:border-gray-700">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Dashboard</h2>
    <p class="text-gray-600 dark:text-gray-300 mb-6">Simulación del invernadero y la posición del sol.</p>
    
    <!-- Contenedor para Three.js -->
    <div id="three-container" class="w-full h-96 bg-gray-900 rounded-xl overflow-hidden shadow-inner relative">
       <div id="time-display" class="absolute top-4 left-4 bg-black/50 text-white px-3 py-1 rounded-lg backdrop-blur-sm font-mono text-sm z-10">
         Hora: --:--
       </div>

       <!-- Widget del Clima (Glassmorphism) -->
       <div id="weather-widget" class="absolute top-4 right-4 bg-white/30 dark:bg-black/40 backdrop-blur-md text-gray-900 dark:text-white p-4 rounded-xl shadow-lg border border-white/40 dark:border-gray-600/50 flex flex-col gap-1 z-10 min-w-[160px] transition-all duration-300">
         <div class="flex items-center justify-between mb-1">
           <span id="weather-title" class="text-[10px] font-bold uppercase tracking-widest opacity-80">Clima Local</span>
           <span id="weather-icon" class="text-xl">☀️</span>
         </div>
         <div class="flex items-end gap-1">
           <span id="weather-temp" class="text-4xl font-extrabold tracking-tighter">--</span>
           <span class="text-lg font-medium mb-1">°C</span>
         </div>
         <div class="flex justify-between text-xs font-semibold opacity-90 mt-2 gap-2">
           <span id="weather-humidity" class="bg-blue-100/50 dark:bg-blue-900/50 px-2 py-1 rounded-md flex-1 text-center">💧 --%</span>
           <span id="weather-rain" class="bg-indigo-100/50 dark:bg-indigo-900/50 px-2 py-1 rounded-md flex-1 text-center">🌧️ --%</span>
         </div>
         <div class="flex justify-center text-xs font-semibold opacity-90 mt-2">
           <span id="weather-irradiation" class="bg-yellow-100/50 dark:bg-yellow-900/50 px-2 py-1 rounded-md w-full text-center">☀️ -- W/m²</span>
         </div>
       </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { fetchWeatherData, getWeatherEmoji } from '../../backend/services/weather';

  // --- CONFIGURACIÓN INICIAL ---
  const container = document.getElementById('three-container');
  const timeDisplay = document.getElementById('time-display');

  if (container) {
    // --- ESCENA BÁSICA ---
    const scene = new THREE.Scene();
    
    // Configurar cámara según el tamaño del contenedor
    const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(0, 5, 20);

    // Configurar el renderer
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    // Ajustar el canvas si la ventana cambia de tamaño
    window.addEventListener('resize', () => {
      if (container) {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
    });

    // Añadir un suelo simple (para notar mejor las sombras/iluminación)
    const groundGeometry = new THREE.PlaneGeometry(50, 50);
    const groundMaterial = new THREE.MeshStandardMaterial({ color: 0x2e8b57, roughness: 0.8 }); // Verde para simular pasto
    const ground = new THREE.Mesh(groundGeometry, groundMaterial);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // Añadir un modelo básico del "invernadero" en el centro
    const greenhouseGeometry = new THREE.BoxGeometry(10, 5, 6);
    const greenhouseMaterial = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, transparent: true, opacity: 0.5 });
    const greenhouse = new THREE.Mesh(greenhouseGeometry, greenhouseMaterial);
    greenhouse.position.y = 2.5; // Elevarlo para que quede sobre el suelo
    greenhouse.castShadow = true;
    greenhouse.receiveShadow = true;
    scene.add(greenhouse);

    // Luz ambiental suave para que las partes oscuras no sean completamente negras
    const ambientLight = new THREE.AmbientLight(0x404040, 0.5); 
    scene.add(ambientLight);

    // --- 1. LUZ DEL SOL ---
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.castShadow = true; 
    
    // Mejorar la calidad de las sombras
    dirLight.shadow.mapSize.width = 1024;
    dirLight.shadow.mapSize.height = 1024;
    dirLight.shadow.camera.near = 0.5;
    dirLight.shadow.camera.far = 150;
    dirLight.shadow.camera.left = -20;
    dirLight.shadow.camera.right = 20;
    dirLight.shadow.camera.top = 20;
    dirLight.shadow.camera.bottom = -20;
    scene.add(dirLight);

    // --- 2. SOL VISUAL ---
    const sunGeometry = new THREE.SphereGeometry(2, 32, 32); 
    const sunMaterial = new THREE.MeshBasicMaterial({ 
        color: 0xfffca3, 
    });
    const sunMesh = new THREE.Mesh(sunGeometry, sunMaterial);
    scene.add(sunMesh);

    // --- 3. LUNA VISUAL ---
    const moonGeometry = new THREE.SphereGeometry(1.5, 32, 32);
    const moonMaterial = new THREE.MeshBasicMaterial({ color: 0xe0e0e0 });
    const moonMesh = new THREE.Mesh(moonGeometry, moonMaterial);
    scene.add(moonMesh);

    // --- FUNCIÓN DE CÁLCULO DE POSICIÓN ---
    function updateSun(hour: number) {
      // Actualizar el display de tiempo
      if (timeDisplay) {
         const hh = Math.floor(hour).toString().padStart(2, '0');
         const mm = Math.floor((hour % 1) * 60).toString().padStart(2, '0');
         timeDisplay.textContent = `Hora: ${hh}:${mm}`;
      }

      const distanceX = 22; // Distancia horizontal (este a oeste)
      const distanceY = 16; // Altura máxima en el cielo (cenit)
      const z = -15; // Ligeramente por detrás

      // Entre las 6:00 y las 18:00 (Día)
      if (hour >= 6 && hour <= 18) {
        moonMesh.visible = false;
        sunMesh.visible = true; 
        
        const progress = (hour - 6) / 12; // 0 (6am) a 1 (6pm)
        const angle = progress * Math.PI; 
        
        const x = Math.cos(angle) * distanceX; 
        const y = Math.sin(angle) * distanceY;  
        
        dirLight.position.set(x, y, z);
        sunMesh.position.set(x, y, z);
        
        const heightFactor = Math.sin(angle); 
        dirLight.intensity = Math.max(0.1, heightFactor * 2); 
        dirLight.color.setHex(0xffffff);
        
        let skyColor = new THREE.Color();
        if (progress < 0.2 || progress > 0.8) {
           skyColor.setHex(0xff7b54); 
           sunMaterial.color.setHex(0xff4500); 
        } else {
           skyColor.setHex(0x87ceeb); 
           sunMaterial.color.setHex(0xfffca3); 
        }
        scene.background = skyColor;
      } else {
        // Noche (Luna)
        sunMesh.visible = false;
        moonMesh.visible = true;
        scene.background = new THREE.Color(0x0a0a2a); 

        // Progreso de la noche: 18:00 (0) -> 6:00 (1)
        const nightHour = hour > 18 ? hour - 18 : hour + 6;
        const progress = nightHour / 12;
        const angle = progress * Math.PI;

        const x = Math.cos(angle) * distanceX; 
        const y = Math.sin(angle) * distanceY;  
        
        dirLight.position.set(x, y, z);
        moonMesh.position.set(x, y, z);
        
        // Luz de luna más suave y azulada
        dirLight.intensity = 0.3;
        dirLight.color.setHex(0xaaccff);
      }
    }

    // --- BUCLE DE ANIMACIÓN ---
    function animate() {
      requestAnimationFrame(animate);
      
      // Obtener la hora real actual
      const now = new Date();
      const currentHour = now.getHours() + (now.getMinutes() / 60) + (now.getSeconds() / 3600);
      
      updateSun(currentHour);
      
      renderer.render(scene, camera);
    }
    
    // Activar sombras en el renderer
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    // --- 3. DATOS DEL CLIMA (Predicción para el Invernadero) ---
    async function fetchWeather(lat: number, lon: number, isFallback = false) {
      try {
        const tempEl = document.getElementById('weather-temp');
        const humEl = document.getElementById('weather-humidity');
        const rainEl = document.getElementById('weather-rain');
        const irrEl = document.getElementById('weather-irradiation');
        const iconEl = document.getElementById('weather-icon');
        const titleEl = document.getElementById('weather-title');
        
        const data = await fetchWeatherData(lat, lon, isFallback);
        
        if (tempEl) tempEl.textContent = Math.round(data.temperature).toString();
        if (humEl) humEl.textContent = `💧 ${data.humidity}%`;
        if (rainEl) rainEl.textContent = `🌧️ ${data.rainProbability}%`;
        if (irrEl) irrEl.textContent = `☀️ ${data.irradiation} W/m²`;
        if (titleEl) {
           titleEl.textContent = data.isFallback ? "Clima (Medellín)" : "Clima (Tu ubicación)";
        }
        if (iconEl) {
          iconEl.textContent = getWeatherEmoji(data.weatherCode);
        }
      } catch (e) {
        console.error("Error cargando el clima:", e);
      }
    }

    function initWeather() {
      // Intentar obtener la ubicación del dispositivo
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            fetchWeather(lat, lon, false);
            // Configurar actualización automática cada 10 min
            setInterval(() => fetchWeather(lat, lon, false), 600000);
          },
          (error) => {
            console.warn("Geolocalización denegada o fallida, usando Medellín por defecto.", error);
            // Coordenadas por defecto (Medellín)
            const fallbackLat = 6.2442;
            const fallbackLon = -75.5812;
            fetchWeather(fallbackLat, fallbackLon, true);
            setInterval(() => fetchWeather(fallbackLat, fallbackLon, true), 600000);
          },
          { timeout: 10000 }
        );
      } else {
        // Navegador no soporta geolocalización
        const fallbackLat = 6.2442;
        const fallbackLon = -75.5812;
        fetchWeather(fallbackLat, fallbackLon, true);
        setInterval(() => fetchWeather(fallbackLat, fallbackLon, true), 600000);
      }
    }
    
    initWeather();

    animate(); 
  }
</script>