---
// Dashboard.astro
import { getAllPlantsGrid, type PlantMatrixItem } from "../../backend/services/metricsData";
const plants: PlantMatrixItem[] = getAllPlantsGrid();
---

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 overflow-hidden">
  <div class="bg-[#f4fce3] dark:bg-stone-800 rounded-2xl shadow-sm p-4 sm:p-6 border border-green-100 dark:border-[#166534]">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h2 class="text-2xl font-bold text-green-950 dark:text-white mb-1">Dashboard Principal</h2>
        <p class="text-green-700 dark:text-stone-300 text-sm">Monitoreo de cultivos reales y simulación ambiental del invernadero.</p>
      </div>
      <div id="dashboard-sync-indicator" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-stone-100 dark:bg-stone-900/60 text-stone-700 dark:text-stone-300 border border-stone-300 dark:border-stone-700">
        <span class="w-2 h-2 rounded-full bg-stone-400"></span>
        <span id="dashboard-sync-text">Esperando sincronización de datos reales</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 items-start">
      <!-- Matriz de Plantas (4x5 = 20 Plantas) -->
      <div class="flex flex-col">
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
    >
      <h2
        class="text-xl font-bold text-green-950 dark:text-white flex items-center gap-2"
      >
        <span>🌱</span> Estado de los Cultivos (4 Filas × 5 Plantas)
      </h2>
      <div
        class="flex flex-wrap gap-3 sm:gap-4 text-xs font-semibold text-green-700 dark:text-stone-300 mt-2 sm:mt-0"
      >
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-lime-500 shadow-sm"></span> Óptimo
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-yellow-400 shadow-sm"></span> Atención
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-rose-500 shadow-sm"></span> Crítico
        </div>
      </div>
    </div>

    <div id="dashboard-plant-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3">
      {
        plants.map((p) => {
          const m = p.latestMetric;
          const hasData = Boolean(m.fecha);
          const isCritical = hasData && m.sanidad === "Crítica";
          const isWarning = hasData && m.sanidad === "Vulnerable";
          const statusColor = !hasData
            ? "bg-stone-50/50 dark:bg-stone-900/30 border-stone-200 dark:border-stone-800"
            : isCritical
              ? "bg-rose-50 dark:bg-rose-900/20 border-rose-200 dark:border-rose-800/50"
              : isWarning
                ? "bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-800/50"
                : "bg-lime-50 dark:bg-lime-900/10 border-lime-200 dark:border-lime-800/30";

          const iconBg = !hasData
            ? "bg-stone-400"
            : isCritical
              ? "bg-rose-500"
              : isWarning
                ? "bg-yellow-400"
                : "bg-lime-500";

          const humedad = !hasData ? "--" : (isCritical ? "35%" : isWarning ? "48%" : "65%");
          const temp = !hasData ? "N/D" : (m.tempInterna !== null && m.tempInterna !== undefined ? `${m.tempInterna}°C` : "N/D");
          const plantIcon = !hasData ? "🌱" : (isCritical ? "🥀" : isWarning ? "🌿" : "🪴");
          const plantStatus = !hasData ? 'Esperando datos' : (isCritical ? 'Crítico' : isWarning ? 'Atención' : 'Óptimo');
          const ph = !hasData ? "--" : m.phSuelo.toFixed(1);
          const tsoil = !hasData ? "--" : (m.tempSuelo !== null && m.tempSuelo !== undefined ? `${Number(m.tempSuelo).toFixed(1)}°C` : "N/D");
          const growth = !hasData ? "--" : (m.alturaCm !== null && m.alturaCm !== undefined ? `${m.alturaCm} cm` : `${m.crecimiento}%`);

          return (
            <div
              class={`plant-card relative group overflow-hidden rounded-xl border p-2.5 transition-all hover:-translate-y-1 hover:shadow-md cursor-pointer ${statusColor}`}
              data-id={p.code}
              data-plantid={p.plantId}
              data-fila={p.fila}
              data-columna={p.columna}
              data-icon={plantIcon}
              data-status={plantStatus}
              data-statuscolor={!hasData ? 'text-stone-500 dark:text-stone-400' : isCritical ? 'text-rose-600 dark:text-rose-400' : isWarning ? 'text-yellow-600 dark:text-yellow-400' : 'text-lime-600 dark:text-lime-400'}
              data-ph={ph}
              data-tsoil={tsoil}
              data-tair={temp}
              data-growth={growth}
              data-prod={hasData ? m.productividad : 'Sin datos'}
              data-health={hasData ? m.sanidad : 'Sin datos'}
            >
              <div class="flex justify-between items-start mb-1.5">
                <div class="flex items-center gap-1">
                  <span class="text-[10px] font-black uppercase tracking-wider text-green-700 dark:text-stone-300 font-mono">
                    {p.code}
                  </span>
                  <span class="text-[8px] text-green-500 dark:text-stone-400 font-mono">
                    ({p.plantId})
                  </span>
                </div>
                <span class={`plant-dot w-1.5 h-1.5 rounded-full ${iconBg} shadow-sm`} />
              </div>
              <div class="plant-icon-display flex justify-center mb-2 text-2xl transition-transform duration-300 group-hover:scale-110">
                {plantIcon}
              </div>
              <div class="grid grid-cols-2 gap-1 text-[9px] font-bold text-green-800 dark:text-stone-300">
                <div class="flex flex-col items-center bg-[#f4fce3]/60 dark:bg-black/20 rounded py-0.5">
                  <span class="opacity-60 mb-px">💧</span>
                  <span class="plant-humedad-val">{humedad}</span>
                </div>
                <div class="flex flex-col items-center bg-[#f4fce3]/60 dark:bg-black/20 rounded py-0.5">
                  <span class="opacity-60 mb-px">🌡️</span>
                  <span class="plant-temp-val">{temp}</span>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>


  <div class="flex flex-col">
    <!-- Contenedor para Three.js -->
    <div
      id="three-container"
      class="w-full h-96 bg-green-900 rounded-xl overflow-hidden shadow-inner relative"
    >
      <div
        id="time-display"
        class="absolute top-4 left-4 bg-black/50 text-white px-3 py-1 rounded-lg backdrop-blur-sm font-mono text-sm z-10"
      >
        Hora: --:--
      </div>
    </div>

    <!-- Panel de widgets debajo del mapa -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      
      <!-- Widget del Clima -->
      <div id="weather-widget" class="bg-green-50 dark:bg-stone-800/50 border border-green-100 dark:border-[#166534] rounded-xl p-4 flex flex-col gap-3 justify-between">
        <div class="flex items-center justify-between w-full">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-[#f4fce3] dark:bg-stone-700 rounded-lg shadow-sm border border-green-100 dark:border-stone-600">
              <span id="weather-icon" class="text-xl">☀️</span>
            </div>
            <div class="flex flex-col">
              <span id="weather-title" class="text-xs font-bold uppercase tracking-widest text-green-600 dark:text-stone-400">
                Clima Local
              </span>
              <div class="flex items-end gap-1">
                <span id="weather-temp" class="text-xl font-black tracking-tighter text-green-900 dark:text-stone-300">--</span>
                <span class="text-xs font-medium text-green-600 dark:text-stone-400 mb-0.5">°C</span>
              </div>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <span id="weather-humidity" class="bg-blue-100/50 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 px-2 py-2 rounded-md text-xs font-bold text-center flex flex-col items-center gap-1"><span class="text-lg">💧</span><span class="value">--%</span></span>
          <span id="weather-rain" class="bg-green-100/50 dark:bg-stone-900/50 text-green-700 dark:text-stone-300 px-2 py-2 rounded-md text-xs font-bold text-center flex flex-col items-center gap-1"><span class="text-lg">🌧️</span><span class="value">--%</span></span>
          <span id="weather-irradiance" class="bg-yellow-100/50 dark:bg-yellow-900/50 text-yellow-700 dark:text-yellow-300 px-2 py-2 rounded-md text-xs font-bold text-center flex flex-col items-center gap-1"><span class="text-lg">🔆</span><span class="value">-- W/m²</span></span>
        </div>
      </div>

      <!-- Widget Calidad Ambiental (Plantas) -->
      <div class="bg-green-50 dark:bg-stone-800/50 border border-green-100 dark:border-[#166534] rounded-xl p-4 flex flex-col justify-between gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-lime-100 dark:bg-lime-900/30 rounded-lg shadow-sm border border-lime-200 dark:border-lime-800/50">
              <span class="text-xl">🌿</span>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-widest text-lime-700 dark:text-lime-400">
                Calidad Ambiental
              </span>
              <span class="text-[10px] text-green-600 dark:text-stone-400">
                Fotosíntesis y Transpiración
              </span>
            </div>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-2 mt-1">
          <!-- CO2 -->
          <div class="bg-[#f4fce3] dark:bg-stone-800 p-2 rounded-lg border border-green-100 dark:border-[#166534] shadow-sm flex flex-col justify-between">
             <span class="text-[9px] font-bold text-green-600 dark:text-stone-400 uppercase">CO₂ (PPM)</span>
             <div class="flex items-end justify-between mt-1">
               <span class="text-lg font-black tracking-tight text-green-900 dark:text-stone-300">420</span>
               <span class="text-[8px] bg-lime-100 text-lime-700 dark:bg-lime-900/40 dark:text-lime-400 px-1.5 py-0.5 rounded-full font-bold">ÓPTIMO</span>
             </div>
          </div>
          
          <!-- DPV -->
          <div class="bg-[#f4fce3] dark:bg-stone-800 p-2 rounded-lg border border-green-100 dark:border-[#166534] shadow-sm flex flex-col justify-between">
             <span class="text-[9px] font-bold text-green-600 dark:text-stone-400 uppercase">DPV (kPa)</span>
             <div class="flex items-end justify-between mt-1">
               <span class="text-lg font-black tracking-tight text-green-900 dark:text-stone-300">0.8</span>
               <span class="text-[8px] bg-lime-100 text-lime-700 dark:bg-lime-900/40 dark:text-lime-400 px-1.5 py-0.5 rounded-full font-bold">IDEAL</span>
             </div>
          </div>
          
          <!-- Ozono/Contaminantes externos (WAQI) -->
          <div class="col-span-2 bg-[#f4fce3] dark:bg-stone-800 p-2 rounded-lg border border-green-100 dark:border-[#166534] shadow-sm flex items-center justify-between">
             <div class="flex flex-col">
               <span class="text-[9px] font-bold text-green-600 dark:text-stone-400 uppercase">Polución Externa (AQI)</span>
               <span id="aqi-value" class="text-lg font-black tracking-tight text-green-900 dark:text-stone-300">--</span>
             </div>
             <span id="aqi-status" class="text-[9px] uppercase px-2 py-1 rounded-full bg-green-100 text-green-700 dark:bg-stone-700 dark:text-stone-300 font-bold">Cargando</span>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>
</div>
</div>

<!-- Plant Details Modal -->
<div id="plant-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm cursor-pointer" id="plant-modal-backdrop"></div>
  
  <div class="relative bg-[#f4fce3] dark:bg-stone-800 rounded-2xl shadow-2xl border border-green-100 dark:border-[#166534] w-11/12 max-w-sm md:max-w-2xl p-6 md:p-8 transform scale-95 transition-transform duration-300" id="plant-modal-content">
    <button id="close-modal-btn" class="absolute top-4 right-4 text-green-400 hover:text-green-700 dark:hover:text-green-300 bg-green-100 dark:bg-stone-700 rounded-full p-1.5 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    
    <div class="flex items-center gap-4 mb-6 md:mb-8 border-b border-green-100 dark:border-[#166534] pb-6">
      <div id="modal-plant-icon" class="text-4xl md:text-5xl bg-green-50 dark:bg-stone-700/50 p-4 rounded-2xl shadow-sm border border-green-100 dark:border-stone-600">🪴</div>
      <div>
        <h3 id="modal-plant-title" class="text-xl md:text-3xl font-black text-green-950 dark:text-white tracking-tight">Planta P-1</h3>
        <p id="modal-plant-status" class="text-sm md:text-base font-bold text-lime-600 dark:text-lime-400 mt-1">Estado: Óptimo</p>
      </div>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
      <div class="bg-blue-50/50 dark:bg-blue-900/10 p-3 rounded-xl border border-blue-100 dark:border-blue-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600/70 dark:text-blue-400/70 mb-1">pH del Suelo (Ph)</div>
        <div id="modal-plant-ph" class="text-lg font-black text-blue-900 dark:text-blue-100">6.5</div>
      </div>
      <div class="bg-orange-50/50 dark:bg-orange-900/10 p-3 rounded-xl border border-orange-100 dark:border-orange-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-orange-600/70 dark:text-orange-400/70 mb-1">T. Piso Planta (T_Planta_C)</div>
        <div id="modal-plant-tsoil" class="text-lg font-black text-orange-900 dark:text-orange-100">N/D</div>
      </div>
      <div class="bg-green-50/50 dark:bg-stone-900/10 p-3 rounded-xl border border-green-100 dark:border-stone-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-green-600/70 dark:text-stone-400/70 mb-1">T. Invernadero (T_Int_C)</div>
        <div id="modal-plant-tair" class="text-lg font-black text-green-900 dark:text-stone-100">24°C</div>
      </div>
      <div class="bg-sky-50/50 dark:bg-sky-900/10 p-3 rounded-xl border border-sky-100 dark:border-sky-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-sky-600/70 dark:text-sky-400/70 mb-1">T. Externa (T_Ext_C)</div>
        <div id="modal-plant-text" class="text-lg font-black text-sky-900 dark:text-sky-100">20°C</div>
      </div>
      <div class="bg-teal-50/50 dark:bg-teal-900/10 p-3 rounded-xl border border-teal-100 dark:border-teal-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-teal-600/70 dark:text-teal-400/70 mb-1">Humedad (humedad_Pct)</div>
        <div id="modal-plant-hum" class="text-lg font-black text-teal-900 dark:text-teal-100">65%</div>
      </div>
      <div class="bg-lime-50/50 dark:bg-lime-900/10 p-3 rounded-xl border border-lime-100 dark:border-lime-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-lime-600/70 dark:text-lime-400/70 mb-1">Altura Planta (ALtura_cm)</div>
        <div id="modal-plant-growth" class="text-lg font-black text-lime-900 dark:text-lime-100">85 cm</div>
      </div>
      <div class="bg-purple-50/50 dark:bg-purple-900/10 p-3 rounded-xl border border-purple-100 dark:border-purple-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-purple-600/70 dark:text-purple-400/70 mb-1">Productividad</div>
        <div id="modal-plant-prod" class="text-lg font-black text-purple-900 dark:text-purple-100">Alta</div>
      </div>
      <div class="bg-rose-50/50 dark:bg-rose-900/10 p-3 rounded-xl border border-rose-100 dark:border-rose-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-rose-600/70 dark:text-rose-400/70 mb-1">Sanidad</div>
        <div id="modal-plant-health" class="text-lg font-black text-rose-900 dark:text-rose-100">Saludable</div>
      </div>
      <div class="bg-emerald-50/50 dark:bg-emerald-900/10 p-3 rounded-xl border border-emerald-100 dark:border-emerald-800/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-600/70 dark:text-emerald-400/70 mb-1">Responsable</div>
        <div id="modal-plant-resp" class="text-xs font-bold text-emerald-900 dark:text-emerald-100 truncate">Equipo de Campo</div>
      </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";
  import {
    fetchWeatherData,
    getWeatherEmoji,
  } from "../../backend/services/weather";

  // --- CONFIGURACIÓN INICIAL ---
  const container = document.getElementById("three-container");
  const timeDisplay = document.getElementById("time-display");

  if (container) {
    // --- ESCENA BÁSICA ---
    const scene = new THREE.Scene();

    // Configurar cámara según el tamaño del contenedor
    const camera = new THREE.PerspectiveCamera(
      75,
      container.clientWidth / container.clientHeight,
      0.1,
      1000,
    );
    // Alejar la cámara para que se vea el cielo y el sol
    camera.position.set(0, 8, 32);

    // Configurar el renderer
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    // Ajustar el canvas si la ventana cambia de tamaño
    window.addEventListener("resize", () => {
      if (container) {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
    });

    // Añadir un suelo simple (para notar mejor las sombras/iluminación)
    const groundGeometry = new THREE.PlaneGeometry(50, 50);
    const groundMaterial = new THREE.MeshStandardMaterial({
      color: 0x2e8b57,
      roughness: 0.8,
    }); // Verde para simular pasto
    const ground = new THREE.Mesh(groundGeometry, groundMaterial);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // Añadir un modelo básico del "invernadero" en el centro
    const greenhouseGeometry = new THREE.BoxGeometry(10, 5, 6);
    const greenhouseMaterial = new THREE.MeshStandardMaterial({
      color: 0xaaaaaa,
      transparent: true,
      opacity: 0.5,
    });
    const greenhouse = new THREE.Mesh(greenhouseGeometry, greenhouseMaterial);
    greenhouse.position.y = 2.5; // Elevarlo para que quede sobre el suelo
    greenhouse.castShadow = true;
    greenhouse.receiveShadow = true;
    scene.add(greenhouse);

    // Luz ambiental suave para que las partes oscuras no sean completamente negras
    const ambientLight = new THREE.AmbientLight(0x404040, 0.5);
    scene.add(ambientLight);

    // --- 1. LUZ DEL SOL ---
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.castShadow = true;

    // Mejorar la calidad de las sombras
    dirLight.shadow.mapSize.width = 1024;
    dirLight.shadow.mapSize.height = 1024;
    dirLight.shadow.camera.near = 0.5;
    dirLight.shadow.camera.far = 150;
    dirLight.shadow.camera.left = -20;
    dirLight.shadow.camera.right = 20;
    dirLight.shadow.camera.top = 20;
    dirLight.shadow.camera.bottom = -20;
    scene.add(dirLight);

    // --- 2. SOL VISUAL ---
    const sunGeometry = new THREE.SphereGeometry(2, 32, 32);
    const sunMaterial = new THREE.MeshBasicMaterial({
      color: 0xfffca3,
    });
    const sunMesh = new THREE.Mesh(sunGeometry, sunMaterial);
    scene.add(sunMesh);

    // --- 3. LUNA VISUAL ---
    const moonGeometry = new THREE.SphereGeometry(1.5, 32, 32);
    const moonMaterial = new THREE.MeshBasicMaterial({ color: 0xe0e0e0 });
    const moonMesh = new THREE.Mesh(moonGeometry, moonMaterial);
    scene.add(moonMesh);

    // --- FUNCIÓN DE CÁLCULO DE POSICIÓN ---
    function updateSun(hour: number) {
      // Actualizar el display de tiempo
      if (timeDisplay) {
        const hh = Math.floor(hour).toString().padStart(2, "0");
        const mm = Math.floor((hour % 1) * 60)
          .toString()
          .padStart(2, "0");
        timeDisplay.textContent = `Hora: ${hh}:${mm}`;
      }

      // Órbita más cerrada para asegurar que el sol y la luna no se salgan de pantalla
      const distanceX = 16; // Distancia horizontal (este a oeste)
      const distanceY = 12; // Altura máxima en el cielo (cenit)
      const z = -10; // Ligeramente por detrás

      // Entre las 6:00 y las 18:00 (Día)
      if (hour >= 6 && hour <= 18) {
        moonMesh.visible = false;
        sunMesh.visible = true;

        const progress = (hour - 6) / 12; // 0 (6am) a 1 (6pm)
        const angle = progress * Math.PI;

        const x = Math.cos(angle) * distanceX;
        const y = Math.sin(angle) * distanceY;

        dirLight.position.set(x, y, z);
        sunMesh.position.set(x, y, z);

        const heightFactor = Math.sin(angle);
        dirLight.intensity = Math.max(0.1, heightFactor * 2);
        dirLight.color.setHex(0xffffff);

        let skyColor = new THREE.Color();
        if (progress < 0.2 || progress > 0.8) {
          skyColor.setHex(0xff7b54);
          sunMaterial.color.setHex(0xff4500);
        } else {
          skyColor.setHex(0x87ceeb);
          sunMaterial.color.setHex(0xfffca3);
        }
        scene.background = skyColor;
      } else {
        // Noche (Luna)
        sunMesh.visible = false;
        moonMesh.visible = true;
        scene.background = new THREE.Color(0x0a0a2a);

        // Progreso de la noche: 18:00 (0) -> 6:00 (1)
        const nightHour = hour > 18 ? hour - 18 : hour + 6;
        const progress = nightHour / 12;
        const angle = progress * Math.PI;

        const x = Math.cos(angle) * distanceX;
        const y = Math.sin(angle) * distanceY;

        dirLight.position.set(x, y, z);
        moonMesh.position.set(x, y, z);

        // Luz de luna más suave y azulada
        dirLight.intensity = 0.3;
        dirLight.color.setHex(0xaaccff);
      }
    }

    // --- BUCLE DE ANIMACIÓN ---
    function animate() {
      requestAnimationFrame(animate);

      // Obtener la hora real actual
      const now = new Date();
      const currentHour =
        now.getHours() + now.getMinutes() / 60 + now.getSeconds() / 3600;

      updateSun(currentHour);

      renderer.render(scene, camera);
    }

    // Activar sombras en el renderer
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    // --- 3. DATOS DEL CLIMA (Predicción para el Invernadero) ---
    async function fetchWeather(lat: number, lon: number, isFallback = false) {
      try {
        const tempEl = document.getElementById("weather-temp");
        const humEl = document.getElementById("weather-humidity");
        const rainEl = document.getElementById("weather-rain");
        const irradianceEl = document.getElementById("weather-irradiance");
        const iconEl = document.getElementById("weather-icon");
        const titleEl = document.getElementById("weather-title");

        const data = await fetchWeatherData(lat, lon, isFallback);

        if (tempEl)
          tempEl.textContent = Math.round(data.temperature).toString();
        if (humEl) humEl.innerHTML = `<span class="text-lg">💧</span><span class="value">${data.humidity}%</span>`;
        if (rainEl) rainEl.innerHTML = `<span class="text-lg">🌧️</span><span class="value">${data.rainProbability}%</span>`;
        if (irradianceEl) irradianceEl.innerHTML = `<span class="text-lg">🔆</span><span class="value">${Math.round(data.irradiance)} W/m²</span>`;
        if (titleEl) {
          titleEl.textContent = data.isFallback
            ? "Clima (Medellín)"
            : "Clima (Tu ubicación)";
        }
        if (iconEl) {
          iconEl.textContent = getWeatherEmoji(data.weatherCode);
        }
      } catch (e) {
        console.error("Error cargando el clima:", e);
      }
    }

    async function fetchAQI(lat: number, lon: number) {
      try {
        const token = "b3e64cc0156d4ea004ea5f3dd5b2e2a4d4e37656";
        const url = `https://api.waqi.info/feed/geo:${lat};${lon}/?token=${token}`;
        const res = await fetch(url);
        const json = await res.json();

        if (json.status === "ok") {
          const aqi = json.data.aqi;
          const valueEl = document.getElementById("aqi-value");
          const statusEl = document.getElementById("aqi-status");

          if (valueEl) valueEl.textContent = aqi.toString();

          if (statusEl) {
            if (aqi <= 50) {
              statusEl.textContent = "ÓPTIMO";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-green-500/20 text-green-700 dark:text-stone-300 font-bold";
            } else if (aqi <= 100) {
              statusEl.textContent = "ACEPTABLE";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-700 dark:text-yellow-300 font-bold";
            } else if (aqi <= 150) {
              statusEl.textContent = "RIESGO LEVE";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-orange-500/20 text-orange-700 dark:text-orange-300 font-bold";
            } else if (aqi <= 200) {
              statusEl.textContent = "DAÑINO (CERRAR VENT.)";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-500/20 text-red-700 dark:text-red-300 font-bold";
            } else if (aqi <= 300) {
              statusEl.textContent = "MUY DAÑINO";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-700 dark:text-purple-300 font-bold";
            } else {
              statusEl.textContent = "PELIGROSO";
              statusEl.className =
                "text-[9px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-rose-900/50 text-rose-300 font-bold";
            }
          }
        }
      } catch (err) {
        console.error("Error fetching AQI:", err);
      }
    }

    function initWeather() {
      // Intentar obtener la ubicación del dispositivo
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            fetchWeather(lat, lon, false);
            fetchAQI(lat, lon);
            // Configurar actualización automática cada 10 min
            setInterval(() => {
              fetchWeather(lat, lon, false);
              fetchAQI(lat, lon);
            }, 600000);
          },
          (error) => {
            console.warn(
              "Geolocalización denegada o fallida, usando Medellín por defecto.",
              error,
            );
            // Coordenadas por defecto (Medellín)
            const fallbackLat = 6.2442;
            const fallbackLon = -75.5812;
            fetchWeather(fallbackLat, fallbackLon, true);
            fetchAQI(fallbackLat, fallbackLon);
            setInterval(() => {
              fetchWeather(fallbackLat, fallbackLon, true);
              fetchAQI(fallbackLat, fallbackLon);
            }, 600000);
          },
          { timeout: 10000 },
        );
      } else {
        // Navegador no soporta geolocalización
        const fallbackLat = 6.2442;
        const fallbackLon = -75.5812;
        fetchWeather(fallbackLat, fallbackLon, true);
        fetchAQI(fallbackLat, fallbackLon);
        setInterval(() => {
          fetchWeather(fallbackLat, fallbackLon, true);
          fetchAQI(fallbackLat, fallbackLon);
        }, 600000);
      }
    }

    initWeather();

    animate();
  }

  // --- LÓGICA DEL MODAL DE PLANTAS ---
  const modal = document.getElementById('plant-modal');
  const modalContent = document.getElementById('plant-modal-content');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const backdrop = document.getElementById('plant-modal-backdrop');

  if (modal && modalContent) {
    const openModal = () => {
      modal.classList.remove('hidden');
      // Forzar reflow para que la animación funcione
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
    };

    const closeModal = () => {
      modal.classList.add('opacity-0');
      modalContent.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    };

    closeModalBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.querySelectorAll('.plant-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLElement;
        
        // Poblar datos del modal
        const elTitle = document.getElementById('modal-plant-title');
        const elIcon = document.getElementById('modal-plant-icon');
        const elStatus = document.getElementById('modal-plant-status');
        
        if (elTitle) elTitle.textContent = 'Planta ' + t.dataset.id;
        if (elIcon) elIcon.textContent = t.dataset.icon || '🪴';
        if (elStatus) {
          elStatus.textContent = 'Estado: ' + t.dataset.status;
          elStatus.className = 'text-sm font-bold ' + (t.dataset.statuscolor || '');
        }

        const phEl = document.getElementById('modal-plant-ph');
        const tsEl = document.getElementById('modal-plant-tsoil');
        const taEl = document.getElementById('modal-plant-tair');
        const teEl = document.getElementById('modal-plant-text');
        const huEl = document.getElementById('modal-plant-hum');
        const grEl = document.getElementById('modal-plant-growth');
        const prEl = document.getElementById('modal-plant-prod');
        const heEl = document.getElementById('modal-plant-health');
        const reEl = document.getElementById('modal-plant-resp');

        if (phEl) phEl.textContent = t.dataset.ph || '--';
        if (tsEl) tsEl.textContent = t.dataset.tsoil || '--';
        if (taEl) taEl.textContent = t.dataset.tair || '--';
        if (teEl) teEl.textContent = t.dataset.text || '--';
        if (huEl) huEl.textContent = t.dataset.hum || '--';
        if (grEl) grEl.textContent = t.dataset.growth || '--';
        if (prEl) prEl.textContent = t.dataset.prod || '--';
        if (heEl) heEl.textContent = t.dataset.health || '--';
        if (reEl) reEl.textContent = t.dataset.resp || 'Equipo de Campo';

        openModal();
      });
    });
  }

  // --- SINCRONIZACIÓN EN VIVO CON HISTORIAL Y GOOGLE SHEETS ---
  const STORAGE_KEY_RECORDS = 'macollo_custom_history_records';
  const STORAGE_KEY_RECORDS_ALT = 'aquasens_custom_history_records';

  function resolveCoordsDashboard(rawId: string, rawFila?: string, rawCol?: string) {
    const pRaw = String(rawId || '').trim();
    const fRaw = String(rawFila || '').trim();
    const cRaw = String(rawCol || '').trim();

    let filaIdx = -1;
    let colIdx = -1;

    // 1. Buscar código compuesto T[0-3O]-P[1-5] en cualquiera de los valores
    const candidateTexts = [pRaw, fRaw, cRaw].filter(Boolean);
    for (const text of candidateTexts) {
      const compMatch = text.match(/(?:^|[^a-zA-Z])T([0-3O])[\s\-_/.]*(?:P|F|COL|PLANTA)?[\s\-_/.]*([1-5])\b/i);
      if (compMatch) {
        const fChar = compMatch[1].toUpperCase() === 'O' ? '0' : compMatch[1];
        filaIdx = parseInt(fChar, 10);
        colIdx = parseInt(compMatch[2], 10) - 1;
        break;
      }
    }

    // 2. Extraer tratamiento (fila) si aún no está determinado
    if (filaIdx === -1 && fRaw) {
      const tratMatch = fRaw.match(/(?:TRATAMIENTO|FILA|CAMA|BLOQUE|SECCION)[\s\-_:]*T?([0-3O])\b/i);
      if (tratMatch) {
        const fChar = tratMatch[1].toUpperCase() === 'O' ? '0' : tratMatch[1];
        filaIdx = parseInt(fChar, 10);
      } else {
        const tMatch = fRaw.match(/(?:^|[^a-zA-Z])T([0-3O])(?:[^a-zA-Z0-9]|$)/i);
        if (tMatch) {
          const fChar = tMatch[1].toUpperCase() === 'O' ? '0' : tMatch[1];
          filaIdx = parseInt(fChar, 10);
        } else {
          const dMatch = fRaw.match(/^([0-3])$/);
          if (dMatch) {
            filaIdx = parseInt(dMatch[1], 10);
          }
        }
      }
    }

    // 3. Extraer columna/planta (1..5) si aún no está determinada
    const colCandidates = [cRaw, pRaw].filter(Boolean);
    if (colIdx === -1) {
      for (const text of colCandidates) {
        const pMatch = text.match(/(?:^|[^a-zA-Z])P[\s\-_:]*0?([1-5])(?:[^a-zA-Z0-9]|$)/i);
        if (pMatch) {
          colIdx = parseInt(pMatch[1], 10) - 1;
          break;
        }
        const namedColMatch = text.match(/(?:PLANTA|COL|COLUMNA|SITIO)[\s\-_:]*0?([1-5])\b/i);
        if (namedColMatch) {
          colIdx = parseInt(namedColMatch[1], 10) - 1;
          break;
        }
        const numMatch = text.match(/^0?([1-5])$/);
        if (numMatch) {
          colIdx = parseInt(numMatch[1], 10) - 1;
          break;
        }
      }
    }

    // 4. Si filaIdx aún no se resolvió pero se dispone de número global 1..20
    if (filaIdx === -1) {
      const globalMatch = pRaw.match(/^P[-_\s]?0?([1-9]|1[0-9]|20)$/i) || pRaw.match(/^0?([1-9]|1[0-9]|20)$/);
      if (globalMatch) {
        const num = parseInt(globalMatch[1], 10);
        filaIdx = Math.floor((num - 1) / 5);
        if (colIdx === -1) {
          colIdx = (num - 1) % 5;
        }
      }
    }

    if (filaIdx < 0 || filaIdx > 3) filaIdx = 0;
    if (colIdx < 0 || colIdx > 4) colIdx = 0;

    const FILAS = ['t0', 't1', 't2', 't3'];
    const COLUMNAS = ['Col 1', 'Col 2', 'Col 3', 'Col 4', 'Col 5'];
    return {
      fila: FILAS[filaIdx],
      columna: COLUMNAS[colIdx],
      code: `T${filaIdx}-P${colIdx + 1}`,
      plantNumber: filaIdx * 5 + colIdx + 1,
      plantId: `P-${(filaIdx * 5 + colIdx + 1) < 10 ? '0' + (filaIdx * 5 + colIdx + 1) : (filaIdx * 5 + colIdx + 1)}`
    };
  }

  function purgeMockStorage() {
    const keys = [STORAGE_KEY_RECORDS, STORAGE_KEY_RECORDS_ALT];
    keys.forEach(k => {
      try {
        const stored = localStorage.getItem(k);
        if (!stored) return;
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) {
          const realOnly = parsed.filter((r: any) => r && typeof r.id === 'string' && r.id.startsWith('MET-GS-'));
          if (realOnly.length === 0) {
            localStorage.removeItem(k);
          } else if (realOnly.length !== parsed.length) {
            localStorage.setItem(k, JSON.stringify(realOnly));
          }
        }
      } catch {
        localStorage.removeItem(k);
      }
    });
  }

  function syncDashboardWithRealRecords() {
    try {
      purgeMockStorage();
      const stored = localStorage.getItem(STORAGE_KEY_RECORDS) || localStorage.getItem(STORAGE_KEY_RECORDS_ALT);
      if (!stored) return;
      const records = JSON.parse(stored);
      if (!Array.isArray(records) || records.length === 0) return;

      const dates = Array.from(new Set(records.map((r: any) => r.fecha))).sort((a: any, b: any) => b.localeCompare(a));
      const latestDate = dates[0] || '2026-09-30';

      const syncText = document.getElementById('dashboard-sync-text');
      if (syncText) {
        syncText.textContent = `Datos en Vivo (${latestDate}) • ${records.length} tomas reales`;
      }
      const syncDot = document.querySelector('#dashboard-sync-indicator span');
      if (syncDot) {
        syncDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
      }
      const syncBadge = document.getElementById('dashboard-sync-indicator');
      if (syncBadge) {
        syncBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800';
      }

      const cards = document.querySelectorAll('.plant-card');
      cards.forEach((cardEl) => {
        const card = cardEl as HTMLElement;
        const code = card.dataset.id;
        const plantId = card.dataset.plantid;
        const fila = card.dataset.fila;
        const col = card.dataset.columna;

        const plantRecords = records.filter((r: any) => {
          if (r.code && r.code === code) return true;
          if (r.plantId && r.plantId === plantId) return true;
          if (r.fila === fila && r.columna === col) return true;
          const parsed = resolveCoordsDashboard(r.code || r.plantId, r.fila, r.columna);
          return parsed.fila === fila && parsed.columna === col;
        }).sort((a: any, b: any) => a.fecha.localeCompare(b.fecha));

        if (plantRecords.length === 0) return;

        const latest = plantRecords[plantRecords.length - 1];
        const isCritical = latest.sanidad === 'Crítica';
        const isWarning = latest.sanidad === 'Vulnerable';
        const plantStatus = isCritical ? 'Crítico' : isWarning ? 'Atención' : 'Óptimo';
        const plantIcon = isCritical ? '🥀' : isWarning ? '🌿' : '🪴';
        const tempStr = (latest.tempInterna !== null && latest.tempInterna !== undefined && !isNaN(Number(latest.tempInterna)))
          ? `${Number(latest.tempInterna).toFixed(1)}°C`
          : (latest.tempInvernadero !== undefined && latest.tempInvernadero !== null ? `${Number(latest.tempInvernadero).toFixed(1)}°C` : 'N/D');
        const humedad = latest.humedad !== undefined && latest.humedad !== null
          ? `${latest.humedad}%`
          : (isCritical ? '35%' : isWarning ? '48%' : '65%');
        const ph = Number(latest.phSuelo).toFixed(1);
        const tsoil = (latest.tempSuelo !== null && latest.tempSuelo !== undefined && !isNaN(Number(latest.tempSuelo)))
          ? `${Number(latest.tempSuelo).toFixed(1)}°C`
          : 'N/D';
        const growth = latest.alturaCm !== undefined && latest.alturaCm !== null
          ? `${latest.alturaCm} cm`
          : `${latest.crecimiento}%`;

        card.dataset.status = plantStatus;
        card.dataset.icon = plantIcon;
        card.dataset.statuscolor = isCritical
          ? 'text-rose-600 dark:text-rose-400'
          : isWarning
            ? 'text-yellow-600 dark:text-yellow-400'
            : 'text-lime-600 dark:text-lime-400';
        card.dataset.ph = ph;
        card.dataset.tsoil = tsoil;
        card.dataset.tair = latest.tempInvernadero !== undefined ? `${latest.tempInvernadero}°C` : tempStr;
        card.dataset.text = (latest.tempExterna !== undefined && latest.tempExterna !== null) ? `${Number(latest.tempExterna).toFixed(1)}°C` : 'N/D';
        card.dataset.hum = humedad;
        card.dataset.growth = growth;
        card.dataset.prod = latest.productividad;
        card.dataset.health = latest.sanidad;
        card.dataset.resp = latest.responsable || 'Equipo de Campo';

        const iconEl = card.querySelector('.plant-icon-display');
        if (iconEl) iconEl.textContent = plantIcon;

        const dotEl = card.querySelector('.plant-dot');
        if (dotEl) {
          dotEl.className = `plant-dot w-1.5 h-1.5 rounded-full ${isCritical ? 'bg-rose-500' : isWarning ? 'bg-yellow-400' : 'bg-lime-500'} shadow-sm`;
        }

        const tempValEl = card.querySelector('.plant-temp-val');
        if (tempValEl) tempValEl.textContent = tempStr;

        const humValEl = card.querySelector('.plant-humedad-val');
        if (humValEl) humValEl.textContent = humedad;

        const statusBorder = isCritical
          ? 'bg-rose-50 dark:bg-rose-900/20 border-rose-200 dark:border-rose-800/50'
          : isWarning
            ? 'bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-800/50'
            : 'bg-lime-50 dark:bg-lime-900/10 border-lime-200 dark:border-lime-800/30';

        card.className = `plant-card relative group overflow-hidden rounded-xl border p-2.5 transition-all hover:-translate-y-1 hover:shadow-md cursor-pointer ${statusBorder}`;
      });
    } catch (e) {
      console.error('Error sincronizando Dashboard con datos reales:', e);
    }
  }

  syncDashboardWithRealRecords();
  window.addEventListener('storage', syncDashboardWithRealRecords);
  window.addEventListener('aquasens:data-synced', syncDashboardWithRealRecords);
</script>
