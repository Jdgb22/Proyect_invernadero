---
// Welcome.astro
---

<div class="min-h-screen flex flex-col lg:flex-row w-full bg-stone-50 dark:bg-stone-900">
  
  <!-- Left Side: Video Panel -->
  <div id="farmer-panel" class="w-full h-72 lg:h-auto lg:min-h-screen lg:w-1/2 relative bg-stone-950 dark:bg-black overflow-hidden flex items-center justify-center flex-shrink-0">
    
    <!-- Video de bienvenida -->
    <video
      id="welcome-video"
      src="/newwelcome.mp4"
      muted
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover object-center"
      style="z-index:1;"
    ></video>

    <!-- Degradado inferior -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent pointer-events-none" style="z-index:3;"></div>
    <!-- Texto superpuesto -->
    <div class="absolute bottom-6 lg:bottom-10 left-6 lg:left-10 text-white max-w-xs lg:max-w-sm" style="z-index:4;">
      <h2 class="text-2xl lg:text-4xl font-bold drop-shadow-md mb-1 lg:mb-3">AquaSens</h2>
      <p class="text-sm lg:text-base text-stone-300 drop-shadow">Plataforma integral para el monitoreo y gestión inteligente de tu invernadero.</p>
    </div>
  </div>

  <!-- Right Side: Login Form -->
  <div class="flex flex-col justify-center w-full lg:w-1/2 p-8 sm:p-12 lg:p-24 bg-white dark:bg-stone-900">
    <div class="max-w-md w-full mx-auto">
      <div class="text-center lg:text-left mb-10">
        <h1 class="text-3xl font-extrabold text-stone-900 dark:text-white tracking-tight">Acceder al Sistema</h1>
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">Ingresa tus credenciales para continuar</p>
      </div>

      <form id="login-form" class="space-y-6" novalidate>
        <div>
          <label for="username" class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-2">Usuario</label>
          <input id="username" name="username" type="text" autocomplete="username"
            class="block w-full px-4 py-3.5 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="admin o user" />
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-2">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password"
            class="block w-full px-4 py-3.5 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="••••••••" />
        </div>

        <div class="flex items-center justify-between pt-2">
          <label class="flex items-center gap-2 text-sm text-stone-600 dark:text-stone-400 cursor-pointer">
            <input id="remember-me" name="remember-me" type="checkbox"
              class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-stone-300 rounded dark:border-stone-600 dark:bg-stone-700" />
            Recordarme
          </label>
          <a href="#" class="text-sm font-medium text-amber-600 hover:text-amber-500 dark:text-stone-400">¿Olvidaste tu contraseña?</a>
        </div>

        <div class="pt-2">
          <button id="login-btn" type="submit"
            class="w-full flex justify-center items-center gap-2 py-4 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none">
            <span id="btn-text">Iniciar Sesión</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>

        <div id="error-message" class="hidden p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400">
          Credenciales incorrectas. Intenta nuevamente.
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  import { signIn } from 'auth-astro/client';

  const loginForm  = document.getElementById('login-form')!;
  const loginBtn   = document.getElementById('login-btn') as HTMLButtonElement;
  const btnText    = document.getElementById('btn-text')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const errorMsg   = document.getElementById('error-message') as HTMLElement;
  const welcomeVideo = document.getElementById('welcome-video') as HTMLVideoElement;

  function setLoading(on: boolean) {
    loginBtn.disabled = on;
    btnText.textContent = on ? 'Cargando…' : 'Iniciar Sesión';
    btnSpinner.classList.toggle('hidden', !on);
  }

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');

    const username = (document.getElementById('username') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    if (!username || !password) {
      errorMsg.textContent = 'Por favor ingresa usuario y contraseña.';
      errorMsg.classList.remove('hidden');
      return;
    }

    setLoading(true);

    // 1. Reproducir el video INMEDIATAMENTE
    welcomeVideo.currentTime = 0;
    const playPromise = welcomeVideo.play();
    if (playPromise !== undefined) {
      playPromise.catch(err => {
        console.warn('El navegador bloqueó el video:', err);
      });
    }

    // 2. Esperar a que el video termine ANTES de autenticar (igual que la animación original Lottie)
    await new Promise<void>(resolve => {
      // Timeout máximo por si el video se traba o no dispara 'ended'
      const timeout = setTimeout(() => {
        welcomeVideo.removeEventListener('ended', onEnded);
        resolve();
      }, 5000); // 5 segundos máximo de espera
      
      const onEnded = () => {
        clearTimeout(timeout);
        resolve();
      };
      
      welcomeVideo.addEventListener('ended', onEnded, { once: true });
    });

    // 3. Login
    try {
      const result = await signIn('credentials', {
        username,
        password,
        redirect: false,
      } as any);

      if ((result as any)?.error) {
        setLoading(false);
        errorMsg.textContent = 'Credenciales incorrectas. Intenta nuevamente.';
        errorMsg.classList.remove('hidden');
        welcomeVideo.pause();
      } else {
        // Redirigir al dashboard
        window.location.href = '/';
      }
    } catch (err) {
      console.error(err);
      setLoading(false);
      errorMsg.textContent = 'Error inesperado. Intenta nuevamente.';
      errorMsg.classList.remove('hidden');
      welcomeVideo.pause();
    }
  });
</script>
