---
// Welcome.astro
const today = new Date().toISOString().slice(0, 10);
---

<div
  class="min-h-dvh flex flex-col lg:flex-row w-full bg-stone-50 dark:bg-stone-900"
>
  <!-- Left Side: Video Panel -->
  <div
    id="farmer-panel"
    class="w-full h-64 sm:h-72 lg:h-auto lg:min-h-dvh lg:w-1/2 relative bg-stone-950 dark:bg-black overflow-hidden flex items-center justify-center flex-shrink-0"
  >
    <!-- Video de bienvenida -->
    <video
      id="welcome-video"
      src="/newwelcome.mp4"
      muted
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover object-center"
      style="z-index:1;"></video>

    <!-- Degradado inferior -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent pointer-events-none"
      style="z-index:3;"
    >
    </div>

    <!-- Botón de Audio (Mute/Unmute) -->
    <button
      id="audio-toggle-btn"
      type="button"
      class="absolute top-4 right-4 lg:top-8 lg:right-8 p-2 rounded-full bg-black/40 hover:bg-black/60 text-white backdrop-blur-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500"
      style="z-index:10;"
      aria-label="Alternar audio"
    >
      <!-- Ícono Muted (por defecto) -->
      <svg id="icon-muted" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
      </svg>
      <!-- Ícono Unmuted (oculto por defecto) -->
      <svg id="icon-unmuted" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M17.95 6.05a8 8 0 010 11.9M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
      </svg>
    </button>
    <!-- Texto superpuesto -->
    <div
      class="absolute bottom-6 lg:bottom-10 left-6 lg:left-10 text-white max-w-xs lg:max-w-sm"
      style="z-index:4;"
    >
      <h2 class="text-2xl lg:text-4xl font-bold drop-shadow-md mb-1 lg:mb-3">
        Macollo
      </h2>
      <p class="text-sm lg:text-base text-stone-300 drop-shadow">
        Plataforma integral para el monitoreo y gestión inteligente de tu
        invernadero.
      </p>
    </div>
  </div>

  <!-- Right Side: Auth Forms Panel -->
  <div
    class="flex flex-col w-full lg:w-1/2 p-6 sm:p-10 lg:p-20 bg-white dark:bg-stone-900 lg:h-dvh overflow-y-auto"
  >
    <div class="max-w-md w-full m-auto">
      
      <!-- Selector de Modo (Tabs Login / Registro) -->
      <div id="auth-tabs-container" class="relative flex p-1 mb-8 bg-stone-100 dark:bg-stone-800 rounded-2xl border border-stone-200/80 dark:border-stone-700/80">
        <span
          id="auth-tab-indicator"
          class="absolute top-1 bottom-1 left-1 w-[calc(50%-0.25rem)] rounded-xl bg-white dark:bg-stone-700 shadow-sm transition-transform duration-300 ease-out"
        ></span>
        <button
          id="tab-login-btn"
          type="button"
          class="relative z-10 flex-1 py-2.5 px-4 text-sm font-bold rounded-xl transition-colors text-stone-900 dark:text-white"
        >
          Iniciar Sesión
        </button>
        <button
          id="tab-register-btn"
          type="button"
          class="relative z-10 flex-1 py-2.5 px-4 text-sm font-semibold rounded-xl transition-colors text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200"
        >
          Crear Cuenta
        </button>
      </div>

      <!-- Encabezado dinámico -->
      <div class="text-center lg:text-left mb-6">
        <h1
          id="auth-title"
          class="text-3xl font-extrabold text-stone-900 dark:text-white tracking-tight"
        >
          Acceder al Sistema
        </h1>
        <p id="auth-subtitle" class="mt-2 text-sm text-stone-500 dark:text-stone-400">
          Ingresa tus credenciales para continuar
        </p>
      </div>

      <!-- ── FORMULARIO INICIAR SESIÓN ── -->
      <form id="login-form" class="space-y-4" novalidate>
        <div>
          <label
            for="username"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >Correo o Celular</label
          >
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="juan@ejemplo.com o 3001234567"
          />
        </div>

        <div>
          <label
            for="password"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >Contraseña</label
          >
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              class="block w-full px-4 py-3 pr-12 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
              placeholder="••••••••"
            />
            <button
              id="toggle-password-btn"
              type="button"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 focus:outline-none"
              aria-label="Mostrar u ocultar contraseña"
            >
              <!-- Ícono Mostrar (ojo abierto) -->
              <svg id="eye-show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <!-- Ícono Ocultar (ojo tachado) -->
              <svg id="eye-hide" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1">
          <label
            class="flex items-center gap-2 text-sm text-stone-600 dark:text-stone-400 cursor-pointer"
          >
            <input
              id="remember-me"
              name="remember-me"
              type="checkbox"
              class="h-4 w-4 text-green-600 focus:ring-green-500 border-stone-300 rounded dark:border-stone-600 dark:bg-stone-700"
            />
            Recordarme
          </label>
          <button
            id="forgot-password-link"
            type="button"
            class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-500 focus:outline-none hover:underline underline-offset-2"
          >
            ¿Olvidaste tu contraseña?
          </button>
        </div>

        <div class="pt-1">
          <button
            id="login-btn"
            type="submit"
            class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-green-600 to-lime-600 hover:from-green-500 hover:to-lime-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none"
          >
            <span id="btn-text">Iniciar Sesión</span>
            <svg
              id="btn-spinner"
              class="hidden animate-spin h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>

        <div
          id="error-message"
          class="hidden p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400"
        >
          Credenciales incorrectas. Intenta nuevamente.
        </div>

        <!-- Enlace para ir a registro -->
        <p class="text-center text-sm text-stone-500 dark:text-stone-400 pt-2">
          ¿No tienes una cuenta?{" "}
          <button
            id="link-to-register"
            type="button"
            class="font-semibold text-green-600 hover:text-green-700 dark:text-green-500 underline underline-offset-2"
          >
            Regístrate aquí
          </button>
        </p>
      </form>

      <!-- ── FORMULARIO CREAR CUENTA ── -->
      <form id="register-form" class="space-y-4 hidden" novalidate>
        <div
          id="reg-feedback-message"
          class="hidden p-3 rounded-lg text-sm text-center border font-medium"
        ></div>

        <div class="flex items-center gap-3">
          <div class="flex gap-1.5">
            <span class="reg-dot h-1.5 w-6 rounded-full bg-green-600 transition-colors"></span>
            <span class="reg-dot h-1.5 w-6 rounded-full bg-stone-200 dark:bg-stone-700 transition-colors"></span>
          </div>
          <span id="reg-step-label" class="text-xs font-medium text-stone-500 dark:text-stone-400">Paso 1 de 2</span>
        </div>

        <!-- PASO 1: Datos personales -->
        <div id="reg-step-1" class="space-y-4">
        <!-- Nombre completo -->
        <div>
          <label
            for="reg-name"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
          >
            Nombre Completo <span class="text-green-800 dark:text-green-400">*</span>
          </label>
          <input
            id="reg-name"
            name="name"
            type="text"
            autocomplete="name"
            class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="Ej: Juan Pérez"
          />
        </div>

        <!-- Correo Electrónico y Celular -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label
              for="reg-email"
              class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >
              Correo Electrónico
            </label>
            <input
              id="reg-email"
              name="email"
              type="email"
              autocomplete="email"
              class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
              placeholder="juan@ejemplo.com"
            />
          </div>

          <div>
            <label
              for="reg-phone"
              class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >
              Número Celular
            </label>
            <input
              id="reg-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
              placeholder="300 123 4567"
            />
          </div>
        </div>
        <p class="text-xs text-stone-500 dark:text-stone-400 -mt-2">
          * Puedes ingresar tu correo, tu número celular o ambos.
        </p>

        <!-- Fecha de Nacimiento -->
        <div>
          <label
            for="reg-birthdate"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
          >
            Fecha de Nacimiento
          </label>
          <input
            id="reg-birthdate"
            name="birthDate"
            type="date"
            max={today}
            class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
          />
        </div>

        <div class="pt-1">
          <button
            id="reg-next-btn"
            type="button"
            class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-green-600 to-lime-600 hover:from-green-500 hover:to-lime-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all transform hover:-translate-y-0.5"
          >
            Continuar
          </button>
        </div>
        </div>

        <!-- PASO 2: Tu cuenta -->
        <div id="reg-step-2" class="space-y-4 hidden">
        <!-- Contraseña -->
        <div>
          <label
            for="reg-password"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
          >
            Contraseña <span class="text-green-800 dark:text-green-400">*</span>
          </label>
          <div class="relative">
            <input
              id="reg-password"
              name="password"
              type="password"
              autocomplete="new-password"
              class="block w-full px-4 py-3 pr-12 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
              placeholder="Mínimo 8 caracteres"
            />
            <button
              id="toggle-reg-password-btn"
              type="button"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 focus:outline-none"
              aria-label="Mostrar u ocultar contraseña"
            >
              <svg id="eye-reg-show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eye-reg-hide" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
              </svg>
            </button>
          </div>
        </div>

        <div>
          <label
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
          >
            Tipo de cuenta
          </label>
          <div
            id="reg-account-type-toggle"
            class="flex gap-1 p-1 bg-stone-100 dark:bg-stone-700/50 rounded-xl"
            role="radiogroup"
            aria-label="Tipo de cuenta"
          >
            <button type="button" data-value="Campesino" class="seg-btn active">Trabajo en una finca</button>
            <button type="button" data-value="Agropecuario" class="seg-btn">Tengo mi propia finca</button>
          </div>
          <input type="hidden" id="reg-account-type" name="accountType" value="Campesino" />
        </div>

        <div id="reg-finconombre-group" class="hidden">
          <label
            for="reg-finconombre"
            class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
          >
            Nombre de tu finca <span class="text-green-800 dark:text-green-400">*</span>
          </label>
          <input
            id="reg-finconombre"
            name="fincaNombre"
            type="text"
            autocomplete="off"
            class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
            placeholder="Ej: Finca La Esperanza"
          />
        </div>

        <div class="pt-1 flex gap-2">
          <button
            id="reg-back-btn"
            type="button"
            class="flex-shrink-0 px-4 rounded-xl border border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-300 text-sm font-semibold hover:bg-stone-100 dark:hover:bg-stone-700/60 transition-all"
          >
            Atrás
          </button>
          <button
            id="register-btn"
            type="submit"
            class="flex-1 flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-green-600 to-lime-600 hover:from-green-500 hover:to-lime-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none"
          >
            <span id="reg-btn-text">Crear Cuenta</span>
            <svg
              id="reg-btn-spinner"
              class="hidden animate-spin h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>
        </div>

        <!-- Enlace para ir a login -->
        <p class="text-center text-sm text-stone-500 dark:text-stone-400 pt-2">
          ¿Ya tienes una cuenta?{" "}
          <button
            id="link-to-login"
            type="button"
            class="font-semibold text-green-600 hover:text-green-700 dark:text-green-500 underline underline-offset-2"
          >
            Inicia sesión aquí
          </button>
        </p>
      </form>

      <!-- ── FORMULARIO RECUPERAR CONTRASEÑA ── -->
      <div id="forgot-container" class="space-y-4 hidden">
        
        <!-- Paso 1: Enviar Código -->
        <form id="forgot-step1-form" class="space-y-4" novalidate>
          <div>
            <label
              for="forgot-identifier"
              class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >
              Correo Electrónico o Celular Registrado
            </label>
            <input
              id="forgot-identifier"
              name="identifier"
              type="text"
              class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
              placeholder="tu@correo.com o 3001234567"
            />
          </div>

          <div class="pt-1">
            <button
              id="btn-forgot-send"
              type="submit"
              class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-green-600 to-lime-600 hover:from-green-500 hover:to-lime-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none"
            >
              <span id="btn-forgot-send-text">Enviar Código de Seguridad</span>
              <svg
                id="btn-forgot-send-spinner"
                class="hidden animate-spin h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- Paso 2: Verificar Código y Crear Nueva Contraseña -->
        <form id="forgot-step2-form" class="space-y-4 hidden" novalidate>
          <div id="forgot-step2-desc" class="p-3 rounded-lg bg-emerald-50 text-sm text-emerald-700 text-center border border-emerald-200 font-medium dark:bg-emerald-900/20 dark:border-emerald-800 dark:text-emerald-400">
            Hemos enviado un código de 6 dígitos. Ingrésalo a continuación para crear tu nueva clave.
          </div>

          <div>
            <label
              for="forgot-code"
              class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >
              Código de Verificación (6 dígitos)
            </label>
            <input
              id="forgot-code"
              name="code"
              type="text"
              inputmode="numeric"
              maxlength="6"
              class="block w-full px-4 py-3 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-lg tracking-widest text-center font-mono font-bold transition-all shadow-sm"
              placeholder="123456"
            />
          </div>

          <div>
            <label
              for="forgot-new-password"
              class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5"
            >
              Nueva Contraseña
            </label>
            <div class="relative">
              <input
                id="forgot-new-password"
                name="newPassword"
                type="password"
                autocomplete="new-password"
                class="block w-full px-4 py-3 pr-12 bg-stone-50 border border-stone-200 dark:border-stone-600 rounded-xl placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-stone-700/50 dark:text-white text-sm transition-all shadow-sm"
                placeholder="Mínimo 6 caracteres"
              />
              <button
                id="toggle-forgot-password-btn"
                type="button"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 focus:outline-none"
                aria-label="Mostrar u ocultar contraseña"
              >
                <svg id="eye-forgot-show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eye-forgot-hide" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>
          </div>

          <div class="pt-1">
            <button
              id="btn-forgot-reset"
              type="submit"
              class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white bg-gradient-to-r from-green-600 to-lime-600 hover:from-green-500 hover:to-lime-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all transform hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none"
            >
              <span id="btn-forgot-reset-text">Restablecer Contraseña</span>
              <svg
                id="btn-forgot-reset-spinner"
                class="hidden animate-spin h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </div>
        </form>

        <div
          id="forgot-feedback-message"
          class="hidden p-3 rounded-lg text-sm text-center border font-medium"
        ></div>

        <!-- Enlace para volver a Iniciar Sesión -->
        <p class="text-center text-sm text-stone-500 dark:text-stone-400 pt-2">
          <button
            id="link-forgot-back-to-login"
            type="button"
            class="font-semibold text-green-600 hover:text-green-700 dark:text-green-500 inline-flex items-center gap-1.5 hover:underline underline-offset-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al inicio de sesión
          </button>
        </p>
      </div>

      <!-- ── DIVISOR Y BOTÓN GOOGLE COMÚN ── -->
      <div id="google-auth-container">
        <div class="my-4 border-t border-stone-200 dark:border-stone-700"></div>

        <div>
          <button
            id="google-btn"
            type="button"
            class="w-full flex items-center justify-center gap-3 py-3.5 px-4 bg-stone-50 dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700/80 border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-200 font-semibold text-sm rounded-xl transition-all shadow-sm hover:shadow active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-green-500"
          >
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
              ></path>
            </svg>
            <span>Continuar con Google</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    let signIn: any;
    try {
      const authAstro = await import("auth-astro/client");
      signIn = authAstro.signIn;
    } catch(err) {
      console.error("No se pudo cargar auth-astro/client", err);
    }

  // Elementos de pestañas y contenedores
  const authTabsContainer = document.getElementById("auth-tabs-container")!;
  const tabLoginBtn = document.getElementById("tab-login-btn") as HTMLButtonElement;
  const tabRegisterBtn = document.getElementById("tab-register-btn") as HTMLButtonElement;
  const authTabIndicator = document.getElementById("auth-tab-indicator")!;
  const TAB_BASE = "relative z-10 flex-1 py-2.5 px-4 text-sm rounded-xl transition-colors";
  const linkToRegister = document.getElementById("link-to-register");
  const linkToLogin = document.getElementById("link-to-login");
  const forgotPasswordLink = document.getElementById("forgot-password-link");
  const linkForgotBackToLogin = document.getElementById("link-forgot-back-to-login");
  const authTitle = document.getElementById("auth-title")!;
  const authSubtitle = document.getElementById("auth-subtitle")!;
  const googleAuthContainer = document.getElementById("google-auth-container")!;

    // Formularios
    const loginForm = document.getElementById("login-form") as HTMLFormElement;
    const registerForm = document.getElementById("register-form") as HTMLFormElement;
    const forgotContainer = document.getElementById("forgot-container") as HTMLDivElement;
    const forgotStep1Form = document.getElementById("forgot-step1-form") as HTMLFormElement;
    const forgotStep2Form = document.getElementById("forgot-step2-form") as HTMLFormElement;

    // Botones y estados de login
    const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text")!;
    const btnSpinner = document.getElementById("btn-spinner")!;
    const errorMsg = document.getElementById("error-message") as HTMLElement;

    // Botones y estados de registro
    const registerBtn = document.getElementById("register-btn") as HTMLButtonElement;
    const regBtnText = document.getElementById("reg-btn-text")!;
    const regBtnSpinner = document.getElementById("reg-btn-spinner")!;
    const regFeedbackMsg = document.getElementById("reg-feedback-message") as HTMLElement;

  // Pasos del registro
  const regStep1 = document.getElementById("reg-step-1") as HTMLElement | null;
  const regStep2 = document.getElementById("reg-step-2") as HTMLElement | null;
  const regNextBtn = document.getElementById("reg-next-btn");
  const regBackBtn = document.getElementById("reg-back-btn");
  const regStepLabel = document.getElementById("reg-step-label");
  const regDots = document.querySelectorAll<HTMLElement>("#register-form .reg-dot");

  let currentRegStep: 1 | 2 = 1;

  function showRegStep(step: 1 | 2, animate = true) {
    if (!regStep1 || !regStep2) return;
    regStep1.classList.toggle("hidden", step !== 1);
    regStep2.classList.toggle("hidden", step !== 2);
    regDots.forEach((dot, i) => {
      const on = i < step;
      dot.classList.toggle("bg-green-600", on);
      dot.classList.toggle("bg-stone-200", !on);
      dot.classList.toggle("dark:bg-stone-700", !on);
    });
    if (regStepLabel) regStepLabel.textContent = step === 1 ? "Paso 1 de 2" : "Paso 2 de 2";
    regFeedbackMsg.classList.add("hidden");
    if (animate) {
      const dir: 1 | -1 = step >= currentRegStep ? -1 : 1;
      animateAuthIn(step === 1 ? regStep1 : regStep2, dir);
    }
    currentRegStep = step;
  }

  // Botones y estados de recuperación
  const btnForgotSend = document.getElementById("btn-forgot-send") as HTMLButtonElement;
  const btnForgotSendText = document.getElementById("btn-forgot-send-text")!;
  const btnForgotSendSpinner = document.getElementById("btn-forgot-send-spinner")!;
  const btnForgotReset = document.getElementById("btn-forgot-reset") as HTMLButtonElement;
  const btnForgotResetText = document.getElementById("btn-forgot-reset-text")!;
  const btnForgotResetSpinner = document.getElementById("btn-forgot-reset-spinner")!;
  const forgotFeedbackMsg = document.getElementById("forgot-feedback-message") as HTMLElement;
  const forgotStep2Desc = document.getElementById("forgot-step2-desc")!;

    let activeForgotIdentifier = "";

    // Botón Google
    const googleBtn = document.getElementById("google-btn") as HTMLButtonElement;

  // Video y controles
  const welcomeVideo = document.getElementById("welcome-video") as HTMLVideoElement;
  const audioToggleBtn = document.getElementById("audio-toggle-btn");
  const iconMuted = document.getElementById("icon-muted");
  const iconUnmuted = document.getElementById("icon-unmuted");

  // Mostrar / ocultar contraseña en Login
  const togglePasswordBtn = document.getElementById("toggle-password-btn");
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const eyeShow = document.getElementById("eye-show");
  const eyeHide = document.getElementById("eye-hide");

  if (togglePasswordBtn && passwordInput && eyeShow && eyeHide) {
    togglePasswordBtn.addEventListener("click", () => {
      const isPassword = passwordInput.type === "password";
      passwordInput.type = isPassword ? "text" : "password";
      eyeShow.classList.toggle("hidden", isPassword);
      eyeHide.classList.toggle("hidden", !isPassword);
    });
  }

  // Mostrar / ocultar contraseña en Registro
  const toggleRegPasswordBtn = document.getElementById("toggle-reg-password-btn");
  const regPasswordInput = document.getElementById("reg-password") as HTMLInputElement;
  const eyeRegShow = document.getElementById("eye-reg-show");
  const eyeRegHide = document.getElementById("eye-reg-hide");

  if (toggleRegPasswordBtn && regPasswordInput && eyeRegShow && eyeRegHide) {
    toggleRegPasswordBtn.addEventListener("click", () => {
      const isPassword = regPasswordInput.type === "password";
      regPasswordInput.type = isPassword ? "text" : "password";
      eyeRegShow.classList.toggle("hidden", isPassword);
      eyeRegHide.classList.toggle("hidden", !isPassword);
    });
  }

  // Mostrar / ocultar contraseña en Recuperación
  const toggleForgotPasswordBtn = document.getElementById("toggle-forgot-password-btn");
  const forgotNewPasswordInput = document.getElementById("forgot-new-password") as HTMLInputElement;
  const eyeForgotShow = document.getElementById("eye-forgot-show");
  const eyeForgotHide = document.getElementById("eye-forgot-hide");

  if (toggleForgotPasswordBtn && forgotNewPasswordInput && eyeForgotShow && eyeForgotHide) {
    toggleForgotPasswordBtn.addEventListener("click", () => {
      const isPassword = forgotNewPasswordInput.type === "password";
      forgotNewPasswordInput.type = isPassword ? "text" : "password";
      eyeForgotShow.classList.toggle("hidden", isPassword);
      eyeForgotHide.classList.toggle("hidden", !isPassword);
    });
  }

  // Audio video toggle
  if (audioToggleBtn && welcomeVideo && iconMuted && iconUnmuted) {
    audioToggleBtn.addEventListener("click", () => {
      welcomeVideo.muted = !welcomeVideo.muted;
      if (welcomeVideo.muted) {
        iconMuted.classList.remove("hidden");
        iconUnmuted.classList.add("hidden");
      } else {
        iconMuted.classList.add("hidden");
        iconUnmuted.classList.remove("hidden");
      }
    });
  }

  function animateAuthIn(el: HTMLElement, dir: 1 | -1 = 1) {
    el.style.setProperty("--auth-slide-from", dir >= 0 ? "18px" : "-18px");
    el.classList.remove("auth-anim-in");
    void el.offsetWidth;
    el.classList.add("auth-anim-in");
  }

  const MODE_RANK: Record<string, number> = { login: 0, register: 1, forgot: 2 };
  let currentMode = "login";

  // Función para cambiar de vista (Login / Registro / Recuperar Contraseña)
  function setAuthMode(mode: 'login' | 'register' | 'forgot') {
    const dir: 1 | -1 = (MODE_RANK[mode] ?? 1) >= (MODE_RANK[currentMode] ?? 0) ? -1 : 1;
    currentMode = mode;
    // Ocultar todos los formularios
    loginForm.classList.add("hidden");
    registerForm.classList.add("hidden");
    forgotContainer.classList.add("hidden");

    // Limpiar alertas
    errorMsg.classList.add("hidden");
    regFeedbackMsg.classList.add("hidden");
    forgotFeedbackMsg.classList.add("hidden");

    if (mode === 'login') {
      authTabsContainer.classList.remove("hidden");
      googleAuthContainer.classList.remove("hidden");
      loginForm.classList.remove("hidden");

      tabLoginBtn.className = `${TAB_BASE} font-bold text-stone-900 dark:text-white`;
      tabRegisterBtn.className = `${TAB_BASE} font-semibold text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200`;
      authTabIndicator.classList.remove("translate-x-full");
      authTitle.textContent = "Acceder al Sistema";
      authSubtitle.textContent = "Ingresa tus credenciales para continuar";

    } else if (mode === 'register') {
      authTabsContainer.classList.remove("hidden");
      googleAuthContainer.classList.remove("hidden");
      registerForm.classList.remove("hidden");
      showRegStep(1, false);

      tabRegisterBtn.className = `${TAB_BASE} font-bold text-stone-900 dark:text-white`;
      tabLoginBtn.className = `${TAB_BASE} font-semibold text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200`;
      authTabIndicator.classList.add("translate-x-full");
      authTitle.textContent = "Crear Cuenta Nueva";
      authSubtitle.textContent = "Regístrate para monitorear tu invernadero inteligente";

    } else if (mode === 'forgot') {
      authTabsContainer.classList.add("hidden");
      googleAuthContainer.classList.add("hidden");
      forgotContainer.classList.remove("hidden");
      forgotStep1Form.classList.remove("hidden");
      forgotStep2Form.classList.add("hidden");

      authTitle.textContent = "Recuperar Contraseña";
      authSubtitle.textContent = "Te enviaremos un código temporal para restablecer tu clave";
    }

    const activePanel = mode === 'login' ? loginForm : mode === 'register' ? registerForm : forgotContainer;
    animateAuthIn(activePanel, dir);
    if (authTitle.parentElement) animateAuthIn(authTitle.parentElement, dir);
  }

  tabLoginBtn?.addEventListener("click", () => setAuthMode('login'));
  tabRegisterBtn?.addEventListener("click", () => setAuthMode('register'));
  linkToRegister?.addEventListener("click", () => setAuthMode('register'));
  linkToLogin?.addEventListener("click", () => setAuthMode('login'));
  forgotPasswordLink?.addEventListener("click", () => setAuthMode('forgot'));
  linkForgotBackToLogin?.addEventListener("click", () => setAuthMode('login'));

  // Mostrar error si viene en los parámetros de la URL (?error=...)
  const urlParams = new URLSearchParams(window.location.search);
  const authError = urlParams.get('error');

  // Destino tras iniciar sesión (?desde=/invitar/XXXX). Solo rutas internas, evita open-redirect.
  const rawDesde = urlParams.get('desde') || '';
  const safeDesde = /^\/(?!\/)/.test(rawDesde) ? rawDesde : '/';
  if (authError && errorMsg) {
    if (authError === 'OAuthAccountNotLinked') {
      errorMsg.textContent = 'El correo ya está registrado con otro método de autenticación.';
    } else if (authError === 'OAuthCallbackError' || authError === 'OAuthSignin' || authError === 'Callback') {
      errorMsg.textContent = 'Hubo un problema al autenticar con Google. Intenta nuevamente.';
    } else if (authError === 'AccessDenied') {
      errorMsg.textContent = 'Acceso denegado con la cuenta de Google.';
    } else {
      errorMsg.textContent = `Error de autenticación (${authError}). Intenta nuevamente.`;
    }
    errorMsg.classList.remove('hidden');
  }

  function setLoginLoading(on: boolean) {
    if (loginBtn) loginBtn.disabled = on;
    if (googleBtn) googleBtn.disabled = on;
    if (btnText) btnText.textContent = on ? "Cargando…" : "Iniciar Sesión";
    if (btnSpinner) btnSpinner.classList.toggle("hidden", !on);
  }

  function setRegisterLoading(on: boolean) {
    if (registerBtn) registerBtn.disabled = on;
    if (googleBtn) googleBtn.disabled = on;
    if (regBtnText) regBtnText.textContent = on ? "Creando cuenta…" : "Crear Cuenta";
    if (regBtnSpinner) regBtnSpinner.classList.toggle("hidden", !on);
  }

  function setForgotSendLoading(on: boolean) {
    if (btnForgotSend) btnForgotSend.disabled = on;
    if (btnForgotSendText) btnForgotSendText.textContent = on ? "Enviando código…" : "Enviar Código de Seguridad";
    if (btnForgotSendSpinner) btnForgotSendSpinner.classList.toggle("hidden", !on);
  }

  function setForgotResetLoading(on: boolean) {
    if (btnForgotReset) btnForgotReset.disabled = on;
    if (btnForgotResetText) btnForgotResetText.textContent = on ? "Guardando…" : "Restablecer Contraseña";
    if (btnForgotResetSpinner) btnForgotResetSpinner.classList.toggle("hidden", !on);
  }

  // Reproducir el video de bienvenida y esperar antes de redirigir
  async function playWelcomeVideo() {
    try {
      if (welcomeVideo) {
        welcomeVideo.currentTime = 0;
        const playPromise = welcomeVideo.play();
        if (playPromise !== undefined) {
          playPromise.catch((err) => {
            console.warn("El navegador bloqueó el video:", err);
          });
        }
      }
    } catch (vidErr) {
      console.warn("No se pudo reiniciar el video:", vidErr);
    }

    try {
      await new Promise<void>((resolve) => {
        if (!welcomeVideo) return resolve();
        const timeout = setTimeout(() => {
          welcomeVideo.removeEventListener("ended", onEnded);
          resolve();
        }, 3500);

        const onEnded = () => {
          clearTimeout(timeout);
          resolve();
        };

        welcomeVideo.addEventListener("ended", onEnded, { once: true });
      });
    } catch (waitErr) {
      console.warn("Error esperando al video:", waitErr);
    }
  }

  // Login con Google
  if (googleBtn) {
    googleBtn.addEventListener("click", async () => {
      try {
        setLoginLoading(true);
        errorMsg.classList.add("hidden");
        regFeedbackMsg.classList.add("hidden");

        // Reproducir video antes de redirigir a Google
        try { await playWelcomeVideo(); } catch(e) {}

        await signIn("google", { callbackUrl: safeDesde } as any);
      } catch (err) {
        console.error(err);
        setLoginLoading(false);
        errorMsg.textContent = "Error al conectar con Google. Intenta nuevamente.";
        errorMsg.classList.remove("hidden");
        if (welcomeVideo) welcomeVideo.pause();
      }
    });
  }

  // Login con credenciales de la Base de Datos PostgreSQL
  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    try {
      errorMsg.classList.add("hidden");

      const username = (document.getElementById("username") as HTMLInputElement).value.trim();
      const password = (document.getElementById("password") as HTMLInputElement).value;

      if (!username || !password) {
        errorMsg.textContent = "Por favor ingresa tu correo o celular y contraseña.";
        errorMsg.classList.remove("hidden");
        return;
      }

      setLoginLoading(true);

      // Reproducir video de bienvenida
      try {
        await playWelcomeVideo();
      } catch (vidErr: any) {
        console.warn("Video no pudo reproducirse", vidErr);
      }
      
      let hasError = false;

      if (typeof signIn === 'function') {
        const result = await signIn("credentials", {
          email: username,
          password: password,
          redirect: false,
          callbackUrl: safeDesde,
        } as any);
        if ((result as any)?.error) hasError = true;
      } else {
        const csrfRes = await fetch('/api/auth/csrf');
        const csrfData = await csrfRes.json();
        
        const params = new URLSearchParams();
        params.append('csrfToken', csrfData.csrfToken);
        params.append('email', username);
        params.append('password', password);
        params.append('redirect', 'false');
        params.append('callbackUrl', safeDesde);
        params.append('json', 'true');

        const authRes = await fetch('/api/auth/callback/credentials', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params
        });

        // fetch sigue automáticamente las redirecciones (302).
        // Si hay error, la URL final tendrá "?error=".
        if (authRes.url && authRes.url.includes('error=')) {
          hasError = true;
        }
      }

      if (hasError) {
        setLoginLoading(false);
        errorMsg.textContent = "Credenciales incorrectas. Verifica tus datos y contraseña.";
        errorMsg.classList.remove("hidden");
        if (welcomeVideo) welcomeVideo.pause();
      } else {
        window.location.href = safeDesde;
      }
    } catch (err: any) {
      console.error(err);
      setLoginLoading(false);
      errorMsg.textContent = "Error inesperado al iniciar sesión. Intenta nuevamente. " + (err?.message || "");
      errorMsg.classList.remove("hidden");
      alert("Error DETALLADO (Envíame esto por favor):\n" + (err?.message || String(err)) + "\n\n" + (err?.stack || ""));
      if (welcomeVideo) welcomeVideo.pause();
    }
  });

  const accountTypeInput = document.getElementById("reg-account-type") as HTMLInputElement | null;
  const fincaNombreGroup = document.getElementById("reg-finconombre-group");
  const accountTypeBtns = document.querySelectorAll<HTMLButtonElement>("#reg-account-type-toggle .seg-btn");
  accountTypeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      accountTypeBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      if (accountTypeInput) accountTypeInput.value = btn.dataset.value || "Campesino";
      fincaNombreGroup?.classList.toggle("hidden", btn.dataset.value !== "Agropecuario");
    });
  });

  function regError(msg: string) {
    regFeedbackMsg.textContent = msg;
    regFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
    regFeedbackMsg.classList.remove("hidden");
  }

  function validateRegStep1(): boolean {
    const name = (document.getElementById("reg-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("reg-email") as HTMLInputElement).value.trim();
    const phone = (document.getElementById("reg-phone") as HTMLInputElement).value.trim();
    const birthDate = (document.getElementById("reg-birthdate") as HTMLInputElement).value;

    if (!name) { regError("Por favor ingresa tu nombre completo."); return false; }
    if (!email && !phone) { regError("Debes ingresar al menos tu correo electrónico o tu número celular."); return false; }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { regError("El correo electrónico no es válido. Ejemplo: nombre@correo.com"); return false; }
    if (phone && !/^\+?\d{7,15}$/.test(phone.replace(/[\s\-().]/g, ""))) { regError("El número de celular no es válido. Ejemplo: 3001234567"); return false; }
    if (birthDate && (birthDate > new Date().toISOString().slice(0, 10) || !/^\d{4}-\d{2}-\d{2}$/.test(birthDate))) { regError("La fecha de nacimiento no es válida."); return false; }
    return true;
  }

  // Navegación entre pasos del registro
  regNextBtn?.addEventListener("click", async () => {
    if (!validateRegStep1()) return;

    const email = (document.getElementById("reg-email") as HTMLInputElement).value.trim();
    const phone = (document.getElementById("reg-phone") as HTMLInputElement).value.trim();
    const nextBtn = regNextBtn as HTMLButtonElement;

    if (email || phone) {
      nextBtn.disabled = true;
      nextBtn.classList.add("opacity-70", "cursor-wait");
      try {
        const res = await fetch("/api/auth/check-availability", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email || undefined, phone: phone || undefined }),
        });
        const data = await res.json();
        if (res.ok) {
          if (data.emailTaken) {
            regError("Este correo electrónico ya está registrado. Inicia sesión o usa otro correo.");
            return;
          }
          if (data.phoneTaken) {
            regError("Este número de celular ya está registrado. Inicia sesión o usa otro número.");
            return;
          }
        }
      } catch (err) {
        console.warn("No se pudo verificar la disponibilidad:", err);
      } finally {
        nextBtn.disabled = false;
        nextBtn.classList.remove("opacity-70", "cursor-wait");
      }
    }

    showRegStep(2);
  });
  regBackBtn?.addEventListener("click", () => showRegStep(1));

  // Registro de nuevo usuario (Rol Campesino)
  registerForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    regFeedbackMsg.classList.add("hidden");

    if (!validateRegStep1()) {
      showRegStep(1);
      return;
    }

    const name = (document.getElementById("reg-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("reg-email") as HTMLInputElement).value.trim();
    const phone = (document.getElementById("reg-phone") as HTMLInputElement).value.trim();
    const birthDate = (document.getElementById("reg-birthdate") as HTMLInputElement).value;
    const password = (document.getElementById("reg-password") as HTMLInputElement).value;
    const accountType = (document.getElementById("reg-account-type") as HTMLInputElement)?.value || "Campesino";
    const fincaNombre = (document.getElementById("reg-finconombre") as HTMLInputElement)?.value.trim() || "";

    if (!password || password.length < 8) {
      showRegStep(2);
      regError("La contraseña debe tener al menos 8 caracteres.");
      return;
    }

    if (accountType === "Agropecuario" && !fincaNombre) {
      showRegStep(2);
      regError("Ingresa el nombre de tu finca.");
      return;
    }

    setRegisterLoading(true);

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email: email || undefined,
          phone: phone || undefined,
          birthDate: birthDate || undefined,
          password,
          accountType,
          fincaNombre: fincaNombre || undefined,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        setRegisterLoading(false);
        regFeedbackMsg.textContent = data.message || "Error al crear la cuenta.";
        regFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
        regFeedbackMsg.classList.remove("hidden");
        return;
      }

      // Registro exitoso: Mostrar mensaje y auto-login
      const regExtra = data.fincaCreada
        ? ` Finca "${data.fincaCreada.nombre}" creada.`
        : "";
      regFeedbackMsg.textContent = `¡Cuenta creada exitosamente!${regExtra} Iniciando sesión...`;
      regFeedbackMsg.className = "p-3 rounded-lg bg-emerald-50 text-sm text-emerald-700 text-center border border-emerald-200 font-medium dark:bg-emerald-900/20 dark:border-emerald-800 dark:text-emerald-400";
      regFeedbackMsg.classList.remove("hidden");

      // Reproducir video de bienvenida
      await playWelcomeVideo();

      // Iniciar sesión automáticamente
      const loginIdentifier = email || phone || name;
      await signIn("credentials", {
        email: loginIdentifier,
        password: password,
        redirect: false,
        callbackUrl: safeDesde,
      } as any);

      window.location.href = safeDesde;

    } catch (err) {
      console.error(err);
      setRegisterLoading(false);
      regFeedbackMsg.textContent = "Error inesperado al crear la cuenta. Intenta nuevamente.";
      regFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      regFeedbackMsg.classList.remove("hidden");
      if (welcomeVideo) welcomeVideo.pause();
    }
  });

  // Recuperación de Contraseña - Paso 1: Solicitar Código
  forgotStep1Form.addEventListener("submit", async (e) => {
    e.preventDefault();
    forgotFeedbackMsg.classList.add("hidden");

    const identifier = (document.getElementById("forgot-identifier") as HTMLInputElement).value.trim();

    if (!identifier) {
      forgotFeedbackMsg.textContent = "Por favor ingresa tu correo electrónico o tu número celular.";
      forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      forgotFeedbackMsg.classList.remove("hidden");
      return;
    }

    setForgotSendLoading(true);

    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier }),
      });

      const data = await res.json();

      if (!res.ok) {
        setForgotSendLoading(false);
        forgotFeedbackMsg.textContent = data.message || "No se pudo procesar la solicitud.";
        forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
        forgotFeedbackMsg.classList.remove("hidden");
        return;
      }

      activeForgotIdentifier = data.identifier || identifier;
      setForgotSendLoading(false);

      forgotStep1Form.classList.add("hidden");
      forgotStep2Form.classList.remove("hidden");
      forgotStep2Desc.textContent = data.message || "Hemos enviado un código de 6 dígitos. Ingrésalo a continuación para crear tu nueva clave.";
      forgotFeedbackMsg.classList.add("hidden");

    } catch (err) {
      console.error(err);
      setForgotSendLoading(false);
      forgotFeedbackMsg.textContent = "Error al solicitar el código. Intenta nuevamente.";
      forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      forgotFeedbackMsg.classList.remove("hidden");
    }
  });

  // Recuperación de Contraseña - Paso 2: Verificar Código y Restablecer
  forgotStep2Form.addEventListener("submit", async (e) => {
    e.preventDefault();
    forgotFeedbackMsg.classList.add("hidden");

    const code = (document.getElementById("forgot-code") as HTMLInputElement).value.trim();
    const newPassword = (document.getElementById("forgot-new-password") as HTMLInputElement).value;

    if (!code || code.length !== 6) {
      forgotFeedbackMsg.textContent = "Por favor ingresa el código numérico de 6 dígitos.";
      forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      forgotFeedbackMsg.classList.remove("hidden");
      return;
    }

    if (!newPassword || newPassword.length < 6) {
      forgotFeedbackMsg.textContent = "La nueva contraseña debe tener al menos 6 caracteres.";
      forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      forgotFeedbackMsg.classList.remove("hidden");
      return;
    }

    setForgotResetLoading(true);

    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          identifier: activeForgotIdentifier,
          code,
          newPassword,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        setForgotResetLoading(false);
        forgotFeedbackMsg.textContent = data.message || "Error al restablecer la contraseña.";
        forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
        forgotFeedbackMsg.classList.remove("hidden");
        return;
      }

      // Restablecimiento exitoso: Regresar a Login y mostrar confirmación
      setForgotResetLoading(false);
      setAuthMode('login');

      errorMsg.textContent = "¡Contraseña actualizada con éxito! Ya puedes iniciar sesión con tu nueva clave.";
      errorMsg.className = "p-3 rounded-lg bg-emerald-50 text-sm text-emerald-700 text-center border border-emerald-200 font-medium dark:bg-emerald-900/20 dark:border-emerald-800 dark:text-emerald-400";
      errorMsg.classList.remove("hidden");

    } catch (err) {
      console.error(err);
      setForgotResetLoading(false);
      forgotFeedbackMsg.textContent = "Error al restablecer la contraseña. Intenta nuevamente.";
      forgotFeedbackMsg.className = "p-3 rounded-lg bg-red-50 text-sm text-red-600 text-center border border-red-100 font-medium dark:bg-red-900/20 dark:border-red-800 dark:text-red-400";
      forgotFeedbackMsg.classList.remove("hidden");
    }
  });

  }); // fin DOMContentLoaded
</script>

