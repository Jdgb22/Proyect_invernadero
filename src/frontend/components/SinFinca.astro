---
interface Props {
  tieneFincas?: boolean;
}

const { tieneFincas = false } = Astro.props;
---

<div class="max-w-3xl mx-auto px-4 py-16">
  <div class="bg-white dark:bg-stone-800 rounded-2xl shadow-sm border border-stone-200 dark:border-stone-700 p-6 sm:p-10 text-center">
    <div class="text-6xl mb-4">🌾</div>
    <h1 class="text-2xl font-bold text-green-950 dark:text-white mb-2">
      No tienes una finca activa
    </h1>
    <p class="text-stone-500 dark:text-stone-400 mb-6 max-w-md mx-auto">
      Las métricas, el historial y los datos agronómicos se guardan por finca.
      {
        tieneFincas
          ? "Selecciona una finca en el menú superior para empezar a trabajar."
          : "Crea tu primera finca o únete con un código de invitación."
      }
    </p>
    <a
      href="/fincas"
      class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-sm transition-colors"
    >
      {tieneFincas ? "Ir a mis fincas" : "Crear o unirme a una finca"}
    </a>
  </div>
</div>
