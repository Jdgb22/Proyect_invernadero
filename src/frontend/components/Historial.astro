    // 9. RENDERIZADO DEL GRÁFICO DE EVOLUCIÓN HISTÓRICA (SVG)
    function renderEvolutionChart() {
      if (!evolutionSvg) return;
      evolutionSvg.innerHTML = "";

      const dates = getAvailableDates().reverse(); // antiguo a reciente para la gráfica
      if (dates.length < 1) return;

      const metricType = state.activeChartMetric; // 'ph' | 'temp' | 'growth'

      // Calcular promedio por fecha
      const dataPoints = dates.map((d) => {
        const records = state.allRecords.filter((r) => r.fecha === d);
        if (records.length === 0) return { date: d, value: 0 };
        let sum = 0;
        if (metricType === "ph")
          sum = records.reduce((a, b) => a + b.phSuelo, 0);
        else if (metricType === "temp")
          sum = records.reduce((a, b) => a + b.tempInterna, 0);
        else sum = records.reduce((a, b) => a + b.crecimiento, 0);
        return {
          date: d,
          value: +(sum / records.length).toFixed(1),
        };
      });

      const width = 700;
      const height = 180;
      const paddingX = 60;
      const paddingY = 30;

      // Escalas min y max según métrica
      let minVal = metricType === "ph" ? 5.0 : metricType === "temp" ? 18.0 : 0;
      let maxVal =
        metricType === "ph" ? 7.5 : metricType === "temp" ? 32.0 : 100;

      const valRange = maxVal - minVal || 1;
      const stepX = (width - paddingX * 2) / Math.max(1, dataPoints.length - 1);

      const points = dataPoints.map((dp, i) => {
        const x = paddingX + i * stepX;
        const normalized = (dp.value - minVal) / valRange;
        const y = height - paddingY - normalized * (height - paddingY * 2);
        return { x, y, dp };
      });

      // Fondo de líneas de cuadrícula
      for (let g = 0; g <= 4; g++) {
        const lineY = paddingY + (g * (height - paddingY * 2)) / 4;
        const gridVal = (maxVal - (g * valRange) / 4).toFixed(1);

        const line = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "line",
        );
        line.setAttribute("x1", paddingX.toString());
        line.setAttribute("y1", lineY.toString());
        line.setAttribute("x2", (width - paddingX).toString());
        line.setAttribute("y2", lineY.toString());
        line.setAttribute("stroke", "#4B5563");
        line.setAttribute("stroke-opacity", "0.2");
        line.setAttribute("stroke-dasharray", "4 4");
        evolutionSvg.appendChild(line);

        const text = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        text.setAttribute("x", (paddingX - 10).toString());
        text.setAttribute("y", (lineY + 4).toString());
        text.setAttribute("text-anchor", "end");
        text.setAttribute("fill", "#9CA3AF");
        text.setAttribute("font-size", "10");
        text.setAttribute("font-family", "monospace");
        text.textContent =
          gridVal +
          (metricType === "ph" ? " pH" : metricType === "temp" ? "°" : "%");
        evolutionSvg.appendChild(text);
      }

      // Trazar línea de tendencia
      if (points.length > 1) {
        let pathD = `M ${points[0].x} ${points[0].y}`;
        for (let p = 1; p < points.length; p++) {
          pathD += ` L ${points[p].x} ${points[p].y}`;
        }

        const path = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "path",
        );
        path.setAttribute("d", pathD);
        path.setAttribute("fill", "none");
        path.setAttribute(
          "stroke",
          metricType === "ph"
            ? "#3B82F6"
            : metricType === "temp"
              ? "#F59E0B"
              : "#10B981",
        );
        path.setAttribute("stroke-width", "3");
        path.setAttribute("stroke-linecap", "round");
        path.setAttribute("stroke-linejoin", "round");
        evolutionSvg.appendChild(path);
      }

      // Puntos y etiquetas de fecha
      points.forEach((pt) => {
        const isSelected = pt.dp.date === state.selectedDate;

        // Círculo
        const circle = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "circle",
        );
        circle.setAttribute("cx", pt.x.toString());
        circle.setAttribute("cy", pt.y.toString());
        circle.setAttribute("r", isSelected ? "6" : "4");
        circle.setAttribute("fill", isSelected ? "#4F46E5" : "#FFFFFF");
        circle.setAttribute(
          "stroke",
          metricType === "ph"
            ? "#3B82F6"
            : metricType === "temp"
              ? "#F59E0B"
              : "#10B981",
        );
        circle.setAttribute("stroke-width", "2");
        circle.setAttribute(
          "class",
          "cursor-pointer hover:scale-125 transition-transform",
        );

        circle.addEventListener("click", () => {
          state.selectedDate = pt.dp.date;
          if (datePicker) datePicker.value = pt.dp.date;
          updateAllViews();
        });

        evolutionSvg.appendChild(circle);

        // Valor arriba del punto
        const valText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        valText.setAttribute("x", pt.x.toString());
        valText.setAttribute("y", (pt.y - 10).toString());
        valText.setAttribute("text-anchor", "middle");
        valText.setAttribute("fill", isSelected ? "#4F46E5" : "#D1D5DB");
        valText.setAttribute("font-size", "10");
        valText.setAttribute("font-weight", "bold");
        valText.textContent = pt.dp.value.toString();
        evolutionSvg.appendChild(valText);

        // Etiqueta de fecha abajo
        const dateText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        dateText.setAttribute("x", pt.x.toString());
        dateText.setAttribute("y", (height - 10).toString());
        dateText.setAttribute("text-anchor", "middle");
        dateText.setAttribute("fill", isSelected ? "#4F46E5" : "#9CA3AF");
        dateText.setAttribute("font-size", "10");
        dateText.setAttribute("font-weight", isSelected ? "bold" : "normal");

        const parts = pt.dp.date.split("-");
        dateText.textContent =
          parts.length === 3 ? `${parts[2]}/${parts[1]}` : pt.dp.date;
        evolutionSvg.appendChild(dateText);
      });
    }

    // 10. RENDERIZADO DE LA TABLA DE REGISTROS
    function renderTable() {
      if (!tableBody) return;
      tableBody.innerHTML = "";

      const filtered = getFilteredRecords();

      if (tableCounter) {
        tableCounter.textContent = `Mostrando ${filtered.length} de ${state.allRecords.length} mediciones registradas.`;
      }

      if (filtered.length === 0) {
        if (tableEmptyState) tableEmptyState.classList.remove("hidden");
        return;
      }

      if (tableEmptyState) tableEmptyState.classList.add("hidden");

      filtered.forEach((record) => {
        const tr = document.createElement("tr");
        tr.className =
          "hover:bg-green-50/80 dark:hover:bg-green-700/40 transition-colors";

        const phBadgeColor =
          record.phSuelo >= 6.0 && record.phSuelo <= 6.8
            ? "bg-lime-100 text-lime-800 dark:bg-lime-950/60 dark:text-lime-300 border-lime-300"
            : record.phSuelo >= 5.5 && record.phSuelo <= 7.2
              ? "bg-green-100 text-green-800 dark:bg-stone-950/60 dark:text-stone-300 border-green-300"
              : "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-300";

        const sanidadBadge =
          record.sanidad === "Excelente" || record.sanidad === "Saludable"
            ? "bg-lime-100 text-lime-800 dark:bg-lime-950/60 dark:text-lime-300 border-lime-200"
            : record.sanidad === "Vulnerable"
              ? "bg-green-100 text-green-800 dark:bg-stone-950/60 dark:text-stone-300 border-green-200"
              : "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200";

        tr.innerHTML = `
          <td class="px-4 py-3 whitespace-nowrap font-mono">
            <span class="font-bold text-green-950 dark:text-white block">${record.fecha}</span>
            <span class="text-[10px] text-green-400">${record.hora}</span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <span class="font-black text-green-600 dark:text-stone-400 block">${record.plantId}</span>
            <span class="text-[10px] text-green-600 dark:text-stone-400">${record.fila} • ${record.columna}</span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-green-800 dark:text-stone-300">
            ${record.faseCrecimiento}
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono">
            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold border ${phBadgeColor}">
              ${record.phSuelo.toFixed(2)} pH
            </span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono font-bold text-green-900 dark:text-stone-300">
            ${record.tempInterna.toFixed(1)}°C
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono text-green-700 dark:text-stone-400">
            ${record.tempSuelo.toFixed(1)}°C
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <div class="flex items-center gap-1.5">
              <span class="font-mono font-bold text-lime-600 dark:text-lime-400">${record.crecimiento}%</span>
              <div class="w-12 bg-green-200 dark:bg-stone-700 rounded-full h-1.5 overflow-hidden">
                <div class="bg-lime-500 h-1.5 rounded-full" style="width: ${record.crecimiento}%"></div>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${sanidadBadge}">
              ${record.sanidad}
            </span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-green-800 dark:text-stone-300">
            <div class="flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full ${record.avatarColor || "bg-green-600"} text-white text-[9px] font-bold flex items-center justify-center">
                ${record.responsable.charAt(0)}
              </span>
              <span class="text-xs truncate max-w-[120px]" title="${record.responsable}">${record.responsable}</span>
            </div>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-right">
            <button
              type="button"
              class="btn-row-detail px-3 py-1 rounded-lg bg-green-50 dark:bg-stone-950/50 hover:bg-green-100 text-green-700 dark:text-stone-300 text-xs font-bold transition-all cursor-pointer"
            >
              Detalle
            </button>
          </td>
        `;

        const btnDetail = tr.querySelector(".btn-row-detail");
        btnDetail?.addEventListener("click", () => {
          openPlantDetailModal(record);
        });

        tableBody.appendChild(tr);
      });
    }

    // 11. MODAL DETALLE DE PLANTA
    function openPlantDetailModal(metric) {
      if (!modalPlant) return;

      const modalIcon = document.getElementById("modal-plant-icon");
      const modalId = document.getElementById("modal-plant-id");
      const modalLocation = document.getElementById("modal-plant-location");
      const modalDate = document.getElementById("modal-plant-date");

      const modalValPh = document.getElementById("modal-val-ph");
      const modalBadgePh = document.getElementById("modal-badge-ph");
      const modalValTin = document.getElementById("modal-val-tin");
      const modalValTsoil = document.getElementById("modal-val-tsoil");
      const modalValGrowth = document.getElementById("modal-val-growth");
      const modalBadgeSanidad = document.getElementById("modal-badge-sanidad");
      const modalBadgeProd = document.getElementById("modal-badge-prod");
      const modalValResp = document.getElementById("modal-val-resp");
      const modalValObs = document.getElementById("modal-val-obs");
      const modalDeltaContent = document.getElementById("modal-delta-content");

      if (modalId) modalId.textContent = metric.plantId;
      if (modalLocation)
        modalLocation.textContent = `Fila ${metric.fila} • ${metric.columna}`;
      if (modalDate)
        modalDate.textContent = `Medición registrada: ${metric.fecha}, ${metric.hora}`;

      if (modalValPh)
        modalValPh.textContent = `${metric.phSuelo.toFixed(2)} pH`;
      if (modalValTin)
        modalValTin.textContent = `${metric.tempInterna.toFixed(1)}°C`;
      if (modalValTsoil)
        modalValTsoil.textContent = `${metric.tempSuelo.toFixed(1)}°C`;
      if (modalValGrowth) modalValGrowth.textContent = `${metric.crecimiento}%`;

      if (modalBadgePh) {
        if (metric.phSuelo >= 6.0 && metric.phSuelo <= 6.8) {
          modalBadgePh.textContent = "Óptimo (6.0 - 6.8)";
          modalBadgePh.className =
            "text-[9px] font-bold text-lime-600 dark:text-lime-400 block mt-0.5";
        } else {
          modalBadgePh.textContent = "Requiere Atención";
          modalBadgePh.className =
            "text-[9px] font-bold text-green-600 dark:text-stone-400 block mt-0.5";
        }
      }

      if (modalBadgeSanidad) {
        modalBadgeSanidad.textContent = `${metric.sanidad}`;
      }

      if (modalBadgeProd) {
        modalBadgeProd.textContent = `Productividad: ${metric.productividad}`;
      }

      if (modalValResp)
        modalValResp.textContent = `Registrado por: ${metric.responsable}`;
      if (modalValObs)
        modalValObs.textContent =
          metric.observaciones || "Condiciones agronómicas normales.";

      // Calcular comparación con la medición anterior de esta misma planta
      const plantHistory = state.allRecords
        .filter((r) => r.plantId === metric.plantId && r.fecha < metric.fecha)
        .sort((a, b) => b.fecha.localeCompare(a.fecha));

      if (modalDeltaContent) {
        if (plantHistory.length > 0) {
          const prev = plantHistory[0];
          const deltaPh = +(metric.phSuelo - prev.phSuelo).toFixed(2);
          const deltaTin = +(metric.tempInterna - prev.tempInterna).toFixed(1);
          const deltaGrowth = metric.crecimiento - prev.crecimiento;

          modalDeltaContent.innerHTML = `
            <div>
              <span class="text-green-600 dark:text-stone-400 block">pH Suelo</span>
              <span class="font-bold ${deltaPh > 0 ? "text-green-600" : "text-lime-600"}">${deltaPh > 0 ? "+" : ""}${deltaPh}</span>
            </div>
            <div>
              <span class="text-green-600 dark:text-stone-400 block">Temp Interna</span>
              <span class="font-bold ${deltaTin > 0 ? "text-green-600" : "text-blue-600"}">${deltaTin > 0 ? "+" : ""}${deltaTin}°C</span>
            </div>
            <div>
              <span class="text-green-600 dark:text-stone-400 block">Crecimiento</span>
              <span class="font-bold text-lime-600">${deltaGrowth >= 0 ? "+" : ""}${deltaGrowth}%</span>
            </div>
          `;
        } else {
          modalDeltaContent.innerHTML = `
            <div class="col-span-3 text-green-600 dark:text-stone-400 italic">
              Esta es la primera toma registrada para esta planta en el historial.
            </div>
          `;
        }
      }

      modalPlant.classList.remove("hidden");
    }

    modalPlantCloseBtn?.addEventListener("click", () =>
      modalPlant?.classList.add("hidden"),
    );
    modalPlantOkBtn?.addEventListener("click", () =>
      modalPlant?.classList.add("hidden"),
    );

    // 12. ACTUALIZAR TODAS LAS VISTAS
    function updateAllViews() {
      renderQuickDateChips();
      renderSummaryKPIs();
      renderPlantGrid();
      renderEvolutionChart();
      renderTable();
    }

    // Eventos de Filtro
    datePicker?.addEventListener("change", (e) => {
      state.selectedDate = e.target.value;
      updateAllViews();
    });

    filterFila?.addEventListener("change", (e) => {
      state.selectedFila = e.target.value;
      renderTable();
    });

    filterPlanta?.addEventListener("change", (e) => {
      state.selectedPlanta = e.target.value;
      renderTable();
    });

    filterSanidad?.addEventListener("change", (e) => {
      state.selectedSanidad = e.target.value;
      renderTable();
    });

    searchInput?.addEventListener("input", (e) => {
      state.searchQuery = e.target.value;
      renderTable();
    });

    btnResetFilters?.addEventListener("click", () => {
      state.selectedFila = "all";
      state.selectedPlanta = "all";
      state.selectedSanidad = "all";
      state.searchQuery = "";
      if (filterFila) filterFila.value = "all";
      if (filterPlanta) filterPlanta.value = "all";
      if (filterSanidad) filterSanidad.value = "all";
      if (searchInput) searchInput.value = "";
      renderTable();
    });

    // Cambiar métrica de la gráfica
    btnChartPh?.addEventListener("click", () => {
      state.activeChartMetric = "ph";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    btnChartTemp?.addEventListener("click", () => {
      state.activeChartMetric = "temp";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    btnChartGrowth?.addEventListener("click", () => {
      state.activeChartMetric = "growth";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    // 13. LOGICA DEL MODAL CARGAR ARCHIVO
    btnOpenUpload?.addEventListener("click", () => {
      modalUpload?.classList.remove("hidden");
      state.pendingUploadRows = [];
      if (uploadPreviewContainer)
        uploadPreviewContainer.classList.add("hidden");
      if (modalUploadConfirmBtn) {
        modalUploadConfirmBtn.disabled = true;
        modalUploadConfirmBtn.classList.add("opacity-50", "cursor-not-allowed");
      }
    });

    modalUploadCloseBtn?.addEventListener("click", () =>
      modalUpload?.classList.add("hidden"),
    );
    modalUploadCancelBtn?.addEventListener("click", () =>
      modalUpload?.classList.add("hidden"),
    );

    dropZone?.addEventListener("click", () => fileInput?.click());

    dropZone?.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropZone.classList.add("border-green-600", "bg-green-100/50");
    });

    dropZone?.addEventListener("dragleave", () => {
      dropZone.classList.remove("border-green-600", "bg-green-100/50");
    });

    dropZone?.addEventListener("drop", (e) => {
      e.preventDefault();
      dropZone.classList.remove("border-green-600", "bg-green-100/50");
      if (e.dataTransfer?.files?.length) {
        processUploadedFile(e.dataTransfer.files[0]);
      }
    });

    fileInput?.addEventListener("change", (e) => {
      if (e.target.files?.length) {
        processUploadedFile(e.target.files[0]);
      }
    });

    // Parser local para archivos subidos por el usuario
    function processUploadedFile(file) {
      const reader = new FileReader();
      reader.onload = (evt) => {
        const text = evt.target?.result;
        if (typeof text !== "string") return;

        const lines = text.split(/\r?\n/).filter((l) => l.trim().length > 0);
        if (lines.length < 2) {
          showToast("El archivo no contiene filas de datos válidas", "⚠️");
          return;
        }

        const delimiter = lines[0].includes(";") ? ";" : ",";
        const headers = lines[0]
          .split(delimiter)
          .map((h) => h.trim().toLowerCase());

        const parsed = [];
        const todayStr = new Date().toISOString().slice(0, 10);

        for (let i = 1; i < lines.length; i++) {
          const cols = lines[i]
            .split(delimiter)
            .map((c) => c.trim().replace(/^"|"$/g, ""));
          if (cols.length < 3) continue;

          // Intento de mapeo flexible
          const plantId = cols[0] || `P-01`;
          const fecha =
            cols[1] && /^\d{4}-\d{2}-\d{2}$/.test(cols[1]) ? cols[1] : todayStr;
          const ph = parseFloat(cols[2]?.replace(",", ".")) || 6.4;
          const tin = parseFloat(cols[3]?.replace(",", ".")) || 24.5;
          const growth = parseInt(cols[4], 10) || 80;
          const sanidad = cols[5] || "Saludable";

          // Deduzco fila y columna del ID de planta
          const pNum = parseInt(plantId.replace(/\D/g, ""), 10) || 1;
          const fIdx = Math.min(3, Math.floor((pNum - 1) / 5));
          const cIdx = Math.min(4, (pNum - 1) % 5);
          const fila = ["t0", "t1", "t2", "t3"][fIdx];
          const col = ["Col 1", "Col 2", "Col 3", "Col 4", "Col 5"][cIdx];

          parsed.push({
            id: `MET-UPLOAD-${fila}-${col.replace(" ", "")}-${fecha}-${i}`,
            invernadero: "Invernadero AquaSens",
            fila,
            columna: col,
            plantId,
            fecha,
            hora: "09:00 AM",
            timestampTexto: `${fecha}, 09:00 AM`,
            phSuelo: ph,
            tempInterna: tin,
            tempExterna: 20.0,
            tempSuelo: 20.2,
            crecimiento: growth,
            faseCrecimiento: "Desarrollo Vegetativo",
            productividad: "Alta",
            sanidad: sanidad,
            responsable: "Operario de Archivo",
            responsableRol: "Carga Manual",
            avatarColor: "bg-green-600",
            observaciones: "Registro importado desde archivo local.",
          });
        }

        if (parsed.length === 0) {
          showToast("No se pudieron interpretar las filas del archivo", "⚠️");
          return;
        }

        state.pendingUploadRows = parsed;

        // Mostrar vista previa
        if (uploadPreviewContainer && uploadPreviewBody && uploadPreviewCount) {
          uploadPreviewCount.textContent = `${parsed.length} filas detectadas`;
          uploadPreviewBody.innerHTML = "";
          parsed.slice(0, 10).forEach((r) => {
            const row = document.createElement("tr");
            row.innerHTML = `
              <td class="p-2 font-bold">${r.plantId}</td>
              <td class="p-2">${r.fecha}</td>
              <td class="p-2">${r.phSuelo}</td>
              <td class="p-2">${r.tempInterna}°C</td>
              <td class="p-2">${r.crecimiento}%</td>
              <td class="p-2">${r.sanidad}</td>
            `;
            uploadPreviewBody.appendChild(row);
          });
          uploadPreviewContainer.classList.remove("hidden");
        }

        if (modalUploadConfirmBtn) {
          modalUploadConfirmBtn.disabled = false;
          modalUploadConfirmBtn.classList.remove(
            "opacity-50",
            "cursor-not-allowed",
          );
        }
      };
      reader.readAsText(file);
    }

    modalUploadConfirmBtn?.addEventListener("click", () => {
      if (state.pendingUploadRows.length === 0) return;

      saveCustomRecords(state.pendingUploadRows);
      state.allRecords = getAllCombinedRecords();

      // Cambiar a la fecha de las filas subidas
      const importedDate =
        state.pendingUploadRows[0]?.fecha || state.selectedDate;
      state.selectedDate = importedDate;
      if (datePicker) datePicker.value = importedDate;

      modalUpload?.classList.add("hidden");
      updateAllViews();
      showToast(
        `¡Se guardaron ${state.pendingUploadRows.length} registros exitosamente!`,
      );
    });

    // Descargar plantilla CSV de campo
    btnDownloadTemplate?.addEventListener("click", () => {
      const todayStr = new Date().toISOString().slice(0, 10);
      let csvContent =
        "Planta,Fecha,pH_Suelo,Temp_Interna,Crecimiento_Porcentaje,Sanidad,Responsable,Observaciones\n";

      for (let p = 1; p <= 20; p++) {
        const id = `P-${p < 10 ? "0" + p : p}`;
        csvContent += `${id},${todayStr},6.4,24.5,80,Saludable,Operario Campo,Condicion normal\n`;
      }

      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute(
        "download",
        `Plantilla_Mediciones_Invernadero_${todayStr}.csv`,
      );
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast(
        "Plantilla descargada. Llena los datos y súbela cuando desees.",
        "📄",
      );
    });

    // 14. LOGICA DEL MODAL GOOGLE SHEETS
    btnOpenSheets?.addEventListener("click", () => {
      modalSheets?.classList.remove("hidden");
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      if (savedUrl && inputSheetsUrl) {
        inputSheetsUrl.value = savedUrl;
      }
      if (sheetsSyncStatus) sheetsSyncStatus.classList.add("hidden");
    });

    modalSheetsCloseBtn?.addEventListener("click", () =>
      modalSheets?.classList.add("hidden"),
    );
    modalSheetsCancelBtn?.addEventListener("click", () =>
      modalSheets?.classList.add("hidden"),
    );

    async function syncGoogleSheets(urlToSync) {
      if (!urlToSync) return;

      if (sheetsSyncSpinner) sheetsSyncSpinner.classList.remove("hidden");
      if (sheetsSyncBtnText) sheetsSyncBtnText.textContent = "Sincronizando...";
      if (modalSheetsSyncBtn) modalSheetsSyncBtn.disabled = true;

      try {
        const res = await fetch("/api/sync-sheets", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url: urlToSync }),
        });

        const data = await res.json();

        if (data.success && data.records?.length > 0) {
          saveCustomRecords(data.records);
          state.allRecords = getAllCombinedRecords();

          localStorage.setItem(STORAGE_KEY_SHEETS_URL, urlToSync);
          const nowStr = new Date().toLocaleTimeString("es-CO", {
            hour: "2-digit",
            minute: "2-digit",
          });
          localStorage.setItem(STORAGE_KEY_LAST_SYNC, nowStr);

          // Actualizar banner
          checkSyncBanner();

          // Seleccionar fecha de los registros sincronizados
          const lastRecordDate = data.records[0]?.fecha;
          if (lastRecordDate) {
            state.selectedDate = lastRecordDate;
            if (datePicker) datePicker.value = lastRecordDate;
          }

          updateAllViews();

          if (sheetsSyncStatus) {
            sheetsSyncStatus.className =
              "p-3 rounded-xl text-xs font-bold bg-lime-100 text-lime-800 border border-lime-300";
            sheetsSyncStatus.textContent = `✅ ${data.message}`;
            sheetsSyncStatus.classList.remove("hidden");
          }

          setTimeout(() => {
            modalSheets?.classList.add("hidden");
            showToast(
              `¡Sincronizadas ${data.count} mediciones de Google Sheets!`,
              "🔗",
            );
          }, 1200);
        } else {
          if (sheetsSyncStatus) {
            sheetsSyncStatus.className =
              "p-3 rounded-xl text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
            sheetsSyncStatus.textContent = `❌ Error: ${data.error || "No se pudieron sincronizar los datos."}`;
            sheetsSyncStatus.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (sheetsSyncStatus) {
          sheetsSyncStatus.className =
            "p-3 rounded-xl text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
          sheetsSyncStatus.textContent = `❌ Error de red: ${err.message}`;
          sheetsSyncStatus.classList.remove("hidden");
        }
      } finally {
        if (sheetsSyncSpinner) sheetsSyncSpinner.classList.add("hidden");
        if (sheetsSyncBtnText)
          sheetsSyncBtnText.textContent = "Probar y Sincronizar";
        if (modalSheetsSyncBtn) modalSheetsSyncBtn.disabled = false;
      }
    }

    modalSheetsSyncBtn?.addEventListener("click", () => {
      const url = inputSheetsUrl?.value?.trim();
      if (!url) {
        if (sheetsSyncStatus) {
          sheetsSyncStatus.className =
            "p-3 rounded-xl text-xs font-bold bg-green-100 text-green-800 border border-green-300";
          sheetsSyncStatus.textContent =
            "⚠️ Ingresa la URL de tu Google Sheets antes de sincronizar.";
          sheetsSyncStatus.classList.remove("hidden");
        }
        return;
      }
      syncGoogleSheets(url);
    });

    // Banner Sync
    function checkSyncBanner() {
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      const lastSync = localStorage.getItem(STORAGE_KEY_LAST_SYNC);
      if (savedUrl && syncBanner) {
        syncBanner.classList.remove("hidden");
        syncBanner.classList.add("flex");
        if (syncLastUpdate && lastSync) {
          syncLastUpdate.textContent = `Última sincronización: Hoy a las ${lastSync}`;
        }
      }
    }

    btnSyncNowBanner?.addEventListener("click", () => {
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      if (savedUrl) {
        syncGoogleSheets(savedUrl);
      }
    });

    // 15. EXPORTAR HISTORIAL A EXCEL
    const btnExportHistory = document.getElementById("btn-export-history");
    btnExportHistory?.addEventListener("click", () => {
      // Redirigir al generador de Excel
      window.location.href = "/api/export-excel";
    });

    // INICIALIZACIÓN INMEDIATA
    checkSyncBanner();
    updateAllViews();
  });
</script>
