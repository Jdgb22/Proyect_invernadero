    // 5. RENDERIZADO DE CHIPS RÁPIDOS DE FECHA
    function renderQuickDateChips() {
      if (!quickChipsContainer) return;
      const dates = getAvailableDates();
      quickChipsContainer.innerHTML = "";

      const todayStr = new Date().toISOString().slice(0, 10);

      dates.slice(0, 4).forEach((d, idx) => {
        let label = d;
        if (d === todayStr) label = "📍 Hoy";
        else if (idx === 1 && dates[0] === todayStr) label = "Ayer";
        else {
          // Formatear día y mes
          const parts = d.split("-");
          if (parts.length === 3) {
            const dateObj = new Date(
              parseInt(parts[0]),
              parseInt(parts[1]) - 1,
              parseInt(parts[2]),
            );
            label = dateObj.toLocaleDateString("es-CO", {
              day: "numeric",
              month: "short",
            });
          }
        }

        const isSelected = state.selectedDate === d;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer ${
          isSelected
            ? "bg-green-600 text-white shadow-xs"
            : "bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 dark:hover:bg-green-600"
        }`;
        btn.textContent = label;
        btn.addEventListener("click", () => {
          state.selectedDate = d;
          if (datePicker) datePicker.value = d;
          updateAllViews();
        });
        quickChipsContainer.appendChild(btn);
      });

      // Opción: Ver Todo el Historial (Modo General)
      const isAllSelected = state.selectedDate === "all";
      const allBtn = document.createElement("button");
      allBtn.type = "button";
      allBtn.className = `px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer ${
        isAllSelected
          ? "bg-green-600 text-white shadow-xs"
          : "bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 dark:hover:bg-green-600"
      }`;
      allBtn.textContent = "🌐 Ver Todo";
      allBtn.addEventListener("click", () => {
        state.selectedDate = "all";
        if (datePicker) datePicker.value = "";
        updateAllViews();
      });
      quickChipsContainer.appendChild(allBtn);
    }

    // 6. FILTRAR REGISTROS
    function getFilteredRecords() {
      return state.allRecords.filter((r) => {
        // Fecha
        if (state.selectedDate !== "all" && r.fecha !== state.selectedDate) {
          return false;
        }
        // Fila
        if (state.selectedFila !== "all" && r.fila !== state.selectedFila) {
          return false;
        }
        // Planta
        if (
          state.selectedPlanta !== "all" &&
          r.plantId !== state.selectedPlanta
        ) {
          return false;
        }
        // Sanidad
        if (
          state.selectedSanidad !== "all" &&
          r.sanidad !== state.selectedSanidad
        ) {
          return false;
        }
        // Búsqueda de texto
        if (state.searchQuery.trim()) {
          const q = state.searchQuery.toLowerCase();
          const matchId = r.plantId.toLowerCase().includes(q);
          const matchResp = r.responsable.toLowerCase().includes(q);
          const matchObs = (r.observaciones || "").toLowerCase().includes(q);
          const matchFila = r.fila.toLowerCase().includes(q);
          if (!matchId && !matchResp && !matchObs && !matchFila) {
            return false;
          }
        }
        return true;
      });
    }

    // 7. RENDERIZADO DEL RESUMEN EJECUTIVO (KPIs)
    function renderSummaryKPIs() {
      const recordsForDate =
        state.selectedDate === "all"
          ? state.allRecords
          : state.allRecords.filter((r) => r.fecha === state.selectedDate);

      // Título de Fecha
      if (summaryDateTitle) {
        if (state.selectedDate === "all") {
          summaryDateTitle.textContent = "Histórico Global Consolidado";
          if (summaryDateSubtitle)
            summaryDateSubtitle.textContent = `Analizando ${state.allRecords.length} mediciones a lo largo de ${getAvailableDates().length} días registrados.`;
        } else {
          const parts = state.selectedDate.split("-");
          if (parts.length === 3) {
            const dateObj = new Date(
              parseInt(parts[0]),
              parseInt(parts[1]) - 1,
              parseInt(parts[2]),
            );
            summaryDateTitle.textContent = dateObj.toLocaleDateString("es-CO", {
              weekday: "long",
              year: "numeric",
              month: "long",
              day: "numeric",
            });
          } else {
            summaryDateTitle.textContent = state.selectedDate;
          }
          if (summaryDateSubtitle)
            summaryDateSubtitle.textContent =
              "Consolidado de variables agronómicas tomadas por el equipo de campo en esta fecha.";
        }
      }

      const total = recordsForDate.length;
      if (total === 0) {
        if (summaryCoverageCount) summaryCoverageCount.textContent = "0/20";
        if (kpiPh) kpiPh.textContent = "--";
        if (kpiTin) kpiTin.textContent = "--";
        if (kpiTsoil) kpiTsoil.textContent = "--";
        if (kpiGrowth) kpiGrowth.textContent = "--";
        if (kpiHealth) kpiHealth.textContent = "--";
        if (kpiHealthPlants) kpiHealthPlants.textContent = "0/20";
        return;
      }

      // Plantas únicas medidas
      const uniquePlants = new Set(recordsForDate.map((r) => r.plantId));
      if (summaryCoverageCount)
        summaryCoverageCount.textContent = `${uniquePlants.size}/20`;

      // Promedios
      const avgPh = +(
        recordsForDate.reduce((acc, r) => acc + r.phSuelo, 0) / total
      ).toFixed(2);
      const avgTin = +(
        recordsForDate.reduce((acc, r) => acc + r.tempInterna, 0) / total
      ).toFixed(1);
      const avgTsoil = +(
        recordsForDate.reduce((acc, r) => acc + r.tempSuelo, 0) / total
      ).toFixed(1);
      const avgGrowth = Math.round(
        recordsForDate.reduce((acc, r) => acc + r.crecimiento, 0) / total,
      );

      const healthyCount = recordsForDate.filter(
        (r) => r.sanidad === "Excelente" || r.sanidad === "Saludable",
      ).length;
      const healthyRatio = Math.round((healthyCount / total) * 100);

      if (kpiPh) kpiPh.textContent = avgPh.toString();
      if (kpiPhBadge) {
        if (avgPh >= 6.0 && avgPh <= 6.8) {
          kpiPhBadge.textContent = "● Rango Óptimo (6.0 - 6.8)";
          kpiPhBadge.className =
            "text-[10px] font-bold text-lime-300 block mt-1";
        } else if (avgPh >= 5.5 && avgPh <= 7.2) {
          kpiPhBadge.textContent = "▲ Atención Nutricional";
          kpiPhBadge.className =
            "text-[10px] font-bold text-green-300 block mt-1";
        } else {
          kpiPhBadge.textContent = "■ Crítico Fuera de Rango";
          kpiPhBadge.className =
            "text-[10px] font-bold text-rose-300 block mt-1";
        }
      }

      if (kpiTin) kpiTin.textContent = avgTin.toString();
      if (kpiTsoil) kpiTsoil.textContent = avgTsoil.toString();
      if (kpiGrowth) kpiGrowth.textContent = avgGrowth.toString();
      if (kpiHealth) kpiHealth.textContent = healthyRatio.toString();
      if (kpiHealthPlants)
        kpiHealthPlants.textContent = `${healthyCount}/${total} Saludables`;

      if (summaryHealthSemaphore) {
        if (healthyRatio >= 80) summaryHealthSemaphore.textContent = "🪴";
        else if (healthyRatio >= 60) summaryHealthSemaphore.textContent = "🌿";
        else summaryHealthSemaphore.textContent = "🥀";
      }
    }

