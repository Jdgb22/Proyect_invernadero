---
// src/frontend/components/Historial.astro
// Panel de Historial Agronómico Cronológico para Invernadero Macollo.
// Permite consultar mediciones por fecha específica, importar archivos (Excel/CSV)
// o sincronizar directamente con Google Sheets / Google Docs.

import {
  getAllMetrics,
  getAllPlantsGrid,
  type MetricRecord,
  type PlantMatrixItem,
  FILAS,
  COLUMNAS,
} from "../../backend/services/metricsData";

interface Props {
  currentUserName?: string;
  currentUserRole?: string;
}

const {
  currentUserName = "Administrador",
  currentUserRole = "Líder de Cultivo",
} = Astro.props;

// Dataset base inicial de mediciones
const allRecords: MetricRecord[] = getAllMetrics();
const allPlants: PlantMatrixItem[] = getAllPlantsGrid();

// Extraer fechas únicas ordenadas de más reciente a más antigua
const uniqueDates = Array.from(new Set(allRecords.map((r) => r.fecha))).sort(
  (a, b) => b.localeCompare(a),
);
const latestDate = uniqueDates[0] || new Date().toISOString().slice(0, 10);
---

<!-- Serialización segura de datos base para el cliente -->
<script
  id="history-initial-records"
  type="application/json"
  set:html={JSON.stringify(allRecords)}
/>
<script
  id="history-plants-grid"
  type="application/json"
  set:html={JSON.stringify(allPlants)}
/>

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8">
  <!-- ENCABEZADO PRINCIPAL -->
  <div
    class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 bg-[#f4fce3] dark:bg-stone-800 p-6 rounded-2xl border border-green-200 dark:border-[#166534] shadow-sm transition-colors"
  >
    <div class="flex items-start sm:items-center gap-4">
      <div
        class="p-3.5 bg-gradient-to-br from-green-600 via-green-700 to-lime-600 text-white rounded-2xl shadow-lg shadow-green-600/20 shrink-0"
      >
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1
            class="text-2xl sm:text-3xl font-black text-green-950 dark:text-white tracking-tight"
          >
            Historial Cronológico de Mediciones
          </h1>
          <span
            class="px-2.5 py-0.5 rounded-full text-xs font-black bg-green-100 dark:bg-stone-950/60 text-green-700 dark:text-stone-300 border border-green-300 dark:border-stone-800"
          >
            Registro Multidía
          </span>
        </div>
        <p class="text-xs sm:text-sm text-green-600 dark:text-stone-400 mt-1">
          Consulta, audita y compara las tomas de datos de cada día para las 20
          plantas del invernadero.
        </p>
        <p
          class="text-[11px] sm:text-xs text-green-400 dark:text-stone-600 mt-0.5"
        >
          Sesión activa: <strong
            class="text-green-800 dark:text-stone-300 font-semibold"
            >{currentUserName}</strong
          > ({currentUserRole})
        </p>
      </div>
    </div>

    <!-- BOTONES DE INTEGRACIÓN Y ACCIÓN -->
    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Conectar Google Sheets -->
      <button
        id="btn-open-sheets-modal"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-lime-800 dark:text-lime-300 bg-lime-50 dark:bg-lime-950/40 hover:bg-lime-100 dark:hover:bg-lime-900/50 border border-lime-300 dark:border-lime-700 shadow-xs transition-all cursor-pointer transform hover:-translate-y-0.5"
        title="Conectar y sincronizar automáticamente con Google Sheets / Google Docs"
      >
        <svg
          class="w-4 h-4 text-lime-600 dark:text-lime-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
          ></path>
        </svg>
        <span>Conectar Google Sheets</span>
        <span
          id="sheets-badge-dot"
          class="w-2 h-2 rounded-full bg-lime-500 animate-pulse"></span>
      </button>

      <!-- Subir Archivo Excel / CSV -->
      <button
        id="btn-open-upload-modal"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-green-700 dark:text-stone-300 bg-green-50 dark:bg-stone-900/30 hover:bg-green-100 dark:hover:bg-green-900/50 border border-green-200 dark:border-stone-800 shadow-xs transition-all cursor-pointer transform hover:-translate-y-0.5"
        title="Subir archivo Excel (.xlsx) o CSV con las mediciones tomadas en campo"
      >
        <svg
          class="w-4 h-4 text-green-600 dark:text-stone-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
          ></path>
        </svg>
        <span>Subir Archivo (.csv / .xlsx)</span>
      </button>

      <!-- Exportar Historial -->
      <button
        id="btn-export-history"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-green-800 dark:text-stone-300 bg-green-100 dark:bg-stone-700 hover:bg-green-200 dark:hover:bg-green-600 border border-green-300 dark:border-stone-600 shadow-xs transition-all cursor-pointer"
        title="Exportar base de datos histórica en formato Excel o CSV"
      >
        <svg
          class="w-4 h-4 text-green-700 dark:text-stone-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        <span>Descargar Excel</span>
      </button>
    </div>
  </div>

  <!-- BARRA DE ESTADO DE SINCRONIZACIÓN -->
  <div
    id="sync-banner"
    class="hidden flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-4 bg-lime-50 dark:bg-lime-950/40 border border-lime-200 dark:border-lime-800 rounded-2xl text-xs text-lime-900 dark:text-lime-200 shadow-xs transition-all"
  >
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-lime-500"></span>
      <div>
        <span class="font-bold">Google Sheets Vinculado:</span>
        <span
          id="sync-banner-text"
          class="text-lime-700 dark:text-lime-300 ml-1"
          >Sincronización activa en tiempo real.</span
        >
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span id="sync-last-update" class="text-[11px] opacity-80"
        >Última sync: Hace momentos</span
      >
      <button
        id="btn-sync-now-banner"
        class="px-3 py-1 bg-lime-600 hover:bg-lime-700 text-white font-bold rounded-lg cursor-pointer transition-all shadow-xs"
      >
        Sincronizar ahora
      </button>
    </div>
  </div>

  <!-- 1. BARRA INTUITIVA DE FILTRO DE FECHA Y CRITERIOS -->
  <div
    class="bg-[#f4fce3] dark:bg-stone-800 p-5 sm:p-6 rounded-2xl border border-green-200 dark:border-[#166534] shadow-sm space-y-4"
  >
    <!-- Fila 1: Selector de Fecha Principal y Chips Rápidos -->
    <div
      class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-green-100 dark:border-[#166534]/80"
    >
      <!-- Selector de Fecha Calendario -->
      <div class="flex flex-wrap items-center gap-3">
        <label
          for="history-date-picker"
          class="text-xs sm:text-sm font-bold text-green-800 dark:text-stone-300 flex items-center gap-1.5"
        >
          <span class="text-base">📅</span> Seleccionar Día:
        </label>
        <div class="relative">
          <input
            id="history-date-picker"
            type="date"
            value={latestDate}
            class="px-4 py-2 text-xs sm:text-sm font-bold rounded-xl border border-green-300 dark:border-stone-600 bg-green-50 dark:bg-[#062c16] text-green-950 dark:text-white focus:ring-2 focus:ring-green-500 focus:border-green-500 cursor-pointer shadow-xs transition-all"
          />
        </div>
        <span
          class="text-[11px] text-green-400 dark:text-stone-600 hidden sm:inline"
        >
          (Escoge cualquier día para ver sus mediciones)
        </span>
      </div>

      <!-- Chips Rápidos de Selección -->
      <div class="flex flex-wrap items-center gap-2" id="date-quick-chips">
        <!-- Renderizado dinámico de chips rápidos: Hoy, Ayer, Hace 2 días, etc. -->
      </div>
    </div>

    <!-- Fila 2: Filtros Secundarios (Fila, Planta, Sanidad, Búsqueda) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-1">
      <!-- Filtro Fila -->
      <div>
        <label
          for="filter-fila"
          class="block text-[11px] font-bold uppercase tracking-wider text-green-600 dark:text-stone-400 mb-1"
        >
          Filtrar por Fila
        </label>
        <select
          id="filter-fila"
          class="w-full px-3 py-2 text-xs font-semibold rounded-xl border border-green-300 dark:border-stone-600 bg-green-50 dark:bg-[#062c16] text-green-900 dark:text-stone-300 focus:ring-2 focus:ring-green-500 cursor-pointer"
        >
          <option value="all">Todas las Filas (t0 a t3)</option>
          <option value="t0">Fila t0</option>
          <option value="t1">Fila t1</option>
          <option value="t2">Fila t2</option>
          <option value="t3">Fila t3</option>
        </select>
      </div>

      <!-- Filtro Planta -->
      <div>
        <label
          for="filter-planta"
          class="block text-[11px] font-bold uppercase tracking-wider text-green-600 dark:text-stone-400 mb-1"
        >
          Filtrar por Planta
        </label>
        <select
          id="filter-planta"
          class="w-full px-3 py-2 text-xs font-semibold rounded-xl border border-green-300 dark:border-stone-600 bg-green-50 dark:bg-[#062c16] text-green-900 dark:text-stone-300 focus:ring-2 focus:ring-green-500 cursor-pointer"
        >
          <option value="all">Todas las 20 Plantas</option>
          {
            allPlants.map((p) => (
              <option value={p.plantId}>
                {p.plantId} ({p.fila} - {p.columna})
              </option>
            ))
          }
        </select>
      </div>

      <!-- Filtro Sanidad -->
      <div>
        <label
          for="filter-sanidad"
          class="block text-[11px] font-bold uppercase tracking-wider text-green-600 dark:text-stone-400 mb-1"
        >
          Estado Fitosanitario
        </label>
        <select
          id="filter-sanidad"
          class="w-full px-3 py-2 text-xs font-semibold rounded-xl border border-green-300 dark:border-stone-600 bg-green-50 dark:bg-[#062c16] text-green-900 dark:text-stone-300 focus:ring-2 focus:ring-green-500 cursor-pointer"
        >
          <option value="all">Todos los Estados</option>
          <option value="Excelente">Excelente 🟢</option>
          <option value="Saludable">Saludable 🟢</option>
          <option value="Vulnerable">Vulnerable 🟡</option>
          <option value="Crítica">Crítica 🔴</option>
        </select>
      </div>

      <!-- Buscador de Texto Libre -->
      <div>
        <label
          for="search-query"
          class="block text-[11px] font-bold uppercase tracking-wider text-green-600 dark:text-stone-400 mb-1"
        >
          Búsqueda Rápida
        </label>
        <div class="relative">
          <input
            id="search-query"
            type="text"
            placeholder="Responsable, nota o código..."
            class="w-full pl-8 pr-3 py-2 text-xs font-semibold rounded-xl border border-green-300 dark:border-stone-600 bg-green-50 dark:bg-[#062c16] text-green-900 dark:text-stone-300 focus:ring-2 focus:ring-green-500"
          />
          <span class="absolute left-2.5 top-2.5 text-green-400 text-xs"
            >🔍</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- 2. RESUMEN EJECUTIVO DEL DÍA SELECCIONADO -->
  <div
    class="bg-gradient-to-br from-green-900 via-green-800 to-lime-900 text-white p-6 rounded-3xl shadow-lg relative overflow-hidden"
  >
    <!-- Decoración de Fondo -->
    <div
      class="absolute -right-10 -bottom-10 w-60 h-60 bg-lime-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -left-10 -top-10 w-60 h-60 bg-green-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div
      class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10"
    >
      <div>
        <div class="flex items-center gap-2">
          <span
            class="px-3 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-[#f4fce3]/20 text-white backdrop-blur-md"
          >
            Ficha de la Fecha
          </span>
          <span
            id="summary-view-mode-badge"
            class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-lime-400/20 text-lime-300 border border-lime-400/30"
          >
            Día Específico
          </span>
        </div>
        <h2
          id="summary-date-title"
          class="text-2xl sm:text-3xl font-black tracking-tight mt-1.5 capitalize"
        >
          Cargando fecha...
        </h2>
        <p
          id="summary-date-subtitle"
          class="text-xs sm:text-sm text-green-200 mt-0.5"
        >
          Consolidado de variables agronómicas tomadas por el equipo de campo.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <div class="text-right">
          <span
            class="text-[11px] uppercase tracking-wider text-green-200 block"
            >Plantas Medidas</span
          >
          <span
            id="summary-coverage-count"
            class="text-2xl font-black text-white">--/20</span
          >
        </div>
        <div
          id="summary-health-semaphore"
          class="w-12 h-12 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md flex items-center justify-center text-2xl border border-white/15"
        >
          🪴
        </div>
      </div>
    </div>

    <!-- 5 Tarjetas de Métricas del Día -->
    <div
      class="relative z-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 pt-6"
    >
      <!-- pH Promedio -->
      <div
        class="p-3.5 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md border border-white/15"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-green-200"
            >pH Suelo</span
          >
          <span class="text-base">🧪</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1">
          <span id="kpi-ph" class="text-2xl font-black text-white">--</span>
          <span class="text-xs text-green-200">pH</span>
        </div>
        <span
          id="kpi-ph-badge"
          class="text-[10px] font-bold text-lime-300 block mt-1"
        >
          Óptimo (6.0 - 6.8)
        </span>
      </div>

      <!-- Temp. Interna -->
      <div
        class="p-3.5 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md border border-white/15"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-green-200"
            >Temp. Interna</span
          >
          <span class="text-base">🌡️</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1">
          <span id="kpi-tin" class="text-2xl font-black text-white">--</span>
          <span class="text-xs text-green-200">°C</span>
        </div>
        <span class="text-[10px] text-green-200 block mt-1"
          >Microclima del domo</span
        >
      </div>

      <!-- Temp. Suelo -->
      <div
        class="p-3.5 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md border border-white/15"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-green-200"
            >Temp. Suelo</span
          >
          <span class="text-base">🌱</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1">
          <span id="kpi-tsoil" class="text-2xl font-black text-white">--</span>
          <span class="text-xs text-green-200">°C</span>
        </div>
        <span class="text-[10px] text-green-200 block mt-1">Zona radicular</span
        >
      </div>

      <!-- Crecimiento -->
      <div
        class="p-3.5 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md border border-white/15"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-green-200"
            >Avance Foliar</span
          >
          <span class="text-base">📈</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1">
          <span id="kpi-growth" class="text-2xl font-black text-white">--</span>
          <span class="text-xs text-green-200">%</span>
        </div>
        <span class="text-[10px] text-lime-300 block mt-1"
          >Desarrollo promedio</span
        >
      </div>

      <!-- Índice de Salud -->
      <div
        class="p-3.5 rounded-2xl bg-[#f4fce3]/10 backdrop-blur-md border border-white/15 col-span-2 sm:col-span-1"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-green-200"
            >Salud General</span
          >
          <span class="text-base">🛡️</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1">
          <span id="kpi-health" class="text-2xl font-black text-white">--</span>
          <span class="text-xs text-green-200">%</span>
        </div>
        <span
          id="kpi-health-plants"
          class="text-[10px] text-lime-300 block mt-1"
        >
          --/20 Saludables
        </span>
      </div>
    </div>
  </div>

  <!-- 3. MATRIZ VISUAL DE PLANTAS EN EL DÍA SELECCIONADO (4x5) -->
  <div
    class="bg-[#f4fce3] dark:bg-stone-800 p-5 sm:p-6 rounded-2xl border border-green-200 dark:border-[#166534] shadow-sm space-y-4"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"
    >
      <div>
        <h3
          class="text-base sm:text-lg font-black text-green-950 dark:text-white flex items-center gap-2"
        >
          <span>🌿</span> Mapa de Plantas en la Fecha Seleccionada
        </h3>
        <p class="text-xs text-green-600 dark:text-stone-400 mt-0.5">
          Haz clic en cualquier planta para ver su <strong
            >ficha técnica con comparativa vs la medición anterior</strong
          >.
        </p>
      </div>

      <div
        class="flex items-center gap-3 text-xs font-semibold text-green-700 dark:text-stone-300"
      >
        <span class="flex items-center gap-1.5"
          ><span class="w-2.5 h-2.5 rounded-full bg-lime-500"></span> Óptimo</span
        >
        <span class="flex items-center gap-1.5"
          ><span class="w-2.5 h-2.5 rounded-full bg-green-400"></span> Vulnerable</span
        >
        <span class="flex items-center gap-1.5"
          ><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Crítico</span
        >
        <span class="flex items-center gap-1.5"
          ><span class="w-2.5 h-2.5 rounded-full bg-green-300 dark:bg-stone-600"
          ></span> Sin Registro</span
        >
      </div>
    </div>

    <!-- Contenedor dinámico de la cuadrícula de 20 plantas -->
    <div
      id="history-plant-grid"
      class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3"
    >
      <!-- Inyectado por JavaScript -->
    </div>
  </div>

  <!-- 4. LÍNEA TEMPORAL / GRÁFICA DE EVOLUCIÓN HISTÓRICA -->
  <div
    class="bg-[#f4fce3] dark:bg-stone-800 p-5 sm:p-6 rounded-2xl border border-green-200 dark:border-[#166534] shadow-sm space-y-4"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"
    >
      <div class="flex items-center gap-2.5">
        <span
          class="p-2 rounded-xl bg-green-100 dark:bg-stone-900/40 text-green-600 dark:text-stone-400 text-sm"
          >📊</span
        >
        <div>
          <h3
            class="text-base sm:text-lg font-black text-green-950 dark:text-white"
          >
            Evolución Cronológica Multidía
          </h3>
          <p class="text-xs text-green-600 dark:text-stone-400">
            Comparativa de variables de todos los días registrados en el
            historial
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-metric-chart-ph"
          class="px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs"
        >
          pH Suelo
        </button>
        <button
          id="btn-metric-chart-temp"
          class="px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all"
        >
          Temperatura
        </button>
        <button
          id="btn-metric-chart-growth"
          class="px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all"
        >
          Crecimiento %
        </button>
      </div>
    </div>

    <!-- Contenedor del Gráfico SVG Responsivo -->
    <div
