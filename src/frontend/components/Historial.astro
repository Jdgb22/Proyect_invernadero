<!-- SCRIPT DE CLIENTE CON TODA LA LÓGICA      -->
<!-- ========================================== -->
<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    // 1. CARGA DE DATOS BASE SERIALIZADOS
    const initialRecordsEl = document.getElementById("history-initial-records");
    const plantsGridEl = document.getElementById("history-plants-grid");

    let baseRecords = [];
    let plantsList = [];

    try {
      baseRecords = JSON.parse(initialRecordsEl?.textContent || "[]");
      plantsList = JSON.parse(plantsGridEl?.textContent || "[]");
    } catch (e) {
      console.error("Error parseando datos iniciales:", e);
    }

    // 2. COMBINAR CON LOCALSTORAGE (Registros importados o sincronizados previamente)
    const STORAGE_KEY_RECORDS = "aquasens_custom_history_records";
    const STORAGE_KEY_SHEETS_URL = "aquasens_google_sheet_url";
    const STORAGE_KEY_LAST_SYNC = "aquasens_last_sync_time";

    function getStoredRecords() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY_RECORDS);
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function saveCustomRecords(newRecords) {
      try {
        const existing = getStoredRecords();
        // Evitar duplicados por id
        const map = new Map();
        [...existing, ...newRecords].forEach((r) => map.set(r.id, r));
        localStorage.setItem(
          STORAGE_KEY_RECORDS,
          JSON.stringify(Array.from(map.values())),
        );
      } catch (e) {
        console.error("Error guardando en localStorage:", e);
      }
    }

    // Unir todos los registros (base + custom)
    function getAllCombinedRecords() {
      const custom = getStoredRecords();
      const map = new Map();
      // Primero base, luego custom sobrescribe si coincide ID
      baseRecords.forEach((r) => map.set(r.id, r));
      custom.forEach((r) => map.set(r.id, r));
      return Array.from(map.values());
    }

    // 3. ESTADO GLOBAL DE LA VISTA
    const state = {
      allRecords: getAllCombinedRecords(),
      selectedDate: "",
      selectedFila: "all",
      selectedPlanta: "all",
      selectedSanidad: "all",
      searchQuery: "",
      activeChartMetric: "ph", // 'ph' | 'temp' | 'growth'
      pendingUploadRows: [],
    };

    // Obtener lista de fechas únicas ordenadas
    function getAvailableDates() {
      const dates = Array.from(new Set(state.allRecords.map((r) => r.fecha)));
      return dates.sort((a, b) => b.localeCompare(a));
    }

    // Inicializar fecha seleccionada
    const availableDates = getAvailableDates();
    state.selectedDate =
