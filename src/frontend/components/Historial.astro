    // 5. RENDERIZADO DE CHIPS RÁPIDOS DE FECHA
    function renderQuickDateChips() {
      if (!quickChipsContainer) return;
      const dates = getAvailableDates();
      quickChipsContainer.innerHTML = "";

      if (dates.length === 0) {
        quickChipsContainer.innerHTML = `
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-green-100/60 dark:bg-stone-800 text-green-700 dark:text-stone-300 text-xs font-semibold">
            <span>⏳</span>
            <span>Esperando sincronización con Google Sheets...</span>
          </div>
        `;
        return;
      }

      const todayStr = new Date().toISOString().slice(0, 10);

      dates.slice(0, 4).forEach((d, idx) => {
        let label = d;
        if (d === todayStr) label = "📍 Hoy";
        else if (idx === 1 && dates[0] === todayStr) label = "Ayer";
        else {
          // Formatear día y mes
          const parts = d.split("-");
          if (parts.length === 3) {
            const dateObj = new Date(
              parseInt(parts[0]),
              parseInt(parts[1]) - 1,
              parseInt(parts[2]),
            );
            label = dateObj.toLocaleDateString("es-CO", {
              day: "numeric",
              month: "short",
            });
          }
        }

        const isSelected = state.selectedDate === d;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer ${
          isSelected
            ? "bg-green-600 text-white shadow-xs"
            : "bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 dark:hover:bg-green-600"
        }`;
        btn.textContent = label;
        btn.addEventListener("click", () => {
          state.selectedDate = d;
          if (datePicker) datePicker.value = d;
          updateAllViews();
        });
        quickChipsContainer.appendChild(btn);
      });

      // Opción: Ver Todo el Historial (Modo General)
      const isAllSelected = state.selectedDate === "all";
      const allBtn = document.createElement("button");
      allBtn.type = "button";
      allBtn.className = `px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer ${
        isAllSelected
          ? "bg-green-600 text-white shadow-xs"
          : "bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 dark:hover:bg-green-600"
      }`;
      allBtn.textContent = "🌐 Ver Todo";
      allBtn.addEventListener("click", () => {
        state.selectedDate = "all";
        if (datePicker) datePicker.value = "";
        updateAllViews();
      });
      quickChipsContainer.appendChild(allBtn);
    }

    // 6. FILTRAR REGISTROS
    function getFilteredRecords() {
      return state.allRecords.filter((r) => {
        // Fecha
        if (state.selectedDate !== "all" && r.fecha !== state.selectedDate) {
          return false;
        }
        // Fila
        if (
          state.selectedFila !== "all" &&
          String(r.fila || "").toLowerCase() !==
            state.selectedFila.toLowerCase()
        ) {
          return false;
        }
        // Planta (por ID P-01 o código T0-P1)
        if (state.selectedPlanta !== "all") {
          const matchId = r.plantId === state.selectedPlanta;
          const matchCode = r.code === state.selectedPlanta;
          if (!matchId && !matchCode) {
            return false;
          }
        }
        // Sanidad
        if (
          state.selectedSanidad !== "all" &&
          r.sanidad !== state.selectedSanidad
        ) {
          return false;
        }
        // Búsqueda de texto
        if (state.searchQuery.trim()) {
          const q = state.searchQuery.toLowerCase();
          const matchId = (r.plantId || "").toLowerCase().includes(q);
          const matchCode = (r.code || "").toLowerCase().includes(q);
          const matchResp = (r.responsable || "").toLowerCase().includes(q);
          const matchObs = (r.observaciones || "").toLowerCase().includes(q);
          const matchFila = (r.fila || "").toLowerCase().includes(q);
          if (!matchId && !matchCode && !matchResp && !matchObs && !matchFila) {
            return false;
          }
        }
        return true;
      });
    }

    // 7. RENDERIZADO DEL RESUMEN EJECUTIVO (KPIs)
    function renderSummaryKPIs() {
      const recordsForDate =
        state.selectedDate === "all"
          ? state.allRecords
          : state.allRecords.filter((r) => r.fecha === state.selectedDate);

      // Título de Fecha
      if (summaryDateTitle) {
        if (state.allRecords.length === 0) {
          summaryDateTitle.textContent = "Esperando Sincronización";
          if (summaryDateSubtitle) {
            summaryDateSubtitle.textContent =
              "Conecta tu enlace de Google Sheets arriba para visualizar los datos del cultivo.";
          }
        } else if (state.selectedDate === "all") {
          summaryDateTitle.textContent = "Histórico Global Consolidado";
          if (summaryDateSubtitle)
            summaryDateSubtitle.textContent = `Analizando ${state.allRecords.length} mediciones a lo largo de ${getAvailableDates().length} días registrados.`;
        } else {
          const parts = state.selectedDate.split("-");
          if (parts.length === 3) {
            const dateObj = new Date(
              parseInt(parts[0]),
              parseInt(parts[1]) - 1,
              parseInt(parts[2]),
            );
            summaryDateTitle.textContent = dateObj.toLocaleDateString("es-CO", {
              weekday: "long",
              year: "numeric",
              month: "long",
              day: "numeric",
            });
          } else {
            summaryDateTitle.textContent =
              state.selectedDate || "Sin registros";
          }
          if (summaryDateSubtitle)
            summaryDateSubtitle.textContent =
              "Consolidado de variables agronómicas tomadas por el equipo de campo en esta fecha.";
        }
      }

      const total = recordsForDate.length;
      if (total === 0) {
        if (summaryCoverageCount) summaryCoverageCount.textContent = "0/20";
        if (kpiPh) kpiPh.textContent = "--";
        if (kpiTin) kpiTin.textContent = "--";
        if (kpiTsoil) kpiTsoil.textContent = "--";
        if (kpiGrowth) kpiGrowth.textContent = "--";
        if (kpiHealth) kpiHealth.textContent = "--";
        if (kpiHealthPlants) kpiHealthPlants.textContent = "0/20";
        return;
      }

      // Plantas únicas medidas
      const uniquePlants = new Set(recordsForDate.map((r) => r.plantId));
      if (summaryCoverageCount)
        summaryCoverageCount.textContent = `${uniquePlants.size}/20`;

      // Promedios
      const avgPh = +(
        recordsForDate.reduce((acc, r) => acc + r.phSuelo, 0) / total
      ).toFixed(2);
      const validTinRecords = recordsForDate.filter(
        (r) =>
          r.tempInterna !== null &&
          r.tempInterna !== undefined &&
          !isNaN(Number(r.tempInterna)),
      );
      const avgTin =
        validTinRecords.length > 0
          ? +(
              validTinRecords.reduce(
                (acc, r) => acc + Number(r.tempInterna),
                0,
              ) / validTinRecords.length
            ).toFixed(1)
          : null;
      const avgTsoil = +(
        recordsForDate.reduce((acc, r) => acc + r.tempSuelo, 0) / total
      ).toFixed(1);
      const avgGrowth = Math.round(
        recordsForDate.reduce((acc, r) => acc + r.crecimiento, 0) / total,
      );

      const healthyCount = recordsForDate.filter(
        (r) => r.sanidad === "Excelente" || r.sanidad === "Saludable",
      ).length;
      const healthyRatio = Math.round((healthyCount / total) * 100);

      if (kpiPh) kpiPh.textContent = avgPh.toString();
      if (kpiPhBadge) {
        if (avgPh >= 6.0 && avgPh <= 6.8) {
          kpiPhBadge.textContent = "● Rango Óptimo (6.0 - 6.8)";
          kpiPhBadge.className =
            "text-[10px] font-bold text-lime-300 block mt-1";
        } else if (avgPh >= 5.5 && avgPh <= 7.2) {
          kpiPhBadge.textContent = "▲ Atención Nutricional";
          kpiPhBadge.className =
            "text-[10px] font-bold text-green-300 block mt-1";
        } else {
          kpiPhBadge.textContent = "■ Crítico Fuera de Rango";
          kpiPhBadge.className =
            "text-[10px] font-bold text-rose-300 block mt-1";
        }
      }

      if (kpiTin) {
        kpiTin.textContent = avgTin !== null ? avgTin.toString() : "N/D";
      }
      if (kpiTsoil) kpiTsoil.textContent = avgTsoil.toString();
      if (kpiGrowth) kpiGrowth.textContent = avgGrowth.toString();
      if (kpiHealth) kpiHealth.textContent = healthyRatio.toString();
      if (kpiHealthPlants)
        kpiHealthPlants.textContent = `${healthyCount}/${total} Saludables`;

      if (summaryHealthSemaphore) {
        if (healthyRatio >= 80) summaryHealthSemaphore.textContent = "🪴";
        else if (healthyRatio >= 60) summaryHealthSemaphore.textContent = "🌿";
        else summaryHealthSemaphore.textContent = "🥀";
      }
    }

    // 8. RENDERIZADO DE LA MATRIZ DE PLANTAS (4x5) PARA LA FECHA SELECCIONADA
    function renderPlantGrid() {
      if (!plantGridContainer) return;
      plantGridContainer.innerHTML = "";

      // Determinar la fecha objetivo (si es 'all', usar la más reciente)
      const targetDate =
        state.selectedDate === "all"
          ? getAvailableDates()[0] || ""
          : state.selectedDate;

      const dateRecords = state.allRecords.filter(
        (r) => r.fecha === targetDate,
      );

      // Generar 20 posiciones esperadas (4 filas x 5 columnas)
      const expectedPlants = [];
      const filas = ["t0", "t1", "t2", "t3"];
      const cols = ["Col 1", "Col 2", "Col 3", "Col 4", "Col 5"];

      let pNum = 1;
      filas.forEach((f, fIdx) => {
        cols.forEach((c, cIdx) => {
          const numStr = pNum < 10 ? `0${pNum}` : `${pNum}`;
          expectedPlants.push({
            fila: f,
            columna: c,
            plantId: `P-${numStr}`,
            code: `T${fIdx}-P${cIdx + 1}`,
            treatmentLabel: `T${fIdx}`,
          });
          pNum++;
        });
      });

      expectedPlants.forEach((expected) => {
        // Buscar registro para esta planta en esta fecha con soporte T0-P1, TO-P2, T1-P1...
        const normCode = (c: any) =>
          String(c || "")
            .toUpperCase()
            .replace(/^TO-/, "T0-")
            .replace(/\s+/g, "");
        const metric = dateRecords.find((r: any) => {
          if (r.code && normCode(r.code) === normCode(expected.code))
            return true;
          if (
            r.plantId &&
            (r.plantId.toUpperCase() === expected.plantId.toUpperCase() ||
              normCode(r.plantId) === normCode(expected.code))
          )
            return true;
          const resolved = resolveCoordsHistorial(
            r.code || r.plantId,
            r.fila,
            r.columna,
          );
          return (
            resolved.code === expected.code ||
            (resolved.fila === expected.fila &&
              resolved.columna === expected.columna)
          );
        });

        const card = document.createElement("button");
        card.type = "button";

        if (metric) {
          const isCritical = metric.sanidad === "Crítica";
          const isWarning = metric.sanidad === "Vulnerable";
          const statusBorder = isCritical
            ? "border-rose-300 dark:border-rose-800 bg-rose-50/60 dark:bg-rose-950/20 hover:border-rose-500"
            : isWarning
              ? "border-green-300 dark:border-stone-800 bg-green-50/60 dark:bg-stone-950/20 hover:border-green-500"
              : "border-lime-200 dark:border-lime-800/40 bg-lime-50/50 dark:bg-lime-950/10 hover:border-lime-500";

          const dotColor = isCritical
            ? "bg-rose-500"
            : isWarning
              ? "bg-green-400"
              : "bg-lime-500";
          const plantIcon = isCritical ? "🥀" : isWarning ? "🌿" : "🪴";
          const displayCode = metric.code || expected.code;
          const displayPlantId = metric.plantId || expected.plantId;
          const alturaStr =
            metric.alturaCm !== undefined && metric.alturaCm !== null
              ? `${metric.alturaCm} cm`
              : `${metric.crecimiento}%`;

          card.className = `text-left p-3 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-pointer relative group ${statusBorder}`;
          card.innerHTML = `
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-black font-mono text-green-700 dark:text-stone-300 uppercase">${displayCode} (${displayPlantId}) • ${expected.treatmentLabel}</span>
              <span class="w-2.5 h-2.5 rounded-full ${dotColor}"></span>
            </div>
            <div class="flex items-center justify-between my-1">
              <span class="text-2xl group-hover:scale-115 transition-transform">${plantIcon}</span>
              <div class="text-right">
                <span class="text-xs font-mono font-bold text-green-900 dark:text-stone-300 block">${metric.columna || expected.columna}</span>
                <span class="text-[10px] font-mono text-lime-600 dark:text-lime-400 font-bold">${alturaStr}</span>
              </div>
            </div>
            <div class="mt-2 flex items-center justify-between text-[9px] font-mono text-green-600 dark:text-stone-400 border-t border-green-200/70 dark:border-[#166534]/70 pt-1.5">
              <span>🧪 ${Number(metric.phSuelo).toFixed(1)} pH</span>
              <span>🌡️ ${metric.tempInterna !== null && metric.tempInterna !== undefined ? Number(metric.tempInterna).toFixed(1) + "°C" : "N/D"}</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-[9px] font-mono text-green-600 dark:text-stone-400">
              <span>💧 ${metric.humedad !== undefined && metric.humedad !== null ? metric.humedad + "%" : "--"}</span>
              <span class="font-bold text-green-700 dark:text-stone-300 group-hover:underline flex items-center gap-0.5">
                <span>Ver Ficha</span> →
              </span>
            </div>
          `;

          card.addEventListener("click", () => {
            openPlantDetailModal(metric);
          });
        } else {
          // Sin registro para este día
          card.className =
            "text-left p-3 rounded-xl border border-green-200 dark:border-[#166534] bg-green-50/50 dark:bg-stone-800/40 opacity-60 cursor-default";
          card.innerHTML = `
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-black font-mono text-green-400 uppercase">${expected.code} (${expected.plantId}) • ${expected.treatmentLabel}</span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-300 dark:bg-stone-600"></span>
            </div>
            <div class="flex items-center justify-between my-2 text-center text-green-400 text-xs py-1">
              <span class="text-lg">⚪</span>
              <span class="text-[10px]">Sin registro</span>
            </div>
            <div class="mt-2 text-[9px] font-mono text-green-400 border-t border-green-200/50 dark:border-[#166534]/50 pt-1 text-center">
              ${expected.columna}
            </div>
          `;
        }

        plantGridContainer.appendChild(card);
      });
    }

    // 9. RENDERIZADO DEL GRÁFICO DE EVOLUCIÓN HISTÓRICA (SVG)
    function renderEvolutionChart() {
      if (!evolutionSvg) return;
      evolutionSvg.innerHTML = "";

      const dates = getAvailableDates().reverse(); // antiguo a reciente para la gráfica
      if (dates.length < 1) {
        const text = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        text.setAttribute("x", "350");
        text.setAttribute("y", "95");
        text.setAttribute("text-anchor", "middle");
        text.setAttribute("fill", "#9CA3AF");
        text.setAttribute("font-size", "12");
        text.setAttribute("font-family", "system-ui, sans-serif");
        text.setAttribute("font-weight", "600");
        text.textContent =
          "Esperando sincronización con Google Sheets para graficar evolución histórica...";
        evolutionSvg.appendChild(text);
        return;
      }

      const metricType = state.activeChartMetric; // 'ph' | 'temp' | 'growth'

      // Calcular promedio por fecha
      const dataPoints = dates.map((d) => {
        const records = state.allRecords.filter((r) => r.fecha === d);
        if (records.length === 0) return { date: d, value: null };
        let sum = 0;
        if (metricType === "ph") {
          sum = records.reduce((a, b) => a + b.phSuelo, 0);
          return { date: d, value: +(sum / records.length).toFixed(1) };
        } else if (metricType === "temp") {
          const valid = records.filter(
            (r) =>
              (r.tempInvernadero !== undefined &&
                r.tempInvernadero !== null &&
                !isNaN(Number(r.tempInvernadero))) ||
              (r.tempInterna !== null &&
                r.tempInterna !== undefined &&
                !isNaN(Number(r.tempInterna))),
          );
          if (valid.length === 0) {
            return { date: d, value: null };
          }
          sum = valid.reduce(
            (a, b) => a + Number(b.tempInvernadero ?? b.tempInterna),
            0,
          );
          return { date: d, value: +(sum / valid.length).toFixed(1) };
        } else {
          sum = records.reduce((a, b) => a + b.crecimiento, 0);
          return { date: d, value: +(sum / records.length).toFixed(1) };
        }
      });

      const width = 700;
      const height = 180;
      const paddingX = 60;
      const paddingY = 30;

      // Escalas min y max dinámicas según datos reales para evitar rupturas de límites
      const validValues = dataPoints
        .map((dp) => dp.value)
        .filter((v): v is number => v !== null && !isNaN(v));

      let minVal = metricType === "ph" ? 5.0 : metricType === "temp" ? 18.0 : 0;
      let maxVal =
        metricType === "ph" ? 7.5 : metricType === "temp" ? 32.0 : 100;

      if (validValues.length > 0) {
        const dMin = Math.min(...validValues);
        const dMax = Math.max(...validValues);
        if (metricType === "temp") {
          minVal = Math.min(18.0, Math.floor(dMin - 1));
          maxVal = Math.max(30.0, Math.ceil(dMax + 1));
        } else if (metricType === "ph") {
          minVal = Math.min(5.0, +(dMin - 0.4).toFixed(1));
          maxVal = Math.max(7.5, +(dMax + 0.4).toFixed(1));
        } else {
          minVal = Math.min(0, Math.floor(dMin - 5));
          maxVal = Math.max(100, Math.ceil(dMax + 5));
        }
      }

      const valRange = maxVal - minVal || 1;
      const stepX = (width - paddingX * 2) / Math.max(1, dataPoints.length - 1);

      // Mapeo seguro con CLAMPING estricto dentro de los bordes del SVG
      const points = dataPoints.map((dp, i) => {
        const x = paddingX + i * stepX;
        if (dp.value === null || isNaN(dp.value)) {
          return { x, y: height - paddingY, dp, isNull: true };
        }
        const normalized = (dp.value - minVal) / valRange;
        const rawY = height - paddingY - normalized * (height - paddingY * 2);
        // Clamping estricto para que la línea jamás rompa el borde del gráfico
        const y = Math.max(paddingY + 6, Math.min(height - paddingY - 6, rawY));
        return { x, y, dp, isNull: false };
      });

      // Fondo de líneas de cuadrícula
      for (let g = 0; g <= 4; g++) {
        const lineY = paddingY + (g * (height - paddingY * 2)) / 4;
        const gridVal = (maxVal - (g * valRange) / 4).toFixed(1);

        const line = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "line",
        );
        line.setAttribute("x1", paddingX.toString());
        line.setAttribute("y1", lineY.toString());
        line.setAttribute("x2", (width - paddingX).toString());
        line.setAttribute("y2", lineY.toString());
        line.setAttribute("stroke", "#4B5563");
        line.setAttribute("stroke-opacity", "0.2");
        line.setAttribute("stroke-dasharray", "4 4");
        evolutionSvg.appendChild(line);

        const text = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        text.setAttribute("x", (paddingX - 10).toString());
        text.setAttribute("y", (lineY + 4).toString());
        text.setAttribute("text-anchor", "end");
        text.setAttribute("fill", "#9CA3AF");
        text.setAttribute("font-size", "10");
        text.setAttribute("font-family", "monospace");
        text.textContent =
          gridVal +
          (metricType === "ph" ? " pH" : metricType === "temp" ? "°" : "%");
        evolutionSvg.appendChild(text);
      }

      // Trazar línea de tendencia solo entre puntos válidos (evita caídas a cero o picos)
      const validPoints = points.filter((p) => !p.isNull);
      if (validPoints.length > 1) {
        let pathD = `M ${validPoints[0].x} ${validPoints[0].y}`;
        for (let p = 1; p < validPoints.length; p++) {
          pathD += ` L ${validPoints[p].x} ${validPoints[p].y}`;
        }

        const path = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "path",
        );
        path.setAttribute("d", pathD);
        path.setAttribute("fill", "none");
        path.setAttribute(
          "stroke",
          metricType === "ph"
            ? "#3B82F6"
            : metricType === "temp"
              ? "#F59E0B"
              : "#10B981",
        );
        path.setAttribute("stroke-width", "3");
        path.setAttribute("stroke-linecap", "round");
        path.setAttribute("stroke-linejoin", "round");
        evolutionSvg.appendChild(path);
      }

      // Puntos y etiquetas de fecha
      points.forEach((pt) => {
        const isSelected = pt.dp.date === state.selectedDate;

        // Círculo
        const circle = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "circle",
        );
        circle.setAttribute("cx", pt.x.toString());
        circle.setAttribute("cy", pt.y.toString());
        circle.setAttribute("r", isSelected ? "6" : "4");

        if (pt.isNull) {
          circle.setAttribute("fill", "#6B7280");
          circle.setAttribute("stroke", "#9CA3AF");
          circle.setAttribute("stroke-width", "1.5");
          circle.setAttribute("stroke-dasharray", "2 2");
        } else {
          circle.setAttribute("fill", isSelected ? "#4F46E5" : "#FFFFFF");
          circle.setAttribute(
            "stroke",
            metricType === "ph"
              ? "#3B82F6"
              : metricType === "temp"
                ? "#F59E0B"
                : "#10B981",
          );
          circle.setAttribute("stroke-width", "2");
        }
        circle.setAttribute(
          "class",
          "cursor-pointer hover:scale-125 transition-transform",
        );

        circle.addEventListener("click", () => {
          state.selectedDate = pt.dp.date;
          if (datePicker) datePicker.value = pt.dp.date;
          updateAllViews();
        });

        evolutionSvg.appendChild(circle);

        // Valor arriba del punto (clamp Y para no salirse arriba)
        const valText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        valText.setAttribute("x", pt.x.toString());
        const textY = Math.max(16, pt.y - 10);
        valText.setAttribute("y", textY.toString());
        valText.setAttribute("text-anchor", "middle");
        valText.setAttribute(
          "fill",
          isSelected ? "#4F46E5" : pt.isNull ? "#9CA3AF" : "#D1D5DB",
        );
        valText.setAttribute("font-size", "10");
        valText.setAttribute("font-weight", "bold");
        valText.textContent = pt.isNull
          ? "N/D"
          : `${pt.dp.value}${metricType === "ph" ? "" : metricType === "temp" ? "°" : "%"}`;
        evolutionSvg.appendChild(valText);

        // Etiqueta de fecha abajo
        const dateText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        dateText.setAttribute("x", pt.x.toString());
        dateText.setAttribute("y", (height - 10).toString());
        dateText.setAttribute("text-anchor", "middle");
        dateText.setAttribute("fill", isSelected ? "#4F46E5" : "#9CA3AF");
        dateText.setAttribute("font-size", "10");
        dateText.setAttribute("font-weight", isSelected ? "bold" : "normal");

        const parts = pt.dp.date.split("-");
        dateText.textContent =
          parts.length === 3 ? `${parts[2]}/${parts[1]}` : pt.dp.date;
        evolutionSvg.appendChild(dateText);
      });
    }

    // 10. RENDERIZADO DE LA TABLA DE REGISTROS
    function renderTable() {
      if (!tableBody) return;
      tableBody.innerHTML = "";

      const filtered = getFilteredRecords();

      if (tableCounter) {
        tableCounter.textContent = `Mostrando ${filtered.length} de ${state.allRecords.length} mediciones registradas.`;
      }

      if (filtered.length === 0) {
        if (tableEmptyState) {
          tableEmptyState.classList.remove("hidden");
          const h4 = tableEmptyState.querySelector("h4");
          const p = tableEmptyState.querySelector("p");
          if (state.allRecords.length === 0) {
            if (h4)
              h4.textContent = "Esperando sincronización con Google Sheets";
            if (p)
              p.innerHTML =
                'No hay datos cargados en este momento. Conecta tu hoja de cálculo haciendo clic en el botón superior <strong>"Conectar Google Sheets"</strong> para cargar todas las mediciones reales del cultivo.';
          } else {
            if (h4) h4.textContent = "No se encontraron mediciones";
            if (p)
              p.textContent =
                "No hay registros para la fecha o filtros seleccionados.";
          }
        }
        return;
      }

      if (tableEmptyState) tableEmptyState.classList.add("hidden");

      filtered.forEach((record) => {
        const tr = document.createElement("tr");
        tr.className =
          "hover:bg-green-50/80 dark:hover:bg-green-700/40 transition-colors";

        const phBadgeColor =
          record.phSuelo >= 6.0 && record.phSuelo <= 6.8
            ? "bg-lime-100 text-lime-800 dark:bg-lime-950/60 dark:text-lime-300 border-lime-300"
            : record.phSuelo >= 5.5 && record.phSuelo <= 7.2
              ? "bg-green-100 text-green-800 dark:bg-stone-950/60 dark:text-stone-300 border-green-300"
              : "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-300";

        const sanidadBadge =
          record.sanidad === "Excelente" || record.sanidad === "Saludable"
            ? "bg-lime-100 text-lime-800 dark:bg-lime-950/60 dark:text-lime-300 border-lime-200"
            : record.sanidad === "Vulnerable"
              ? "bg-green-100 text-green-800 dark:bg-stone-950/60 dark:text-stone-300 border-green-200"
              : "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200";

        tr.innerHTML = `
          <td class="px-4 py-3 whitespace-nowrap font-mono">
            <span class="font-bold text-green-950 dark:text-white block">${record.fecha}</span>
            <span class="text-[10px] text-green-400">${record.hora}</span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <span class="font-black text-green-600 dark:text-stone-400 block">${record.plantId}</span>
            <span class="text-[10px] text-green-600 dark:text-stone-400">${record.fila} • ${record.columna}</span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-green-800 dark:text-stone-300">
            ${record.faseCrecimiento}
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono">
            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold border ${phBadgeColor}">
              ${record.phSuelo.toFixed(2)} pH
            </span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono font-bold text-green-900 dark:text-stone-300">
            ${record.tempInterna !== null && record.tempInterna !== undefined ? `${Number(record.tempInterna).toFixed(1)}°C` : '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300" title="Temperatura de planta no tomada el 2026-09-29 y 2026-09-30">N/D</span>'}
          </td>
          <td class="px-4 py-3 whitespace-nowrap font-mono text-green-700 dark:text-stone-400">
            ${record.tempSuelo.toFixed(1)}°C
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <div class="flex items-center gap-1.5">
              <span class="font-mono font-bold text-lime-600 dark:text-lime-400">${record.crecimiento}%</span>
              <div class="w-12 bg-green-200 dark:bg-stone-700 rounded-full h-1.5 overflow-hidden">
                <div class="bg-lime-500 h-1.5 rounded-full" style="width: ${record.crecimiento}%"></div>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${sanidadBadge}">
              ${record.sanidad}
            </span>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-green-800 dark:text-stone-300">
            <div class="flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full ${record.avatarColor || "bg-green-600"} text-white text-[9px] font-bold flex items-center justify-center">
                ${record.responsable.charAt(0)}
              </span>
              <span class="text-xs truncate max-w-[120px]" title="${record.responsable}">${record.responsable}</span>
            </div>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-right">
            <button
              type="button"
              class="btn-row-detail px-3 py-1 rounded-lg bg-green-50 dark:bg-stone-950/50 hover:bg-green-100 text-green-700 dark:text-stone-300 text-xs font-bold transition-all cursor-pointer"
            >
              Detalle
            </button>
          </td>
        `;

        const btnDetail = tr.querySelector(".btn-row-detail");
        btnDetail?.addEventListener("click", () => {
          openPlantDetailModal(record);
        });

        tableBody.appendChild(tr);
      });
    }

    // 11. MODAL DETALLE DE PLANTA
    function openPlantDetailModal(metric) {
      if (!modalPlant) return;

      const modalIcon = document.getElementById("modal-plant-icon");
      const modalId = document.getElementById("modal-plant-id");
      const modalLocation = document.getElementById("modal-plant-location");
      const modalDate = document.getElementById("modal-plant-date");

      const modalValPh = document.getElementById("modal-val-ph");
      const modalBadgePh = document.getElementById("modal-badge-ph");
      const modalValTin = document.getElementById("modal-val-tin");
      const modalValTint = document.getElementById("modal-val-tint");
      const modalValText = document.getElementById("modal-val-text");
      const modalValHum = document.getElementById("modal-val-hum");
      const modalValTsoil = document.getElementById("modal-val-tsoil");
      const modalValGrowth = document.getElementById("modal-val-growth");
      const modalValAltura = document.getElementById("modal-val-altura");
      const modalBadgeSanidad = document.getElementById("modal-badge-sanidad");
      const modalBadgeProd = document.getElementById("modal-badge-prod");
      const modalValResp = document.getElementById("modal-val-resp");
      const modalValObs = document.getElementById("modal-val-obs");
      const modalDeltaContent = document.getElementById("modal-delta-content");

      if (modalId) modalId.textContent = `${metric.code} (${metric.plantId})`;
      if (modalLocation)
        modalLocation.textContent = `Fila ${metric.fila} • ${metric.columna}`;
      if (modalDate)
        modalDate.textContent = `Medición registrada: ${metric.fecha}, ${metric.hora}`;

      // 1. Ph
      if (modalValPh)
        modalValPh.textContent = `${Number(metric.phSuelo).toFixed(2)} pH`;

      // 2. T_Planta_C (Temperatura del piso donde está la planta, null el 2026-09-29 y 2026-09-30)
      if (modalValTin) {
        modalValTin.textContent =
          metric.tempSuelo !== null &&
          metric.tempSuelo !== undefined &&
          !isNaN(Number(metric.tempSuelo))
            ? `${Number(metric.tempSuelo).toFixed(1)}°C`
            : "N/D (No tomada)";
      }

      // 3. T_Int_C (Temperatura dentro del invernadero)
      if (modalValTint) {
        modalValTint.textContent =
          metric.tempInvernadero !== undefined &&
          metric.tempInvernadero !== null
            ? `${Number(metric.tempInvernadero).toFixed(1)}°C`
            : metric.tempInterna !== null && metric.tempInterna !== undefined
              ? `${Number(metric.tempInterna).toFixed(1)}°C`
              : "N/D";
      }

      // 4. T_Ext_C (Temperatura externa del invernadero)
      if (modalValText) {
        modalValText.textContent =
          metric.tempExterna !== undefined &&
          metric.tempExterna !== null &&
          !isNaN(Number(metric.tempExterna))
            ? `${Number(metric.tempExterna).toFixed(1)}°C`
            : "N/D";
      }

      // 5. humedad_Pct (Humedad en el momento de tomar la medida)
      if (modalValHum) {
        modalValHum.textContent =
          metric.humedad !== undefined && metric.humedad !== null
            ? `${metric.humedad}%`
            : "--";
      }

      // 6. ALtura_cm (Altura de la planta en centímetros)
      if (modalValGrowth) {
        modalValGrowth.textContent =
          metric.alturaCm !== undefined && metric.alturaCm !== null
            ? `${metric.alturaCm} cm`
            : `${metric.crecimiento}%`;
      }
      if (modalValAltura) {
        modalValAltura.textContent =
          metric.alturaCm !== undefined && metric.alturaCm !== null
            ? `Crecimiento: ${metric.crecimiento}%`
            : "ALtura_cm";
      }

      if (modalBadgePh) {
        if (metric.phSuelo >= 6.0 && metric.phSuelo <= 6.8) {
          modalBadgePh.textContent = "Óptimo (6.0 - 6.8)";
          modalBadgePh.className =
            "text-[9px] font-bold text-lime-600 dark:text-lime-400 block mt-0.5";
        } else {
          modalBadgePh.textContent = "Requiere Atención";
          modalBadgePh.className =
            "text-[9px] font-bold text-green-600 dark:text-stone-400 block mt-0.5";
        }
      }

      if (modalBadgeSanidad) {
        modalBadgeSanidad.textContent = `${metric.sanidad}`;
      }

      if (modalBadgeProd) {
        modalBadgeProd.textContent = `Productividad: ${metric.productividad}`;
      }

      if (modalValResp)
        modalValResp.textContent = `Responsable: ${metric.responsable}`;
      if (modalValObs)
        modalValObs.textContent =
          metric.observaciones || "Condiciones agronómicas normales.";

      // Calcular comparación con la medición anterior de esta misma planta
      const plantHistory = state.allRecords
        .filter((r) => r.plantId === metric.plantId && r.fecha < metric.fecha)
        .sort((a, b) => b.fecha.localeCompare(a.fecha));

      if (modalDeltaContent) {
        if (plantHistory.length > 0) {
          const prev = plantHistory[0];
          const deltaPh = +(metric.phSuelo - prev.phSuelo).toFixed(2);
          const hasTinDelta =
            metric.tempInterna !== null &&
            prev.tempInterna !== null &&
            metric.tempInterna !== undefined &&
            prev.tempInterna !== undefined;
          const deltaTin = hasTinDelta
            ? +(Number(metric.tempInterna) - Number(prev.tempInterna)).toFixed(
                1,
              )
            : null;
          const hasHeightDelta =
            metric.alturaCm != null && prev.alturaCm != null;
          const deltaHeight = hasHeightDelta
            ? +(Number(metric.alturaCm) - Number(prev.alturaCm)).toFixed(1)
            : null;
          const deltaGrowth = metric.crecimiento - prev.crecimiento;
          const growthDeltaStr =
            deltaHeight !== null
              ? `${deltaHeight >= 0 ? "+" : ""}${deltaHeight} cm`
              : `${deltaGrowth >= 0 ? "+" : ""}${deltaGrowth}%`;

          modalDeltaContent.innerHTML = `
            <div>
              <span class="text-green-600 dark:text-stone-400 block">pH Suelo</span>
              <span class="font-bold ${deltaPh > 0 ? "text-green-600" : "text-lime-600"}">${deltaPh > 0 ? "+" : ""}${deltaPh}</span>
            </div>
            <div>
              <span class="text-green-600 dark:text-stone-400 block">Temp Invernadero</span>
              <span class="font-bold ${deltaTin !== null ? (deltaTin > 0 ? "text-green-600" : "text-blue-600") : "text-amber-500"}">${deltaTin !== null ? `${deltaTin > 0 ? "+" : ""}${deltaTin}°C` : "N/D"}</span>
            </div>
            <div>
              <span class="text-green-600 dark:text-stone-400 block">Altura / Crec.</span>
              <span class="font-bold text-lime-600">${growthDeltaStr}</span>
            </div>
          `;
        } else {
          modalDeltaContent.innerHTML = `
            <div class="col-span-3 text-green-600 dark:text-stone-400 italic">
              Esta es la primera toma registrada para esta planta en el historial.
            </div>
          `;
        }
      }

      modalPlant.classList.remove("hidden");
    }

    modalPlantCloseBtn?.addEventListener("click", () =>
      modalPlant?.classList.add("hidden"),
    );
    modalPlantOkBtn?.addEventListener("click", () =>
      modalPlant?.classList.add("hidden"),
    );

    // 12. ACTUALIZAR TODAS LAS VISTAS
    function updateAllViews() {
      const dates = getAvailableDates();
      if (datePicker && dates.length > 0) {
        datePicker.min = dates[dates.length - 1];
        datePicker.max = dates[0];
        if (state.selectedDate && state.selectedDate !== "all") {
          datePicker.value = state.selectedDate;
        }
      }
      renderQuickDateChips();
      renderSummaryKPIs();
      renderPlantGrid();
      renderEvolutionChart();
      renderTable();
    }

    // Eventos de Filtro
    datePicker?.addEventListener("change", (e: any) => {
      if (e.target?.value) {
        state.selectedDate = e.target.value;
        updateAllViews();
      }
    });

    datePicker?.addEventListener("input", (e: any) => {
      if (e.target?.value) {
        state.selectedDate = e.target.value;
        updateAllViews();
      }
    });

    filterFila?.addEventListener("change", (e) => {
      state.selectedFila = e.target.value;
      renderTable();
    });

    filterPlanta?.addEventListener("change", (e) => {
      state.selectedPlanta = e.target.value;
      renderTable();
    });

    filterSanidad?.addEventListener("change", (e) => {
      state.selectedSanidad = e.target.value;
      renderTable();
    });

    searchInput?.addEventListener("input", (e) => {
      state.searchQuery = e.target.value;
      renderTable();
    });

    btnResetFilters?.addEventListener("click", () => {
      state.selectedFila = "all";
      state.selectedPlanta = "all";
      state.selectedSanidad = "all";
      state.searchQuery = "";
      if (filterFila) filterFila.value = "all";
      if (filterPlanta) filterPlanta.value = "all";
      if (filterSanidad) filterSanidad.value = "all";
      if (searchInput) searchInput.value = "";
      renderTable();
    });

    // Cambiar métrica de la gráfica
    btnChartPh?.addEventListener("click", () => {
      state.activeChartMetric = "ph";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    btnChartTemp?.addEventListener("click", () => {
      state.activeChartMetric = "temp";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    btnChartGrowth?.addEventListener("click", () => {
      state.activeChartMetric = "growth";
      btnChartGrowth.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-600 text-white cursor-pointer transition-all shadow-xs";
      btnChartPh.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      btnChartTemp.className =
        "px-3 py-1.5 rounded-xl font-bold text-xs bg-green-100 dark:bg-stone-700 text-green-800 dark:text-stone-300 hover:bg-green-200 cursor-pointer transition-all";
      renderEvolutionChart();
    });

    // 13. LOGICA DEL MODAL CARGAR ARCHIVO
    btnOpenUpload?.addEventListener("click", () => {
      modalUpload?.classList.remove("hidden");
      state.pendingUploadRows = [];
      if (uploadPreviewContainer)
        uploadPreviewContainer.classList.add("hidden");
      if (modalUploadConfirmBtn) {
        modalUploadConfirmBtn.disabled = true;
        modalUploadConfirmBtn.classList.add("opacity-50", "cursor-not-allowed");
      }
    });

    modalUploadCloseBtn?.addEventListener("click", () =>
      modalUpload?.classList.add("hidden"),
    );
    modalUploadCancelBtn?.addEventListener("click", () =>
      modalUpload?.classList.add("hidden"),
    );

    dropZone?.addEventListener("click", () => fileInput?.click());

    dropZone?.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropZone.classList.add("border-green-600", "bg-green-100/50");
    });

    dropZone?.addEventListener("dragleave", () => {
      dropZone.classList.remove("border-green-600", "bg-green-100/50");
    });

    dropZone?.addEventListener("drop", (e) => {
      e.preventDefault();
      dropZone.classList.remove("border-green-600", "bg-green-100/50");
      if (e.dataTransfer?.files?.length) {
        processUploadedFile(e.dataTransfer.files[0]);
      }
    });

    fileInput?.addEventListener("change", (e) => {
      if (e.target.files?.length) {
        processUploadedFile(e.target.files[0]);
      }
    });

    // Parser local para archivos subidos por el usuario
    function processUploadedFile(file) {
      const reader = new FileReader();
      reader.onload = (evt) => {
        const text = evt.target?.result;
        if (typeof text !== "string") return;

        const lines = text.split(/\r?\n/).filter((l) => l.trim().length > 0);
        if (lines.length < 2) {
          showToast("El archivo no contiene filas de datos válidas", "⚠️");
          return;
        }

        const delimiter = lines[0].includes(";") ? ";" : ",";
        const headers = lines[0]
          .split(delimiter)
          .map((h) => h.trim().toLowerCase());

        const parsed = [];
        const todayStr = new Date().toISOString().slice(0, 10);

        for (let i = 1; i < lines.length; i++) {
          const cols = lines[i]
            .split(delimiter)
            .map((c) => c.trim().replace(/^"|"$/g, ""));
          if (cols.length < 3) continue;

          // Mapeo flexible con soporte T0-P1, TO-P2, T1-P1, T2-P3, T3-P5
          const rawPlantId = cols[0] || `P-01`;
          let rawFila = cols.length > 6 ? cols[6] : "";
          let rawCol = cols.length > 7 ? cols[7] : "";

          const coords = resolveCoordsHistorial(rawPlantId, rawFila, rawCol);
          const fila = coords.fila;
          const col = coords.columna;
          const plantNumber = coords.plantNumber;
          const plantId = coords.plantId;
          const code = coords.code;

          const fecha =
            cols[1] && /^\d{4}-\d{2}-\d{2}$/.test(cols[1]) ? cols[1] : todayStr;
          const ph = parseFloat(cols[2]?.replace(",", ".")) || 6.4;

          const isTempMissing =
            fecha === "2026-09-29" || fecha === "2026-09-30";
          const rawTin = cols[3]?.trim().toLowerCase();
          const tin =
            isTempMissing || ["nd", "n/d", "na", "-", ""].includes(rawTin)
              ? null
              : parseFloat(cols[3]?.replace(",", ".")) || null;

          const growth = parseInt(cols[4], 10) || 80;
          const sanidad = cols[5] || "Saludable";

          parsed.push({
            id: `MET-UPLOAD-${code}-${fecha}-${i}`,
            invernadero: "Invernadero Macollo",
            fila,
            columna: col,
            plantId,
            code,
            fecha,
            hora: "09:00 AM",
            timestampTexto: `${fecha}, 09:00 AM`,
            phSuelo: ph,
            tempInterna: tin,
            tempExterna: 20.0,
            tempSuelo: 20.2,
            crecimiento: growth,
            faseCrecimiento: "Desarrollo Vegetativo",
            productividad: "Alta",
            sanidad: sanidad,
            responsable: "Operario de Archivo",
            responsableRol: "Carga Manual",
            avatarColor: "bg-green-600",
            observaciones: isTempMissing
              ? "Temperatura foliar de planta no tomada el 2026-09-29 y 2026-09-30 por falta de sensor."
              : "Registro importado desde archivo local.",
          });
        }

        if (parsed.length === 0) {
          showToast("No se pudieron interpretar las filas del archivo", "⚠️");
          return;
        }

        state.pendingUploadRows = parsed;

        // Mostrar vista previa
        if (uploadPreviewContainer && uploadPreviewBody && uploadPreviewCount) {
          uploadPreviewCount.textContent = `${parsed.length} filas detectadas`;
          uploadPreviewBody.innerHTML = "";
          parsed.slice(0, 10).forEach((r) => {
            const row = document.createElement("tr");
            row.innerHTML = `
              <td class="p-2 font-bold">${r.plantId}</td>
              <td class="p-2">${r.fecha}</td>
              <td class="p-2">${r.phSuelo}</td>
              <td class="p-2">${r.tempInterna}°C</td>
              <td class="p-2">${r.crecimiento}%</td>
              <td class="p-2">${r.sanidad}</td>
            `;
            uploadPreviewBody.appendChild(row);
          });
          uploadPreviewContainer.classList.remove("hidden");
        }

        if (modalUploadConfirmBtn) {
          modalUploadConfirmBtn.disabled = false;
          modalUploadConfirmBtn.classList.remove(
            "opacity-50",
            "cursor-not-allowed",
          );
        }
      };
      reader.readAsText(file);
    }

    modalUploadConfirmBtn?.addEventListener("click", () => {
      if (state.pendingUploadRows.length === 0) return;

      saveCustomRecords(state.pendingUploadRows);
      state.allRecords = getAllCombinedRecords();

      // Cambiar a la fecha de las filas subidas
      const importedDate =
        state.pendingUploadRows[0]?.fecha || state.selectedDate;
      state.selectedDate = importedDate;
      if (datePicker) datePicker.value = importedDate;

      modalUpload?.classList.add("hidden");
      updateAllViews();

      window.dispatchEvent(
        new CustomEvent("aquasens:data-synced", {
          detail: { records: state.allRecords },
        }),
      );
      window.dispatchEvent(new Event("storage"));

      showToast(
        `¡Se guardaron ${state.pendingUploadRows.length} registros exitosamente!`,
      );
    });

    // Descargar plantilla CSV de campo
    btnDownloadTemplate?.addEventListener("click", () => {
      const todayStr = new Date().toISOString().slice(0, 10);
      let csvContent =
        "Planta,Fecha,pH_Suelo,Temp_Interna,Crecimiento_Porcentaje,Sanidad,Responsable,Observaciones\n";

      for (let p = 1; p <= 20; p++) {
        const id = `P-${p < 10 ? "0" + p : p}`;
        csvContent += `${id},${todayStr},6.4,24.5,80,Saludable,Operario Campo,Condicion normal\n`;
      }

      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute(
        "download",
        `Plantilla_Mediciones_Invernadero_${todayStr}.csv`,
      );
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast(
        "Plantilla descargada. Llena los datos y súbela cuando desees.",
        "📄",
      );
    });

    // 14. LOGICA DEL MODAL GOOGLE SHEETS
    btnOpenSheets?.addEventListener("click", () => {
      modalSheets?.classList.remove("hidden");
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      if (savedUrl && inputSheetsUrl) {
        inputSheetsUrl.value = savedUrl;
      }
      if (sheetsSyncStatus) sheetsSyncStatus.classList.add("hidden");
    });

    modalSheetsCloseBtn?.addEventListener("click", () =>
      modalSheets?.classList.add("hidden"),
    );
    modalSheetsCancelBtn?.addEventListener("click", () =>
      modalSheets?.classList.add("hidden"),
    );

    async function syncGoogleSheets(urlToSync) {
      if (!urlToSync) return;

      if (sheetsSyncSpinner) sheetsSyncSpinner.classList.remove("hidden");
      if (sheetsSyncBtnText) sheetsSyncBtnText.textContent = "Sincronizando...";
      if (modalSheetsSyncBtn) modalSheetsSyncBtn.disabled = true;

      try {
        const res = await fetch("/api/sync-sheets", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url: urlToSync }),
        });

        const data = await res.json();

        if (data.success && data.records?.length > 0) {
          saveCustomRecords(data.records);
          state.allRecords = getAllCombinedRecords();

          localStorage.setItem(STORAGE_KEY_SHEETS_URL, urlToSync);
          const nowStr = new Date().toLocaleTimeString("es-CO", {
            hour: "2-digit",
            minute: "2-digit",
          });
          localStorage.setItem(STORAGE_KEY_LAST_SYNC, nowStr);

          // Actualizar banner
          checkSyncBanner();

          // Seleccionar fecha de los registros sincronizados
          const lastRecordDate = data.records[0]?.fecha;
          if (lastRecordDate) {
            state.selectedDate = lastRecordDate;
            if (datePicker) datePicker.value = lastRecordDate;
          }

          updateAllViews();

          if (sheetsSyncStatus) {
            sheetsSyncStatus.className =
              "p-3 rounded-xl text-xs font-bold bg-lime-100 text-lime-800 border border-lime-300";
            sheetsSyncStatus.textContent = `✅ ${data.message}`;
            sheetsSyncStatus.classList.remove("hidden");
          }

          // Disparar evento global para que Dashboard y Metrics se actualicen en tiempo real
          window.dispatchEvent(
            new CustomEvent("aquasens:data-synced", {
              detail: { records: state.allRecords, url: urlToSync },
            }),
          );
          window.dispatchEvent(new Event("storage"));

          setTimeout(() => {
            modalSheets?.classList.add("hidden");
            showToast(
              `¡Sincronizadas ${data.count} mediciones de Google Sheets!`,
              "🔗",
            );
          }, 1200);
        } else {
          if (sheetsSyncStatus) {
            sheetsSyncStatus.className =
              "p-3 rounded-xl text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
            sheetsSyncStatus.textContent = `❌ Error: ${data.error || "No se pudieron sincronizar los datos."}`;
            sheetsSyncStatus.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (sheetsSyncStatus) {
          sheetsSyncStatus.className =
            "p-3 rounded-xl text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
          sheetsSyncStatus.textContent = `❌ Error de red: ${err.message}`;
          sheetsSyncStatus.classList.remove("hidden");
        }
      } finally {
        if (sheetsSyncSpinner) sheetsSyncSpinner.classList.add("hidden");
        if (sheetsSyncBtnText)
          sheetsSyncBtnText.textContent = "Probar y Sincronizar";
        if (modalSheetsSyncBtn) modalSheetsSyncBtn.disabled = false;
      }
    }

    modalSheetsSyncBtn?.addEventListener("click", () => {
      const url = inputSheetsUrl?.value?.trim();
      if (!url) {
        if (sheetsSyncStatus) {
          sheetsSyncStatus.className =
            "p-3 rounded-xl text-xs font-bold bg-green-100 text-green-800 border border-green-300";
          sheetsSyncStatus.textContent =
            "⚠️ Ingresa la URL de tu Google Sheets antes de sincronizar.";
          sheetsSyncStatus.classList.remove("hidden");
        }
        return;
      }
      syncGoogleSheets(url);
    });

    // Banner Sync
    function checkSyncBanner() {
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      const lastSync = localStorage.getItem(STORAGE_KEY_LAST_SYNC);
      if (savedUrl && state.allRecords.length > 0 && syncBanner) {
        syncBanner.classList.remove("hidden");
        syncBanner.classList.add("flex");
        if (syncLastUpdate && lastSync) {
          syncLastUpdate.textContent = `Última sincronización: Hoy a las ${lastSync}`;
        }
      } else if (syncBanner) {
        syncBanner.classList.add("hidden");
        syncBanner.classList.remove("flex");
      }
    }

    btnSyncNowBanner?.addEventListener("click", () => {
      const savedUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);
      if (savedUrl) {
        syncGoogleSheets(savedUrl);
      }
    });

    // 15. EXPORTAR HISTORIAL A EXCEL
    const btnExportHistory = document.getElementById("btn-export-history");
    btnExportHistory?.addEventListener("click", () => {
      // Redirigir al generador de Excel
      window.location.href = "/api/export-excel";
    });

    // INICIALIZACIÓN INMEDIATA
    checkSyncBanner();
    updateAllViews();
  });
</script>
