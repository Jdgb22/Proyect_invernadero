<!-- SCRIPT DE CLIENTE CON TODA LA LÓGICA      -->
<!-- ========================================== -->
<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    // 1. CARGA DE DATOS BASE SERIALIZADOS
    const initialRecordsEl = document.getElementById("history-initial-records");
    const plantsGridEl = document.getElementById("history-plants-grid");

    let baseRecords = [];
    let plantsList = [];

    try {
      baseRecords = JSON.parse(initialRecordsEl?.textContent || "[]");
      plantsList = JSON.parse(plantsGridEl?.textContent || "[]");
    } catch (e) {
      console.error("Error parseando datos iniciales:", e);
    }

    // 2. COMBINAR CON LOCALSTORAGE (Registros importados o sincronizados previamente)
    const STORAGE_KEY_RECORDS = "macollo_custom_history_records";
    const STORAGE_KEY_RECORDS_ALT = "aquasens_custom_history_records";
    const STORAGE_KEY_SHEETS_URL = "macollo_google_sheet_url";
    const STORAGE_KEY_LAST_SYNC = "macollo_last_sync_time";

    function resolveCoordsHistorial(rawId, rawFila, rawCol) {
      const pRaw = String(rawId || "").trim();
      const fRaw = String(rawFila || "").trim();
      const cRaw = String(rawCol || "").trim();

      let filaIdx = -1;
      let colIdx = -1;

      // 1. Buscar código compuesto T[0-3O]-P[1-5]
      const candidateTexts = [pRaw, fRaw, cRaw].filter(Boolean);
      for (const text of candidateTexts) {
        const compMatch = text.match(
          /(?:^|[^a-zA-Z])T([0-3O])[\s\-_/.]*(?:P|F|COL|PLANTA)?[\s\-_/.]*([1-5])\b/i,
        );
        if (compMatch) {
          const fChar = compMatch[1].toUpperCase() === "O" ? "0" : compMatch[1];
          filaIdx = parseInt(fChar, 10);
          colIdx = parseInt(compMatch[2], 10) - 1;
          break;
        }
      }

      // 2. Extraer tratamiento (fila) si aún no está determinado
      if (filaIdx === -1 && fRaw) {
        const tratMatch = fRaw.match(
          /(?:TRATAMIENTO|FILA|CAMA|BLOQUE|SECCION)[\s\-_:]*T?([0-3O])\b/i,
        );
        if (tratMatch) {
          const fChar = tratMatch[1].toUpperCase() === "O" ? "0" : tratMatch[1];
          filaIdx = parseInt(fChar, 10);
        } else {
          const tMatch = fRaw.match(
            /(?:^|[^a-zA-Z])T([0-3O])(?:[^a-zA-Z0-9]|$)/i,
          );
          if (tMatch) {
            const fChar = tMatch[1].toUpperCase() === "O" ? "0" : tMatch[1];
            filaIdx = parseInt(fChar, 10);
          } else {
            const dMatch = fRaw.match(/^([0-3])$/);
            if (dMatch) {
              filaIdx = parseInt(dMatch[1], 10);
            }
          }
        }
      }

      // 3. Extraer columna/planta (1..5) si aún no está determinada
      const colCandidates = [cRaw, pRaw].filter(Boolean);
      if (colIdx === -1) {
        for (const text of colCandidates) {
          const pMatch = text.match(
            /(?:^|[^a-zA-Z])P[\s\-_:]*0?([1-5])(?:[^a-zA-Z0-9]|$)/i,
          );
          if (pMatch) {
            colIdx = parseInt(pMatch[1], 10) - 1;
            break;
          }
          const namedColMatch = text.match(
            /(?:PLANTA|COL|COLUMNA|SITIO)[\s\-_:]*0?([1-5])\b/i,
          );
          if (namedColMatch) {
            colIdx = parseInt(namedColMatch[1], 10) - 1;
            break;
          }
          const numMatch = text.match(/^0?([1-5])$/);
          if (numMatch) {
            colIdx = parseInt(numMatch[1], 10) - 1;
            break;
          }
        }
      }

      // 4. Si filaIdx aún no se resolvió pero se dispone de número global 1..20
      if (filaIdx === -1) {
        const globalMatch =
          pRaw.match(/^P[-_\s]?0?([1-9]|1[0-9]|20)$/i) ||
          pRaw.match(/^0?([1-9]|1[0-9]|20)$/);
        if (globalMatch) {
          const num = parseInt(globalMatch[1], 10);
          filaIdx = Math.floor((num - 1) / 5);
          if (colIdx === -1) {
            colIdx = (num - 1) % 5;
          }
        }
      }

      if (filaIdx < 0 || filaIdx > 3) filaIdx = 0;
      if (colIdx < 0 || colIdx > 4) colIdx = 0;

      const FILAS = ["t0", "t1", "t2", "t3"];
      const COLUMNAS = ["Col 1", "Col 2", "Col 3", "Col 4", "Col 5"];
      const plantNum = filaIdx * 5 + colIdx + 1;
      const plantId = `P-${String(plantNum).padStart(2, "0")}`;
      return {
        fila: FILAS[filaIdx],
        columna: COLUMNAS[colIdx],
        code: `T${filaIdx}-P${colIdx + 1}`,
        plantNumber: plantNum,
        plantId,
      };
    }

    function getStoredRecords() {
      try {
        const stored =
          localStorage.getItem(STORAGE_KEY_RECORDS) ||
          localStorage.getItem(STORAGE_KEY_RECORDS_ALT);
        if (!stored) return [];
        const parsed = JSON.parse(stored);
        if (!Array.isArray(parsed)) return [];
        // Purgar de forma estricta y definitiva CUALQUIER registro previo inventado.
        // Únicamente conservar registros que provengan de sincronización real (MET-GS- o MET-UPLOAD-)
        const realOnly = parsed.filter(
          (r) =>
            r &&
            typeof r.id === "string" &&
            (r.id.startsWith("MET-GS-") || r.id.startsWith("MET-UPLOAD-")),
        );
        if (realOnly.length !== parsed.length) {
          if (realOnly.length > 0) {
            const serialized = JSON.stringify(realOnly);
            localStorage.setItem(STORAGE_KEY_RECORDS, serialized);
            localStorage.setItem(STORAGE_KEY_RECORDS_ALT, serialized);
          } else {
            localStorage.removeItem(STORAGE_KEY_RECORDS);
            localStorage.removeItem(STORAGE_KEY_RECORDS_ALT);
          }
        }
        return realOnly;
      } catch {
        return [];
      }
    }

    function saveCustomRecords(newRecords) {
      try {
        // Al sincronizar con Google Sheets, guardar exclusivamente los registros reales descargados
        const serialized = JSON.stringify(newRecords);
        localStorage.setItem(STORAGE_KEY_RECORDS, serialized);
        localStorage.setItem(STORAGE_KEY_RECORDS_ALT, serialized);
      } catch (e) {
        console.error("Error guardando en localStorage:", e);
      }
    }

    // Únicamente devolver registros reales almacenados (sin datos inventados)
    function getAllCombinedRecords() {
      return getStoredRecords();
    }

