---
import { pool } from "../../db/client";
import { getAuthUser } from "../../backend/services/authz";
import { getFincaCookie } from "../../backend/services/authz";
import { listFincasForUser } from "../../backend/services/farms";

const { id } = Astro.params;
const user = await getAuthUser(Astro.request);
const userId = user?.id ? Number(user.id) : undefined;

if (!id) {
  return Astro.redirect("/gallery");
}

let fincaActivaId: number | null = null;
if (user) {
  const fincas = await listFincasForUser(user.id, user.role);
  const cookieId = Number(getFincaCookie(Astro.request));
  
  if (Number.isInteger(cookieId) && cookieId > 0) {
    const puedeUsar =
      user.role === "Superadmin" ||
      user.role === "Admin" ||
      fincas.some((f: any) => f.id === cookieId && f.activa);
    if (puedeUsar) fincaActivaId = cookieId;
  } else if (fincas.length === 1) {
    fincaActivaId = fincas[0].id;
  }
}

let photo: any = null;
try {
  if (fincaActivaId) {
    const res = await pool.query(
      `SELECT 
         p.id, p.url, p.filename, p.mime_type, p.width, p.height, p.size_bytes, p.caption, 
         p.taken_at, p.uploaded_at, p.user_id, p.finca_id,
         u.name as user_name, u.image as user_image, u.email as user_email
       FROM photos p
       LEFT JOIN users u ON u.id = p.user_id
       WHERE p.id = $1 AND p.finca_id = $2
       LIMIT 1`,
      [id, fincaActivaId]
    );
    photo = res.rows[0] || null;
  }
} catch (e) {
  photo = null;
}

if (!photo) {
  return Astro.redirect("/gallery");
}

function formatDate(d: Date | string | null) {
  if (!d) return "";
  const date = typeof d === "string" ? new Date(d) : d;
  return date.toLocaleString("es-CO", {
    dateStyle: "long",
    timeStyle: "medium",
  });
}

function formatSize(bytes: number | null) {
  if (!bytes) return "";
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

const imageUrl = `/api/gallery/${photo.id}/file`;
const isOwner = userId && userId === photo.user_id;
---

<section class="min-h-screen bg-stone-50 dark:bg-stone-950">
  <header class="sticky top-0 z-40 bg-white/80 dark:bg-stone-900/80 backdrop-blur-lg border-b border-stone-200 dark:border-stone-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a 
            href="/gallery" 
            class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors text-stone-700 dark:text-stone-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span class="text-sm font-medium">Volver a galería</span>
          </a>
          <div class="h-6 w-px bg-stone-300 dark:bg-stone-600 hidden sm:block"></div>
          <h1 class="text-lg font-semibold text-stone-900 dark:text-white truncate max-w-xs sm:max-w-md">
            {photo.caption || photo.filename || "Fotografía"}
          </h1>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={imageUrl}
            download={photo.filename || `foto-${photo.id}.jpg`}
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white transition-colors text-sm font-medium"
            title="Descargar imagen"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span class="hidden sm:inline">Descargar</span>
          </a>
          <button
            id="share-btn"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors text-stone-700 dark:text-stone-300"
            title="Compartir"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <div class="lg:col-span-3">
        <div class="bg-white dark:bg-stone-900 rounded-xl overflow-hidden shadow-lg border border-stone-200 dark:border-stone-700">
          <div class="relative w-full bg-stone-900 flex items-center justify-center min-h-[400px] sm:min-h-[500px] lg:min-h-[600px]">
            <img
              id="main-image"
              src={imageUrl}
              alt={photo.caption || "Fotografía del invernadero"}
              class="max-w-full max-h-[70vh] object-contain cursor-zoom-in"
              loading="eager"
            />
            <div class="absolute top-4 right-4">
              <button
                id="zoom-btn"
                class="p-2 rounded-lg bg-black/50 hover:bg-black/70 text-white transition-colors backdrop-blur-sm"
                title="Ampliar imagen"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-1 space-y-4">
        <div class="bg-white dark:bg-stone-900 rounded-xl p-4 shadow-sm border border-stone-200 dark:border-stone-700">
          <h2 class="text-sm font-semibold text-stone-900 dark:text-white mb-3">Subido por</h2>
          <div class="flex items-center gap-3">
            <img
              src={photo.user_image || "/avatar-default.png"}
              alt={photo.user_name || "Usuario"}
              class="w-10 h-10 rounded-full object-cover border border-stone-200 dark:border-stone-600"
              onerror="this.src='/avatar-default.png'"
            />
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-stone-900 dark:text-white truncate">
                {photo.user_name || "Usuario"}
              </p>
              {photo.user_email && (
                <p class="text-xs text-stone-500 dark:text-stone-400 truncate">
                  {photo.user_email}
                </p>
              )}
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-stone-900 rounded-xl p-4 shadow-sm border border-stone-200 dark:border-stone-700">
          <h2 class="text-sm font-semibold text-stone-900 dark:text-white mb-3">Detalles</h2>
          <div class="space-y-3 text-sm">
            {photo.caption && (
              <div>
                <p class="text-xs font-medium text-stone-500 dark:text-stone-400 mb-1">Descripción</p>
                <p class="text-stone-700 dark:text-stone-300 leading-relaxed">{photo.caption}</p>
              </div>
            )}
            <div class="flex justify-between">
              <span class="text-stone-500 dark:text-stone-400">Fecha</span>
              <span class="text-stone-900 dark:text-white text-right">{formatDate(photo.taken_at || photo.uploaded_at)}</span>
            </div>
            {photo.filename && (
              <div class="flex justify-between">
                <span class="text-stone-500 dark:text-stone-400">Nombre</span>
                <span class="text-stone-900 dark:text-white text-right truncate max-w-[120px]" title={photo.filename}>
                  {photo.filename}
                </span>
              </div>
            )}
            {photo.width && photo.height && (
              <div class="flex justify-between">
                <span class="text-stone-500 dark:text-stone-400">Dimensiones</span>
                <span class="text-stone-900 dark:text-white">{photo.width} × {photo.height} px</span>
              </div>
            )}
            {photo.size_bytes && (
              <div class="flex justify-between">
                <span class="text-stone-500 dark:text-stone-400">Tamaño</span>
                <span class="text-stone-900 dark:text-white">{formatSize(photo.size_bytes)}</span>
              </div>
            )}
            {photo.mime_type && (
              <div class="flex justify-between">
                <span class="text-stone-500 dark:text-stone-400">Formato</span>
                <span class="text-stone-900 dark:text-white">{String(photo.mime_type).split('/')[1]?.toUpperCase()}</span>
              </div>
            )}
          </div>
        </div>

        <div class="bg-white dark:bg-stone-900 rounded-xl p-4 shadow-sm border border-stone-200 dark:border-stone-700">
          <h2 class="text-sm font-semibold text-stone-900 dark:text-white mb-3">Acciones</h2>
          <div class="space-y-2">
            <a
              href={imageUrl}
              download={photo.filename || `foto-${photo.id}.jpg`}
              class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white transition-colors text-sm font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Descargar imagen
            </a>
            <button
              id="copy-url-btn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-300 transition-colors text-sm font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar enlace
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
</section>

<div id="zoom-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/95" id="zoom-backdrop"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <button
      id="zoom-close"
      class="absolute top-4 right-4 p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition-colors z-10"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <img
      id="zoom-image"
      src={imageUrl}
      alt={photo.caption || "Fotografía ampliada"}
      class="max-w-full max-h-full object-contain"
    />
  </div>
</div>

<script>
  const mainImage = document.getElementById('main-image') as HTMLImageElement;
  const zoomBtn = document.getElementById('zoom-btn');
  const zoomModal = document.getElementById('zoom-modal');
  const zoomBackdrop = document.getElementById('zoom-backdrop');
  const zoomClose = document.getElementById('zoom-close');

  function openZoom() {
    zoomModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeZoom() {
    zoomModal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mainImage?.addEventListener('click', openZoom);
  zoomBtn?.addEventListener('click', openZoom);
  zoomBackdrop?.addEventListener('click', closeZoom);
  zoomClose?.addEventListener('click', closeZoom);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeZoom();
  });

  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = document.querySelector('h1')?.textContent || 'Fotografía del invernadero';
    if ((navigator as any).share) {
      try {
        await (navigator as any).share({ title, url });
      } catch (err) {}
    } else {
      try {
        await navigator.clipboard.writeText(url);
        const original = shareBtn.innerHTML;
        shareBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(() => { shareBtn.innerHTML = original; }, 1500);
      } catch (err) {}
    }
  });

  const copyUrlBtn = document.getElementById('copy-url-btn');
  copyUrlBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      const original = copyUrlBtn.innerHTML;
      copyUrlBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <span>¡Copiado!</span>';
      setTimeout(() => { copyUrlBtn.innerHTML = original; }, 1500);
    } catch (err) {}
  });
</script>

<style>
  #main-image { transition: transform 0.2s ease; }
  #main-image:hover { transform: scale(1.01); }
</style>
